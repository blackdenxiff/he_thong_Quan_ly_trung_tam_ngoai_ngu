<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Trung Tâm Tiếng Anh</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/admin-style.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex" id="wrapper">
        @await Html.PartialAsync("_Sidebar")
        <div id="sidebar-backdrop" aria-hidden="true"></div>

        <!-- Page Content Wrapper -->
        <div id="page-content-wrapper">
            <!-- Top Navbar -->
            <header class="top-navbar">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="menu-toggle" aria-label="Mở hoặc thu gọn menu">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div class="d-flex align-items-center gap-3">
                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle" id="userMenu" data-bs-toggle="dropdown">
                            <!-- Đọc vai trò và tên người dùng từ Session đã lưu lúc Login -->
                            <span class="badge bg-primary me-2">@(Context.Session.GetString("UserRole") ?? "Admin")</span>
                            <span class="fw-semibold">@(Context.Session.GetString("UserFullName") ?? "Ban Quản Trị")</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                            <li><a class="dropdown-item" href="/Account"><i class="fa-solid fa-user-shield me-2"></i> Phân quyền</a></li>
                            <li><a class="dropdown-item" href="/Account/DoiMatKhau"><i class="fa-solid fa-key text-warning me-2"></i> Đổi mật khẩu</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <!-- Đường dẫn xử lý đăng xuất xóa Session -->
                            <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Đăng xuất</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Main Content Container: dùng container-fluid và w-100 để tràn toàn bộ chiều ngang -->
            <main class="container-fluid px-4 py-4 w-100 flex-grow-1">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts CDN -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.ckeditor.com/ckeditor5/41.1.0/classic/ckeditor.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>