@{
    ViewData["Title"] = "Quản lý Khóa học";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 text-dark fw-bold">Danh Mục Chương Trình & Khóa Học</h4>
        <p class="text-muted small mb-0">Quản lý các chương trình đào tạo chuẩn quốc tế, cấu trúc học phí và lộ trình đầu ra</p>
    </div>
    <button class="btn btn-primary" type="button" id="btnOpenCreateCourse">
        <i class="fa-solid fa-plus me-1"></i> Tạo Khóa Học Mới
    </button>
</div>

<!-- 4 Thẻ chỉ số tổng quan khóa học -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-muted small fw-semibold">TỔNG KHÓA HỌC</span>
            <h4 class="fw-bold mb-0 text-dark" id="statTotalCourses">0</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-primary small fw-semibold">ĐANG MỞ</span>
            <h4 class="fw-bold mb-0 text-primary" id="statEnrollingCourses">0</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-success small fw-semibold">LỚP ĐANG HOẠT ĐỘNG</span>
            <h4 class="fw-bold mb-0 text-success" id="statActiveClasses">0</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-info small fw-semibold">TỔNG BUỔI ĐÀO TẠO</span>
            <h4 class="fw-bold mb-0 text-info" id="statTotalLessons">0</h4>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm khóa học -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-5">
                <input type="text" class="form-control" id="searchCourseKw" placeholder="Nhập tên khóa học, mã khóa học..." />
            </div>
            <div class="col-md-3">
                <select class="form-select" id="filterCourseLevel">
                    <option value="">-- Tất cả trình độ --</option>
                    <option value="A1 - A2">Sơ cấp (A1 - A2)</option>
                    <option value="B1 (TOEIC 500+)">Trung cấp (B1)</option>
                    <option value="B2 (IELTS 6.5+)">Cao cấp (B2 - C1)</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="filterCourseStatus">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Đang mở">Đang mở</option>
                    <option value="Tạm ngưng">Tạm ngưng</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="button" class="btn btn-secondary w-100" id="btnFilterCourse">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <button type="button" class="btn btn-outline-secondary" id="btnResetCourseFilter">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bảng danh sách khóa học -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3">MÃ KHÓA</th>
                        <th>TÊN CHƯƠNG TRÌNH ĐÀO TẠO</th>
                        <th>CHUẨN ĐẦU RA</th>
                        <th>THỜI LƯỢNG</th>
                        <th>HỌC PHÍ NIÊM YẾT</th>
                        <th>LỘ TRÌNH TÓM TẮT</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end pe-3">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody id="courseTableBody">
                    <tr><td colspan="8" class="text-center text-muted py-4">Đang tải dữ liệu...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top">
        <small class="text-muted" id="coursePageInfo">Đang tải...</small>
        <div class="btn-group">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPrevCourse">Trang trước</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnNextCourse">Trang sau</button>
        </div>
    </div>
</div>

<!-- Modal: Tài liệu khóa học -->
<div class="modal fade" id="modalDocuments" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-folder-open me-2 text-primary"></i>Tài liệu khóa học: <span id="documentCourseName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formDocument" class="row g-2 align-items-end mb-3">
                    <div class="col-md-6"><label class="form-label fw-semibold">Tệp (PDF, Word, PowerPoint, Excel, TXT; tối đa 10 MB)</label><input class="form-control" type="file" id="documentFile" accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt" required /></div>
                    <div class="col-md-4"><label class="form-label fw-semibold">Mô tả</label><input class="form-control" id="documentDescription" maxlength="500" /></div>
                    <div class="col-md-2"><button class="btn btn-primary w-100" type="submit"><i class="fa-solid fa-upload me-1"></i>Tải lên</button></div>
                </form>
                <div id="documentList" class="list-group"><div class="text-muted text-center py-3">Đang tải...</div></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Thêm / Sửa Khóa Học -->
<div class="modal fade" id="modalCourse" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalCourseTitle">
                    <i class="fa-solid fa-book-open me-2 text-primary"></i>Tạo Khóa Học Đào Tạo Mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formCourse">
                    <input type="hidden" id="hiddenCourseId" value="0" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Mã Khóa Học <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtCourseCode" placeholder="VD: KH-TOEIC650" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Tên Khóa Học <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtCourseName" placeholder="VD: Luyện Thi TOEIC 650+ Bứt Phá" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Chuẩn Đầu Ra / Cấp Độ <span class="text-danger">*</span></label>
                            <select class="form-select" id="selectCourseLevel">
                                <option value="A1 - A2">Sơ cấp (A1 - A2)</option>
                                <option value="B1 (TOEIC 500+)">Trung cấp B1 (TOEIC 500+)</option>
                                <option value="B2 (IELTS 6.5+)">Cao cấp B2 (IELTS 6.5+)</option>
                                <option value="C1 (IELTS 7.5+)">Chuyên gia C1 (IELTS 7.5+)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Số Buổi Học (1 - 120 buổi) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="txtCourseLessons" value="1" min="1" max="120" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Học Phí Niêm Yết (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control fw-bold text-primary" id="txtCourseFee" value="0" min="0" step="100000" required />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Tóm Tắt Lộ Trình & Mục Tiêu Đào Tạo</label>
                            <textarea class="form-control" id="txtCourseDesc" rows="3" placeholder="Nhập mô tả tóm tắt nội dung các kỹ năng được giảng dạy..."></textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Trạng Thái Tuyển Sinh</label>
                            <select class="form-select" id="selectCourseStatus">
                                <option value="Đang mở">Đang mở</option>
                                <option value="Tạm ngưng">Tạm ngưng</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveCourse">
                    <i class="fa-solid fa-save me-1"></i> Lưu Khóa Học
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let currentEditRow = null;
            let currentPage = 1;
            let totalPages = 0;
            const courseModal = new bootstrap.Modal(document.getElementById('modalCourse'));
            const urls = {
                list: '@Url.Action("DanhSach", "KhoaHoc")',
                save: '@Url.Action("LuuKhoaHoc", "KhoaHoc")',
                remove: '@Url.Action("XoaKhoaHoc", "KhoaHoc")',
                documents: '@Url.Action("DanhSachTaiLieu", "KhoaHoc")',
                uploadDocument: '@Url.Action("UploadTaiLieu", "KhoaHoc")',
                downloadDocument: '@Url.Action("TaiTaiLieu", "KhoaHoc")',
                removeDocument: '@Url.Action("XoaTaiLieu", "KhoaHoc")'
            };
            let currentDocumentCourseId = 0;
            const documentModal = new bootstrap.Modal(document.getElementById('modalDocuments'));

            function loadDocuments(courseId) {
                currentDocumentCourseId = courseId;
                $('#documentList').html('<div class="text-muted text-center py-3">Đang tải...</div>');
                $.getJSON(urls.documents, { khoaHocId: courseId }).done(res => {
                    const list = $('#documentList').empty();
                    if (!res.success || !res.items.length) {
                        list.html('<div class="text-muted text-center py-3">Chưa có tài liệu dùng chung.</div>');
                        return;
                    }
                    res.items.forEach(x => list.append(`<div class="list-group-item d-flex justify-content-between align-items-center"><div><a href="${urls.downloadDocument}?taiLieuId=${encodeURIComponent(x.id)}" class="fw-semibold text-decoration-none"><i class="fa-solid fa-file-arrow-down me-2"></i>${esc(x.ten)}</a><div class="small text-muted">${esc(x.loai)} • ${esc(x.ngayDang)}${x.moTa ? ' • ' + esc(x.moTa) : ''}</div></div><button type="button" class="btn btn-sm btn-outline-danger btn-delete-document" data-id="${x.id}"><i class="fa-solid fa-trash"></i></button></div>`));
                }).fail(() => $('#documentList').html('<div class="text-danger text-center py-3">Không tải được danh sách tài liệu.</div>'));
            }

            $(document).on('click', '.btn-course-documents', function () {
                const row = $(this).closest('tr');
                $('#documentCourseName').text(row.data('name') || '');
                $('#formDocument')[0].reset();
                documentModal.show();
                loadDocuments(row.data('id'));
            });

            $('#formDocument').submit(function (event) {
                event.preventDefault();
                const data = new FormData();
                data.append('khoaHocId', currentDocumentCourseId);
                data.append('file', $('#documentFile')[0].files[0]);
                data.append('moTa', $('#documentDescription').val());
                $.ajax({ url: urls.uploadDocument, type: 'POST', data, processData: false, contentType: false, headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() } })
                    .done(res => { if (!res.success) return Swal.fire('Lỗi', res.message, 'error'); $('#formDocument')[0].reset(); loadDocuments(currentDocumentCourseId); Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: res.message, showConfirmButton: false, timer: 1500 }); })
                    .fail(xhr => Swal.fire('Lỗi', xhr.responseJSON?.message || 'Không thể tải tài liệu lên.', 'error'));
            });

            $(document).on('click', '.btn-delete-document', function () {
                const id = $(this).data('id');
                Swal.fire({ title: 'Xóa tài liệu?', text: 'Tài liệu sẽ được chuyển vào thùng rác.', icon: 'warning', showCancelButton: true, confirmButtonText: 'Xóa', cancelButtonText: 'Hủy' }).then(result => {
                    if (!result.isConfirmed) return;
                    $.ajax({ url: urls.removeDocument + '?taiLieuId=' + encodeURIComponent(id), type: 'POST', headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() } }).done(res => { if (!res.success) return Swal.fire('Lỗi', res.message, 'error'); loadDocuments(currentDocumentCourseId); });
                });
            });

            function esc(value) {
                return String(value ?? '').replace(/[&<>"']/g, ch => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
                })[ch]);
            }

            function statusBadgeClass(status) {
                if (status === 'Đang mở') return 'bg-success-subtle text-success border-success-subtle';
                if (status === 'Tạm ngưng') return 'bg-warning-subtle text-warning border-warning-subtle';
                return 'bg-secondary-subtle text-secondary border-secondary-subtle';
            }

            function syncStatusOptions(statuses) {
                const filter = $('#filterCourseStatus');
                const currentFilter = filter.val();
                filter.find('option:not(:first)').remove();
                (statuses || []).forEach(status => filter.append(new Option(status, status)));
                filter.val(currentFilter || '');
            }

            function loadCourses(page = 1) {
                currentPage = page;
                $('#courseTableBody').html('<tr><td colspan="8" class="text-center text-muted py-4">Đang tải dữ liệu...</td></tr>');
                $.getJSON(urls.list, {
                    keyword: $('#searchCourseKw').val().trim(),
                    trinhDo: $('#filterCourseLevel').val(),
                    trangThai: $('#filterCourseStatus').val(),
                    page: currentPage,
                    pageSize: 10
                }).done(res => {
                    if (!res.success) {
                        $('#courseTableBody').html('<tr><td colspan="8" class="text-center text-danger py-4">Không tải được dữ liệu.</td></tr>');
                        return Swal.fire('Lỗi', res.message || 'Không tải được danh sách khóa học.', 'error');
                    }
                    currentPage = res.page;
                    totalPages = res.totalPages;
                    syncStatusOptions(res.statuses);
                    const body = $('#courseTableBody').empty();
                    if (!res.items.length) body.append('<tr><td colspan="8" class="text-center text-muted py-4">Không có khóa học phù hợp.</td></tr>');
                    res.items.forEach(x => {
                        const displayStatus = x.trangThai || 'Chưa xác định';
                        const badge = statusBadgeClass(x.trangThai);
                        body.append(`<tr data-id="${x.id}" data-code="${esc(x.maKhoaHoc)}" data-name="${esc(x.tenKhoaHoc)}" data-level="${esc(x.trinhDo)}" data-lessons="${x.soBuoi}" data-fee="${x.hocPhi}" data-desc="${esc(x.moTa)}" data-status="${esc(x.trangThai)}">
                            <td class="ps-3"><span class="badge bg-light text-primary border border-primary fw-bold">${esc(x.maKhoaHoc)}</span></td>
                            <td><div class="fw-bold text-dark course-title">${esc(x.tenKhoaHoc)}</div><small class="text-muted">Đang mở ${x.soLop} lớp</small></td>
                            <td><span class="badge bg-info-subtle text-info border course-level">${esc(x.trinhDo || 'Chưa xác định')}</span></td>
                            <td class="course-duration"><span class="fw-semibold">${x.soBuoi} buổi</span></td>
                            <td class="fw-bold text-dark course-fee">${Number(x.hocPhi).toLocaleString('vi-VN')} đ</td>
                            <td><small class="text-muted text-truncate d-inline-block course-desc" style="max-width: 250px;">${esc(x.moTa || 'Chưa có mô tả')}</small></td>
                            <td><span class="badge ${badge} border status-badge">${esc(displayStatus)}</span></td>
                            <td class="text-end pe-3 text-nowrap"><button type="button" class="btn btn-sm btn-outline-info me-1 btn-course-documents" title="Quản lý tài liệu"><i class="fa-solid fa-folder-open"></i></button><a href="/LopHoc" class="btn btn-sm btn-outline-success me-1" title="Xem lớp học"><i class="fa-solid fa-chalkboard-user"></i></a><button type="button" class="btn btn-sm btn-outline-primary me-1 btn-edit-course" title="Sửa khóa học"><i class="fa-solid fa-pen"></i></button>
                        </tr>`);
                    });
                    $('#statTotalCourses').text(res.stats.total);
                    $('#statEnrollingCourses').text(res.stats.enrolling);
                    $('#statActiveClasses').text(res.stats.activeClasses);
                    $('#statTotalLessons').text(res.stats.totalLessons);
                    $('#coursePageInfo').text(`Tổng ${res.total} khóa học • Trang ${currentPage}/${totalPages || 1}`);
                    $('#btnPrevCourse').prop('disabled', currentPage <= 1);
                    $('#btnNextCourse').prop('disabled', currentPage >= totalPages);
                }).fail(xhr => {
                    $('#courseTableBody').html('<tr><td colspan="8" class="text-center text-danger py-4">Không thể kết nối máy chủ.</td></tr>');
                    Swal.fire('Lỗi kết nối', xhr.responseJSON?.message || 'Không thể tải danh sách khóa học.', 'error');
                });
            }

            // 1. Mở modal Tạo mới (Click nút Tạo Khóa Học Mới)
            $('#btnOpenCreateCourse').click(function () {
                currentEditRow = null;
                $('#hiddenCourseId').val('0');
                $('#formCourse')[0].reset();
                $('#txtCourseLessons').val(1);
                $('#txtCourseFee').val(0);
                $('#selectCourseStatus').val('Đang mở');
                $('#modalCourseTitle').html('<i class="fa-solid fa-book-open me-2 text-primary"></i>Tạo Khóa Học Đào Tạo Mới');
                courseModal.show();
            });

            // 2. Mở modal Chỉnh sửa (Ủy quyền sự kiện qua class .btn-edit-course)
            $(document).on('click', '.btn-edit-course', function () {
                currentEditRow = $(this).closest("tr");

                const id = currentEditRow.data('id');
                const code = currentEditRow.data('code') || currentEditRow.find('td:nth-child(1) span').text().trim();
                const name = currentEditRow.data('name') || currentEditRow.find('.course-title').text().trim();
                const level = currentEditRow.data('level') || currentEditRow.find('.course-level').text().trim();
                const lessons = currentEditRow.data('lessons') || 24;
                const fee = currentEditRow.data('fee') || 4500000;
                const desc = currentEditRow.data('desc') || currentEditRow.find('.course-desc').text().trim();
                const status = currentEditRow.data('status') || currentEditRow.find('.status-badge').text().trim();

                if (status && !$('#selectCourseStatus option').filter((_, option) => option.value === status).length) {
                    $('#selectCourseStatus').append(new Option(status, status));
                }

                $('#hiddenCourseId').val(id);
                $('#txtCourseCode').val(code);
                $('#txtCourseName').val(name);
                $('#selectCourseLevel').val(level);
                $('#txtCourseLessons').val(lessons);
                $('#txtCourseFee').val(fee);
                $('#txtCourseDesc').val(desc);
                $('#selectCourseStatus').val(status);

                $('#modalCourseTitle').html('<i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Chỉnh Sửa Khóa Học: ' + code);
                courseModal.show();
            });

            // 3. Xử lý Thêm / Cập nhật Khóa học qua AJAX
            $('#btnSaveCourse').click(function () {
                const code = $('#txtCourseCode').val().trim();
                const name = $('#txtCourseName').val().trim();
                const level = $('#selectCourseLevel').val();
                const lessons = parseInt($('#txtCourseLessons').val()) || 0;
                const fee = parseFloat($('#txtCourseFee').val()) || 0;
                const desc = $('#txtCourseDesc').val().trim();
                const status = $('#selectCourseStatus').val();
                const courseId = parseInt($('#hiddenCourseId').val()) || 0;

                if (!code || !name) {
                    Swal.fire('Lỗi nhập liệu', 'Vui lòng nhập đầy đủ mã và tên khóa học!', 'warning');
                    return;
                }
                if (lessons <= 0 || lessons > 120) {
                    Swal.fire('Lỗi thời lượng', 'Số buổi học phải từ 1 đến 120 buổi!', 'warning');
                    return;
                }
                if (fee < 0) {
                    Swal.fire('Lỗi học phí', 'Học phí niêm yết không được âm!', 'warning');
                    return;
                }

                const payload = {
                    khoaHocId: courseId,
                    maKhoaHoc: code,
                    tenKhoaHoc: name,
                    capDo: level,
                    soBuoiHoc: lessons,
                    hocPhiNiemYet: fee,
                    moTa: desc,
                    trangThai: status
                };

                $.ajax({
                    url: '/KhoaHoc/LuuKhoaHoc',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            courseModal.hide();
                            Swal.fire('Thành công!', res.message, 'success');
                            loadCourses(currentPage);
                            return;

                            const statusBadge = statusBadgeClass(status);

                            if (currentEditRow && currentEditRow.length > 0) {
                                // Cập nhật lại data attribute của dòng
                                currentEditRow.data('code', code);
                                currentEditRow.data('name', name);
                                currentEditRow.data('level', level);
                                currentEditRow.data('lessons', lessons);
                                currentEditRow.data('fee', fee);
                                currentEditRow.data('desc', desc);
                                currentEditRow.data('status', status);

                                // Cập nhật hiển thị DOM
                                currentEditRow.find("td:nth-child(1) span").text(code);
                                currentEditRow.find(".course-title").text(name);
                                currentEditRow.find(".course-level").text(level);
                                currentEditRow.find(".course-duration").html(`<span class="fw-semibold">${lessons} buổi</span> (${lessons * 2} giờ)`);
                                currentEditRow.find(".course-fee").text(fee.toLocaleString() + ' đ');
                                currentEditRow.find(".course-desc").text(desc || 'Chưa có mô tả');
                                currentEditRow.find("td:nth-child(7)").html(`<span class="badge ${statusBadge} border status-badge">${status}</span>`);

                                currentEditRow.addClass("table-warning");
                                setTimeout(() => currentEditRow.removeClass("table-warning"), 600);
                            } else {
                                // Thêm dòng mới lên đầu bảng
                                const randomId = res.id;
                                const newTr = `
                                    <tr id="row_course_${randomId}" data-id="${randomId}" data-code="${code}" data-name="${name}" data-level="${level}" data-lessons="${lessons}" data-fee="${fee}" data-desc="${desc}" data-status="${status}">
                                        <td class="ps-3"><span class="badge bg-light text-primary border border-primary fw-bold">${code}</span></td>
                                        <td>
                                            <div class="fw-bold text-dark course-title">${name}</div>
                                            <small class="text-muted">Chương trình mới</small>
                                        </td>
                                        <td><span class="badge bg-info-subtle text-info border border-info-subtle course-level">${level}</span></td>
                                        <td class="course-duration"><span class="fw-semibold">${lessons} buổi</span> (${lessons * 2} giờ)</td>
                                        <td class="fw-bold text-dark course-fee">${fee.toLocaleString()} đ</td>
                                        <td><small class="text-muted text-truncate d-inline-block course-desc" style="max-width: 250px;">${desc || 'Chưa cập nhật'}</small></td>
                                        <td><span class="badge ${statusBadge} border status-badge">${status}</span></td>
                                        <td class="text-end pe-3">
                                            <a href="/LopHoc" class="btn btn-sm btn-outline-success me-1" title="Xem danh sách lớp">
                                                <i class="fa-solid fa-chalkboard-user"></i>
                                            </a>
                                            <button class="btn btn-sm btn-outline-primary me-1 btn-edit-course" title="Chỉnh sửa">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger btn-delete-course" title="Xóa">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                `;
                                $('#courseTableBody').prepend(newTr);
                                $('#statTotalCourses').text($('#courseTableBody tr').length);
                            }
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    },
                    error: function (xhr) {
                        Swal.fire('Lỗi kết nối', 'Mã lỗi: ' + xhr.status + ' - Không thể kết nối đến máy chủ!', 'error');
                    }
                });
            });

            // 4. Xử lý Xóa / Ngưng Khóa học (Ủy quyền sự kiện qua class .btn-delete-course)
            $(document).on('click', '.btn-delete-course', function () {
                const tr = $(this).closest("tr");
                const courseId = tr.data('id');

                Swal.fire({
                    title: 'Ngưng phát hành khóa học?',
                    text: "Lưu ý: Không thể xóa khóa học nếu đang có các lớp học liên kết đang diễn ra!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    confirmButtonText: 'Đồng ý ngưng',
                    cancelButtonText: 'Hủy'
                }).then((r) => {
                    if (r.isConfirmed) {
                        $.ajax({
                            url: urls.remove + '?khoaHocId=' + encodeURIComponent(courseId),
                            type: 'POST',
                            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() }
                        }).done(res => {
                            if (!res.success) return Swal.fire('Lỗi', res.message || 'Không thể xóa khóa học.', 'error');
                            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: res.message, showConfirmButton: false, timer: 1500 });
                            loadCourses(currentPage);
                        }).fail(xhr => Swal.fire('Lỗi', xhr.responseJSON?.message || 'Không thể xóa khóa học.', 'error'));
                    }
                });
            });

            // 5. Bộ lọc tìm kiếm
            $('#btnFilterCourse').click(() => loadCourses(1));
            $('#btnResetCourseFilter').click(() => {
                $('#searchCourseKw').val('');
                $('#filterCourseLevel').val('');
                $('#filterCourseStatus').val('');
                loadCourses(1);
            });
            $('#btnPrevCourse').click(() => loadCourses(currentPage - 1));
            $('#btnNextCourse').click(() => loadCourses(currentPage + 1));
            $('#searchCourseKw').on('keydown', e => { if (e.key === 'Enter') loadCourses(1); });
            loadCourses();
        });
    </script>
}
