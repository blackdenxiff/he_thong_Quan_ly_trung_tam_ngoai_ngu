            let coursesCache = [];
            let currentPage = 1;
            let pageSize = 10;
            let totalRecords = 0;
            let totalPages = 0;
            let requestInProgress = false;
            const courseModal = new bootstrap.Modal(document.getElementById('modalCourse'));

            // Chuyển trạng thái giữa giao diện và giá trị đang dùng trong CSDL.
            function statusToUi(status) {
                const s = String(status || '').trim().toLowerCase();
                return ['ngừng mở', 'ngung mo', 'tạm ngưng', 'tam ngung'].includes(s)
                    ? 'Tạm ngưng'
                    : 'Đang tuyển sinh';
            }

            function statusToDb(status) {
                return status === 'Tạm ngưng' ? 'Ngừng mở' : 'Đang mở';
            }

            function esc(value) {
                return $('<div>').text(value == null ? '' : String(value)).html();
            }

            function getValue(obj, names, fallback) {
                for (const name of names) {
                    if (obj && obj[name] !== undefined && obj[name] !== null) return obj[name];
                }
                return fallback;
            }

            function normalizeCourse(item) {
                const id = getValue(item, ['khoaHocID', 'KhoaHocID', 'khoaHocId', 'KhoaHocId'], 0);
                const level = getValue(item, ['trinhDo', 'TrinhDo', 'capDo', 'CapDo'], '');
                const lessons = getValue(item, ['soBuoi', 'SoBuoi', 'soBuoiHoc', 'SoBuoiHoc'], 0);
                const fee = getValue(item, ['hocPhi', 'HocPhi', 'hocPhiNiemYet', 'HocPhiNiemYet'], 0);
                return {
                    id: id,
                    // Bảng KhoaHoc không có cột MaKhoaHoc; mã hiển thị được suy ra từ ID.
                    code: getValue(item, ['maKhoaHoc', 'MaKhoaHoc'], 'KH-' + String(id).padStart(4, '0')),
                    name: getValue(item, ['tenKhoaHoc', 'TenKhoaHoc'], ''),
                    level: level,
                    lessons: lessons,
                    fee: fee,
                    desc: getValue(item, ['moTa', 'MoTa'], ''),
                    status: statusToUi(getValue(item, ['trangThai', 'TrangThai'], 'Đang mở'))
                };
            }

            function formatMoney(value) {
                return Number(value || 0).toLocaleString('vi-VN') + ' đ';
            }

            function badgeClass(status) {
                return status === 'Đang tuyển sinh'
                    ? 'bg-success-subtle text-success border-success-subtle'
                    : 'bg-secondary-subtle text-secondary border-secondary-subtle';
            }

            function renderRows(items) {
                const body = $('#courseTableBody');
                body.empty();

                if (!items.length) {
                    body.html('<tr><td colspan="8" class="text-center text-muted py-4">Chưa có khóa học trong cơ sở dữ liệu.</td></tr>');
                    updateStats();
                    return;
                }

                items.forEach(function (c) {
                    const row = `
                        <tr id="row_course_${esc(c.id)}"
                            data-id="${esc(c.id)}" data-code="${esc(c.code)}" data-name="${esc(c.name)}"
                            data-level="${esc(c.level)}" data-lessons="${esc(c.lessons)}"
                            data-fee="${esc(c.fee)}" data-desc="${esc(c.desc)}" data-status="${esc(c.status)}">
                            <td class="ps-3"><span class="badge bg-light text-primary border border-primary fw-bold">${esc(c.code)}</span></td>
                            <td>
                                <div class="fw-bold text-dark course-title">${esc(c.name)}</div>
                                <small class="text-muted">Chương trình đào tạo</small>
                            </td>
                            <td><span class="badge bg-info-subtle text-info border border-info-subtle course-level">${esc(c.level || 'Chưa xác định')}</span></td>
                            <td class="course-duration"><span class="fw-semibold">${esc(c.lessons)} buổi</span> (${Number(c.lessons || 0) * 2} giờ)</td>
                            <td class="fw-bold text-dark course-fee">${formatMoney(c.fee)}</td>
                            <td><small class="text-muted text-truncate d-inline-block course-desc" style="max-width:250px;">${esc(c.desc || 'Chưa có mô tả')}</small></td>
                            <td><span class="badge ${badgeClass(c.status)} border status-badge">${esc(c.status)}</span></td>
                            <td class="text-end pe-3">
                                <a href="/LopHoc" class="btn btn-sm btn-outline-success me-1" title="Xem danh sách lớp"><i class="fa-solid fa-chalkboard-user"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-primary me-1 btn-edit-course" title="Chỉnh sửa"><i class="fa-solid fa-pen"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-danger btn-delete-course" title="Xóa khóa học"><i class="fa-solid fa-ban"></i></button>
                            </td>
                        </tr>`;
                    body.append(row);
                });
                updateStats();
            }

            function updateStats() {
                $('#statTotalCourses').text(totalRecords);
                $('#statOpenCourses').text(coursesCache.filter(c => c.status === 'Đang tuyển sinh').length + (currentPage > 1 ? ' (trang hiện tại)' : ''));
                // Chưa có API thống kê lớp học, không hiển thị số liệu giả.
                $('#statActiveClasses').text('—');
                const hasAdvanced = coursesCache.some(c =>
                    String(c.level).includes('C1') || String(c.level).includes('7.5'));
                $('#statHighestLevel').text(coursesCache.length ? (hasAdvanced ? 'IELTS 7.5+' : 'Theo trang') : '—');
            }

            function renderPagination() {
                const ul = $('#coursePagination').empty();
                if (totalPages <= 1) {
                    $('#coursePageInfo').text(totalRecords === 0 ? 'Không có bản ghi' : `Hiển thị ${totalRecords} khóa học`);
                    return;
                }
                const startRecord = (currentPage - 1) * pageSize + 1;
                const endRecord = Math.min(currentPage * pageSize, totalRecords);
                $('#coursePageInfo').text(`Hiển thị ${startRecord}–${endRecord} / ${totalRecords} khóa học`);

                function addPage(label, page, disabled, active, ariaLabel) {
                    const li = $('<li>').addClass('page-item');
                    if (disabled) li.addClass('disabled');
                    if (active) li.addClass('active');
                    const btn = $('<button type="button">').addClass('page-link').text(label);
                    if (ariaLabel) btn.attr('aria-label', ariaLabel);
                    if (disabled || active) btn.prop('disabled', true);
                    else btn.on('click', function () { currentPage = page; loadCourses(); });
                    li.append(btn);
                    ul.append(li);
                }

                addPage('«', currentPage - 1, currentPage <= 1, false, 'Trang trước');
                let first = Math.max(1, currentPage - 2);
                let last = Math.min(totalPages, first + 4);
                first = Math.max(1, last - 4);
                for (let p = first; p <= last; p++) addPage(String(p), p, false, p === currentPage);
                addPage('»', currentPage + 1, currentPage >= totalPages, false, 'Trang sau');
            }

            function currentFilters() {
                const uiStatus = $('#filterCourseStatus').val();
