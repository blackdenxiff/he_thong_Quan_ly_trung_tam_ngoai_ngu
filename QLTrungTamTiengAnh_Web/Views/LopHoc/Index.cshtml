
@using QuanLyTrungTamNgoaiNgu.Models
@{
    ViewData["Title"] = "Quản lý Lớp học";
    var khoaHocs = ViewBag.KhoaHocs as IEnumerable<KhoaHoc> ?? Enumerable.Empty<KhoaHoc>();
    var giangViens = ViewBag.GiangViens as IEnumerable<NhanSu> ?? Enumerable.Empty<NhanSu>();
    var phongHocs = ViewBag.PhongHocs as IEnumerable<PhongHoc> ?? Enumerable.Empty<PhongHoc>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 text-dark fw-bold">Danh Mục Lớp Học Đào Tạo</h4>
        <p class="text-muted small mb-0">Điều phối danh sách lớp, theo dõi sĩ số thực tế và phân công giảng viên</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" id="btnOpenClassTrash">
            <i class="fa-solid fa-trash-can me-1"></i>
            Thùng rác
            <span class="badge bg-secondary ms-1" id="classTrashCount">0</span>
        </button>
        <button type="button" class="btn btn-primary" onclick="openCreateClassModal()">
            <i class="fa-solid fa-chalkboard-user me-1"></i> Mở Lớp Học Mới
        </button>
    </div>
</div>

<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <input type="text" class="form-control" id="searchClassKeyword"
                       placeholder="Nhập tên lớp, tên giảng viên..." />
            </div>
            <div class="col-md-3">
                <select class="form-select" id="filterCourseSelect">
                    <option value="">-- Tất cả khóa học --</option>
                    @foreach (var khoa in khoaHocs)
                    {
                        <option value="@khoa.KhoaHocID">@khoa.TenKhoaHoc</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" id="filterClassStatus">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Dự kiến">Dự kiến</option>
                    <option value="Sắp mở">Sắp mở</option>
                    <option value="Đang diễn ra">Đang diễn ra</option>
                    <option value="Đã kết thúc">Đã kết thúc</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="button" class="btn btn-secondary w-100" id="btnFilterClass">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <button type="button" class="btn btn-outline-secondary" id="btnResetClassFilter" title="Làm mới">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3">MÃ LỚP</th>
                        <th>KHÓA HỌC</th>
                        <th>GIẢNG VIÊN &amp; PHÒNG</th>
                        <th style="min-width:170px">TỶ LỆ SĨ SỐ</th>
                        <th>KHAI GIẢNG</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end pe-3">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody id="classTableBody">
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            Đang tải danh sách lớp học...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
        <small class="text-muted">
            Hiển thị <span id="classCount">0</span> lớp trên trang này ·
            Tổng <span id="classTotalCount">0</span> lớp
        </small>
        <div class="d-flex align-items-center gap-2">
            <label for="classPageSize" class="small text-muted mb-0">Số dòng:</label>
            <select id="classPageSize" class="form-select form-select-sm" style="width:auto">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
            <div id="classPagination" class="btn-group btn-group-sm" role="group"></div>
        </div>
        <div class="small text-muted" id="classLoadMessage"></div>
    </div>
</div>

<!-- Modal tạo / sửa lớp học -->
<div class="modal fade" id="modalClass" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalClassTitle">
                    <i class="fa-solid fa-chalkboard-user me-2 text-primary"></i>
                    Mở Lớp Học Đào Tạo Mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body">
                <form id="formClass">
                    <input type="hidden" id="hiddenClassId" value="0" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="txtClassName">
                                Mã Lớp Học <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="txtClassName"
                                   maxlength="100" placeholder="VD: TOEIC500-K03" required />
                            <small class="text-muted">Mã lớp được lưu trong trường TenLop.</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="selectCourse">
                                Khóa Học <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="selectCourse" required>
                                <option value="">-- Chọn khóa học --</option>
                                @foreach (var khoa in khoaHocs)
                                {
                                    <option value="@khoa.KhoaHocID">
                                        @khoa.TenKhoaHoc (@khoa.SoBuoi buổi)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="selectTeacher">
                                Giảng Viên Phụ Trách <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="selectTeacher" required>
                                <option value="">-- Chọn giảng viên --</option>
                                @foreach (var gv in giangViens)
                                {
                                    <option value="@gv.NhanSuID" data-coso="@gv.CoSoID">
                                        @gv.HoTen
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="selectRoom">
                                Phòng Học <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="selectRoom" required>
                                <option value="">-- Chọn phòng học --</option>
                                @foreach (var phong in phongHocs)
                                {
                                    <option value="@phong.PhongHocID"
                                            data-coso="@phong.CoSoID"
                                            data-succhua="@phong.SucChua">
                                        @phong.TenPhong (Sức chứa @phong.SucChua)
                                    </option>
                                }
                            </select>
                            <small class="text-muted" id="roomHelp"></small>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="txtMaxStudents">
                                Sĩ Số Tối Đa <span class="text-danger">*</span>
                            </label>
                            <input type="number" class="form-control" id="txtMaxStudents"
                                   min="1" max="40" value="20" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="txtStartDate">
                                Ngày Khai Giảng <span class="text-danger">*</span>
                            </label>
                            <input type="date" class="form-control" id="txtStartDate" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="txtEndDate">
                                Ngày Kết Thúc <span class="text-danger">*</span>
                            </label>
                            <input type="date" class="form-control" id="txtEndDate" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="selectStatus">Trạng Thái</label>
                            <select class="form-select" id="selectStatus">
                                <option value="Dự kiến">Dự kiến</option>
                                <option value="Sắp mở" selected>Sắp mở</option>
                                <option value="Đang diễn ra">Đang diễn ra</option>
                                <option value="Đã kết thúc">Đã kết thúc</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="txtScheduleDesc">Lịch Học Định Kỳ</label>
                            <input type="text" class="form-control" id="txtScheduleDesc"
                                   placeholder="VD: T2 - T4 - T6 (18:00 - 20:00)" />
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveClass">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Lưu Lớp Học
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal thùng rác lớp học, thiết kế tương tự thùng rác khóa học -->
<div class="modal fade" id="modalClassTrash" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-trash-can me-2 text-danger"></i>
                    Thùng rác lớp học
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body">
                <p class="text-muted small mb-3">
                    Các lớp học ở đây đã được xóa mềm. Bạn có thể khôi phục để đưa chúng về danh sách chính.
                </p>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>MÃ LỚP</th>
                                <th>KHÓA HỌC</th>
                                <th>GIẢNG VIÊN</th>
                                <th>KHAI GIẢNG</th>
                                <th>NGÀY XÓA</th>
                                <th class="text-end">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody id="classTrashTableBody">
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    Đang tải thùng rác...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let classRows = [];
    let currentPage = 1;
    let totalPages = 1;

    $(document).ready(function () {
        loadClasses();
        loadClassTrashCount();

        $('#btnOpenClassTrash').on('click', function () {
            $('#modalClassTrash').modal('show');
            loadClassTrash();
        });

        $('#btnFilterClass').on('click', function () {
            currentPage = 1;
            loadClasses();
        });

        $('#classPageSize, #filterCourseSelect, #filterClassStatus').on('change', function () {
            currentPage = 1;
            loadClasses();
        });

        $('#searchClassKeyword').on('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                currentPage = 1;
                loadClasses();
            }
        });

        $('#btnResetClassFilter').on('click', function () {
            $('#searchClassKeyword').val('');
            $('#filterCourseSelect').val('');
            $('#filterClassStatus').val('');
            currentPage = 1;
            loadClasses();
        });

        $('#selectTeacher, #selectRoom, #txtMaxStudents').on('change input', function () {
            validateRoomTeacherCampus(false);
        });

        $('#txtStartDate').on('change', function () {
            const start = $(this).val();
            if ($('#txtEndDate').val() && $('#txtEndDate').val() < start) {
                $('#txtEndDate').val(start);
            }
            $('#txtEndDate').attr('min', start);
        });

        $('#btnSaveClass').on('click', saveClass);
    });

    function showMessage(title, message, icon) {
        if (window.Swal) {
            Swal.fire(title, message, icon);
        } else {
            alert(title + '\n' + message);
        }
    }

    function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, function (ch) {
            return {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            }[ch];
        });
    }

    function formatDate(value) {
        if (!value) return '';
        const parts = String(value).substring(0, 10).split('-');
        return parts.length === 3
            ? `${parts[2]}/${parts[1]}/${parts[0]}`
            : escapeHtml(value);
    }

    function formatDateTime(value) {
        if (!value) return '';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return formatDate(value);
        return date.toLocaleDateString('vi-VN') + ' ' +
            date.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
    }

    function statusBadge(status) {
        switch (status) {
            case 'Đang diễn ra':
                return 'bg-success-subtle text-success border-success-subtle';
            case 'Sắp mở':
                return 'bg-warning-subtle text-warning border-warning-subtle';
            case 'Dự kiến':
                return 'bg-info-subtle text-info border-info-subtle';
            case 'Đã kết thúc':
                return 'bg-secondary-subtle text-secondary border-secondary-subtle';
            default:
                return 'bg-light text-dark border-secondary-subtle';
        }
    }

    // Tải danh sách lớp đang hoạt động
    function loadClasses() {
        $('#classTableBody').html(
            '<tr><td colspan="7" class="text-center text-muted py-4">' +
            '<span class="spinner-border spinner-border-sm me-2"></span>Đang tải dữ liệu...' +
            '</td></tr>'
        );

        $.ajax({
            url: '/LopHoc/DanhSach',
            type: 'GET',
            data: {
                tuKhoa: $('#searchClassKeyword').val().trim(),
                khoaHocId: $('#filterCourseSelect').val(),
                trangThai: $('#filterClassStatus').val(),
                page: currentPage,
                pageSize: Number($('#classPageSize').val()) || 10
            },
            success: function (res) {
                if (!res || res.success !== true) {
                    $('#classTableBody').html(
                        '<tr><td colspan="7" class="text-center text-danger py-4">' +
                        'Máy chủ không trả về danh sách lớp hợp lệ.</td></tr>'
                    );
                    return;
                }

                classRows = res.data || [];
                currentPage = Number(res.page || 1);
                totalPages = Math.max(1, Number(res.totalPages || 1));

                renderClassTable(classRows);
                renderClassPagination(Number(res.totalRecords || 0));
                $('#classLoadMessage').text('');
            },
            error: function (xhr) {
                console.error('Lỗi tải danh sách lớp:', xhr.status, xhr.responseText);
                $('#classTableBody').html(
                    '<tr><td colspan="7" class="text-center text-danger py-4">' +
                    'Không tải được danh sách lớp (HTTP ' + xhr.status + ').' +
                    '</td></tr>'
                );
                $('#classCount').text('0');
                $('#classTotalCount').text('0');
                $('#classPagination').empty();
            }
        });
    }

    function renderClassTable(rows) {
        if (!rows || rows.length === 0) {
            $('#classTableBody').html(
                '<tr><td colspan="7" class="text-center text-muted py-4">' +
                'Chưa có lớp học phù hợp.</td></tr>'
            );
            $('#classCount').text('0');
            $('#classTotalCount').text('0');
            $('#classPagination').empty();
            return;
        }

        const html = rows.map(function (x) {
            const registered = Number(x.soHocVien || 0);
            const max = Number(x.siSoToiDa || 0);
            const percent = max > 0
                ? Math.min(100, Math.round(registered * 100 / max))
                : 0;

            const progressClass = percent >= 90
                ? 'bg-danger'
                : (percent >= 50 ? 'bg-warning' : 'bg-success');

            const actions =
                `<a href="/DiemDanh?lopHocId=${Number(x.lopHocId)}"
                    class="btn btn-sm btn-outline-success me-1" title="Điểm danh">
                    <i class="fa-solid fa-clipboard-check"></i>
                </a>
                <button type="button" class="btn btn-sm btn-outline-primary me-1"
                    title="Chỉnh sửa" onclick="openEditClassModal(${Number(x.lopHocId)})">
                    <i class="fa-solid fa-pen"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger"
                    title="Chuyển vào thùng rác" onclick="confirmDeleteClass(${Number(x.lopHocId)})">
                    <i class="fa-solid fa-trash-can"></i>
                </button>`;

            return `<tr>
                <td class="ps-3">
                    <span class="badge bg-light text-primary border border-primary fw-bold">
                        ${escapeHtml(x.maLop || x.tenLop)}
                    </span>
                </td>
                <td>
                    <div class="fw-bold text-dark">${escapeHtml(x.tenKhoaHoc)}</div>
                    <small class="text-muted">${escapeHtml(x.soBuoi)} buổi${x.trinhDo ? ' • ' + escapeHtml(x.trinhDo) : ''}</small>
                </td>
                <td>
                    <div class="fw-semibold">
                        <i class="fa-solid fa-user-tie text-secondary me-1"></i>
                        ${escapeHtml(x.giangVien || 'Chưa phân công')}
                    </div>
                    <span class="badge bg-secondary">${escapeHtml(x.phongHoc || 'Chưa phân phòng')}</span>
                </td>
                <td>
                    <div class="d-flex justify-content-between small mb-1">
                        <span>Đã đăng ký: <strong>${registered}/${max}</strong></span>
                        <span class="text-muted">${percent}%</span>
                    </div>
                    <div class="progress" style="height:6px">
                        <div class="progress-bar ${progressClass}" style="width:${percent}%"></div>
                    </div>
                </td>
                <td><small class="text-muted">${formatDate(x.ngayBatDau)}</small></td>
                <td>
                    <span class="badge ${statusBadge(x.trangThai)} border">
                        ${escapeHtml(x.trangThai)}
                    </span>
                </td>
                <td class="text-end pe-3 text-nowrap">${actions}</td>
            </tr>`;
        }).join('');

        $('#classTableBody').html(html);
        $('#classCount').text(rows.length);
    }

    function renderClassPagination(totalRecords) {
        $('#classTotalCount').text(totalRecords);
        const $nav = $('#classPagination').empty();

        if (totalPages <= 1) return;

        $nav.append(
            `<button type="button" class="btn btn-outline-secondary"
                ${currentPage <= 1 ? 'disabled' : ''}
                onclick="goToClassPage(${currentPage - 1})">&laquo;</button>`
        );

        const start = Math.max(1, currentPage - 2);
        const end = Math.min(totalPages, currentPage + 2);

        for (let p = start; p <= end; p++) {
            $nav.append(
                `<button type="button"
                    class="btn ${p === currentPage ? 'btn-primary' : 'btn-outline-secondary'}"
                    onclick="goToClassPage(${p})">${p}</button>`
            );
        }

        $nav.append(
            `<button type="button" class="btn btn-outline-secondary"
                ${currentPage >= totalPages ? 'disabled' : ''}
                onclick="goToClassPage(${currentPage + 1})">&raquo;</button>`
        );
    }

    function goToClassPage(page) {
        if (page < 1 || page > totalPages || page === currentPage) return;
        currentPage = page;
        loadClasses();
    }

    // Mở form tạo lớp
    function openCreateClassModal() {
        $('#formClass')[0].reset();
        $('#hiddenClassId').val('0');
        $('#txtMaxStudents').val(20);
        $('#selectStatus').val('Sắp mở');
        $('#txtScheduleDesc').val('T2 - T4 - T6 (18:00 - 20:00)');
        $('#roomHelp').text('');
        $('#txtEndDate').attr('min', $('#txtStartDate').val());

        $('#modalClassTitle').html(
            '<i class="fa-solid fa-chalkboard-user me-2 text-primary"></i>Mở Lớp Học Đào Tạo Mới'
        );

        $('#modalClass').modal('show');
    }

    // Mở form sửa lớp
    function openEditClassModal(id) {
        const x = classRows.find(item => Number(item.lopHocId) === Number(id));

        if (!x) {
            showMessage('Lỗi', 'Không tìm thấy lớp học. Vui lòng tải lại danh sách.', 'error');
            return;
        }

        $('#hiddenClassId').val(x.lopHocId);
        $('#txtClassName').val(x.tenLop || x.maLop || '');
        $('#selectCourse').val(String(x.khoaHocId));
        $('#selectTeacher').val(String(x.giaoVienPhuTrachId));
        $('#selectRoom').val(x.phongHocId ? String(x.phongHocId) : '');
        $('#txtMaxStudents').val(x.siSoToiDa);
        $('#txtStartDate').val(String(x.ngayBatDau || '').substring(0, 10));
        $('#txtEndDate').val(String(x.ngayKetThuc || '').substring(0, 10));
        $('#txtEndDate').attr('min', $('#txtStartDate').val());
        $('#selectStatus').val(x.trangThai || 'Dự kiến');
        $('#txtScheduleDesc').val(x.lichHocMoTa || '');

        $('#modalClassTitle').html(
            '<i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Chỉnh Sửa Lớp Học'
        );

        $('#modalClass').modal('show');
        validateRoomTeacherCampus(false);
    }

    function validateRoomTeacherCampus(showWarning) {
        const teacherCampus = $('#selectTeacher option:selected').data('coso');
        const roomCampus = $('#selectRoom option:selected').data('coso');
        const roomCapacity = Number($('#selectRoom option:selected').data('succhua') || 0);
        const maxStudents = Number($('#txtMaxStudents').val() || 0);

        if (teacherCampus && roomCampus &&
            String(teacherCampus) !== String(roomCampus)) {
            $('#roomHelp')
                .text('Phòng học và giảng viên phải thuộc cùng cơ sở.')
                .addClass('text-danger')
                .removeClass('text-muted');

            if (showWarning) {
                showMessage('Không hợp lệ',
                    'Vui lòng chọn giảng viên và phòng học cùng cơ sở.', 'warning');
            }
            return false;
        }

        if (roomCapacity > 0 && maxStudents > roomCapacity) {
            $('#roomHelp')
                .text('Sức chứa phòng là ' + roomCapacity + ' người.')
                .addClass('text-danger')
                .removeClass('text-muted');

            if (showWarning) {
                showMessage('Sĩ số vượt sức chứa',
                    'Sĩ số tối đa không được vượt quá sức chứa phòng.', 'warning');
            }
            return false;
        }

        $('#roomHelp')
            .text(roomCapacity > 0 ? 'Sức chứa phòng: ' + roomCapacity + ' người.' : '')
            .addClass('text-muted')
            .removeClass('text-danger');

        return true;
    }

    // Lưu lớp học
    function saveClass() {
        const form = document.getElementById('formClass');

        if (!form.reportValidity()) return;
        if (!validateRoomTeacherCampus(true)) return;

        const startDate = $('#txtStartDate').val();
        const endDate = $('#txtEndDate').val();

        if (startDate && endDate && endDate < startDate) {
            showMessage('Ngày không hợp lệ',
                'Ngày kết thúc phải sau hoặc bằng ngày khai giảng.', 'warning');
            return;
        }

        const payload = {
            lopHocId: Number($('#hiddenClassId').val()) || 0,
            tenLop: $('#txtClassName').val().trim(),
            khoaHocId: Number($('#selectCourse').val()),
            giaoVienPhuTrachId: Number($('#selectTeacher').val()),
            phongHocId: Number($('#selectRoom').val()),
            siSoToiDa: Number($('#txtMaxStudents').val()),
            ngayBatDau: startDate,
            ngayKetThuc: endDate,
            lichHocMoTa: $('#txtScheduleDesc').val().trim(),
            trangThai: $('#selectStatus').val()
        };

        const $button = $('#btnSaveClass');
        $button.prop('disabled', true)
            .html('<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...');

        $.ajax({
            url: '/LopHoc/LuuLopHoc',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(payload),

            success: function (res) {
                if (!res || res.success !== true) {
                    showMessage('Không thể lưu',
                        (res && res.message) || 'Dữ liệu lớp học không hợp lệ.', 'warning');
                    return;
                }

                $('#modalClass').modal('hide');
                showMessage('Thành công', res.message || 'Đã lưu lớp học.', 'success');
                loadClasses();
            },

            error: function (xhr) {
                console.error('Lỗi lưu lớp:', xhr.status, xhr.responseText);
                let message = 'Không thể lưu lớp học (HTTP ' + xhr.status + ').';

                if (xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;
                }

                showMessage('Lỗi kết nối', message, 'error');
            },

            complete: function () {
                $button.prop('disabled', false)
                    .html('<i class="fa-solid fa-floppy-disk me-1"></i> Lưu Lớp Học');
            }
        });
    }

    // Chuyển lớp vào thùng rác
    function confirmDeleteClass(id) {
        const executeDelete = function () {
            $.ajax({
                url: '/LopHoc/XoaLopHoc',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',

                // Controller nhận [FromBody] LopHocIdDto
                data: JSON.stringify({ lopHocId: Number(id) }),

                success: function (res) {
                    if (res && res.success) {
                        showMessage('Thành công',
                            res.message || 'Đã chuyển lớp vào thùng rác.', 'success');
                        loadClasses();
                        loadClassTrashCount();
                    } else {
                        showMessage('Không thể xóa',
                            (res && res.message) || 'Không thể chuyển lớp vào thùng rác.', 'warning');
                    }
                },

                error: function (xhr) {
                    console.error('Lỗi chuyển lớp vào thùng rác:', xhr.status, xhr.responseText);
                    const message = xhr.responseJSON && xhr.responseJSON.message
                        ? xhr.responseJSON.message
                        : 'Không thể chuyển lớp vào thùng rác (HTTP ' + xhr.status + ').';

                    showMessage('Lỗi kết nối', message, 'error');
                }
            });
        };

        if (window.Swal) {
            Swal.fire({
                title: 'Chuyển lớp vào thùng rác?',
                text: 'Lớp sẽ bị ẩn khỏi danh sách chính và có thể được khôi phục.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                confirmButtonText: 'Chuyển vào thùng rác',
                cancelButtonText: 'Hủy'
            }).then(result => {
                if (result.isConfirmed) executeDelete();
            });
        } else if (confirm('Chuyển lớp học vào thùng rác?')) {
            executeDelete();
        }
    }

    // Đếm số lớp trong thùng rác
    function loadClassTrashCount() {
        $.ajax({
            url: '/LopHoc/DanhSachThungRac',
            type: 'GET',
            success: function (res) {
                if (res && res.success) {
                    $('#classTrashCount').text((res.data || []).length);
                }
            },
            error: function (xhr) {
                console.error('Lỗi đếm lớp trong thùng rác:', xhr.status, xhr.responseText);
            }
        });
    }

    // Tải dữ liệu cho modal thùng rác
    function loadClassTrash() {
        $('#classTrashTableBody').html(
            '<tr><td colspan="6" class="text-center text-muted py-4">' +
            '<span class="spinner-border spinner-border-sm me-2"></span>Đang tải thùng rác...' +
            '</td></tr>'
        );

        $.ajax({
            url: '/LopHoc/DanhSachThungRac',
            type: 'GET',

            success: function (res) {
                if (!res || res.success !== true) {
                    $('#classTrashTableBody').html(
                        '<tr><td colspan="6" class="text-center text-danger py-4">' +
                        'Không tải được dữ liệu thùng rác.</td></tr>'
                    );
                    return;
                }

                const rows = res.data || [];
                $('#classTrashCount').text(rows.length);

                if (rows.length === 0) {
                    $('#classTrashTableBody').html(
                        '<tr><td colspan="6" class="text-center text-muted py-4">' +
                        'Thùng rác đang trống.</td></tr>'
                    );
                    return;
                }

                const html = rows.map(function (x) {
                    return `<tr>
                        <td>
                            <span class="badge bg-light text-primary border border-primary">
                                ${escapeHtml(x.maLop || x.tenLop)}
                            </span>
                        </td>
                        <td>${escapeHtml(x.tenKhoaHoc || '')}</td>
                        <td>${escapeHtml(x.giangVien || '')}</td>
                        <td>${formatDate(x.ngayBatDau)}</td>
                        <td>${formatDateTime(x.deletedAt)}</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-success"
                                onclick="restoreClass(${Number(x.lopHocId)})">
                                <i class="fa-solid fa-rotate-left me-1"></i> Khôi phục
                            </button>
                        </td>
                    </tr>`;
                }).join('');

                $('#classTrashTableBody').html(html);
            },

            error: function (xhr) {
                console.error('Lỗi tải thùng rác:', xhr.status, xhr.responseText);
                $('#classTrashTableBody').html(
                    '<tr><td colspan="6" class="text-center text-danger py-4">' +
                    'Không tải được thùng rác (HTTP ' + xhr.status + ').' +
                    '</td></tr>'
                );
            }
        });
    }

    // Khôi phục lớp học
    function restoreClass(id) {
        const executeRestore = function () {
            $.ajax({
                url: '/LopHoc/KhoiPhucLopHoc',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',

                // Controller nhận [FromBody] LopHocIdDto
                data: JSON.stringify({ lopHocId: Number(id) }),

                success: function (res) {
                    if (res && res.success) {
                        showMessage('Đã khôi phục',
                            res.message || 'Lớp học đã được khôi phục.', 'success');
                        loadClassTrash();
                        loadClassTrashCount();
                        loadClasses();
                    } else {
                        showMessage('Không thể khôi phục',
                            (res && res.message) || 'Không thể khôi phục lớp học.', 'error');
                    }
                },

                error: function (xhr) {
                    console.error('Lỗi khôi phục lớp:', xhr.status, xhr.responseText);
                    const message = xhr.responseJSON && xhr.responseJSON.message
                        ? xhr.responseJSON.message
                        : 'Không thể khôi phục lớp học (HTTP ' + xhr.status + ').';

                    showMessage('Lỗi kết nối', message, 'error');
                }
            });
        };

        if (window.Swal) {
            Swal.fire({
                title: 'Khôi phục lớp học?',
                text: 'Lớp sẽ xuất hiện trở lại trong danh sách chính.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Khôi phục',
                cancelButtonText: 'Hủy'
            }).then(result => {
                if (result.isConfirmed) executeRestore();
            });
        } else if (confirm('Khôi phục lớp học này?')) {
            executeRestore();
        }
    }
</script>
}
