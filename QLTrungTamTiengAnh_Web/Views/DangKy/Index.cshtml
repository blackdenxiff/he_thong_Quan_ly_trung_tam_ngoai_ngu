@{
    ViewData["Title"] = "Đăng ký & Khảo thí đầu vào";
}
@Html.AntiForgeryToken()
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h4 class="fw-bold mb-1">Đăng ký lớp & khảo thí đầu vào</h4><p class="text-muted mb-0">Dữ liệu được lấy trực tiếp từ cơ sở dữ liệu.</p></div>
    <div class="d-flex gap-2"><button class="btn btn-outline-primary" id="btnTest">Ghi nhận khảo thí</button><button class="btn btn-primary" id="btnEnroll">Đăng ký vào lớp</button></div>
</div>
<ul class="nav nav-pills mb-3"><li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#enrollPane">Danh sách đăng ký</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#testPane">Khảo thí đầu vào</button></li></ul>
<div class="tab-content">
 <div class="tab-pane fade show active" id="enrollPane"><div class="card"><div class="card-body"><div class="input-group mb-3"><input id="enrollSearch" class="form-control" placeholder="Tìm học viên, lớp hoặc mã đăng ký..."><button class="btn btn-outline-secondary" id="btnEnrollSearch">Tìm</button></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Mã</th><th>Học viên</th><th>Lớp</th><th>Khóa học</th><th>Ngày đăng ký</th><th>Học phí chốt</th><th>Trạng thái</th><th></th></tr></thead><tbody id="enrollBody"></tbody></table></div><div id="enrollPager" class="d-flex justify-content-end"></div></div></div></div>
 <div class="tab-pane fade" id="testPane"><div class="card"><div class="card-body"><div class="row g-2 mb-3"><div class="col-md-6"><input id="testSearch" class="form-control" placeholder="Tìm học viên..."></div><div class="col-md-3"><select id="testStatus" class="form-select"><option value="">Tất cả trạng thái</option><option value="chuathi">Chưa thi</option><option value="dathi">Đã thi (kể cả điểm 0)</option></select></div><div class="col-md-3"><button class="btn btn-outline-secondary w-100" id="btnTestSearch">Tìm</button></div></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Mã HV</th><th>Họ tên</th><th>Điện thoại</th><th>Kết quả</th><th>Trình độ</th><th>Nhận xét</th><th></th></tr></thead><tbody id="testBody"></tbody></table></div><div id="testPager" class="d-flex justify-content-end"></div></div></div></div>
</div>
<div class="modal fade" id="enrollModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Đăng ký học viên vào lớp</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Học viên</label><select id="studentSelect" class="form-select mb-3"></select><label class="form-label">Lớp học</label><select id="classSelect" class="form-select mb-3"></select><label class="form-label">Ghi chú</label><textarea id="enrollNote" class="form-control"></textarea><div id="classInfo" class="small text-muted mt-2"></div></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button><button class="btn btn-primary" id="saveEnroll">Lưu đăng ký</button></div></div></div></div>
<div class="modal fade" id="testModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Ghi nhận kết quả khảo thí</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Học viên</label><select id="testStudent" class="form-select mb-3"></select><label class="form-label">Điểm (0-100)</label><input id="testScore" type="number" min="0" max="100" step="0.01" class="form-control mb-3"><label class="form-label">Trình độ đề xuất</label><input id="testLevel" maxlength="50" class="form-control mb-3"><label class="form-label">Nhận xét</label><textarea id="testNote" maxlength="500" class="form-control"></textarea></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button><button class="btn btn-primary" id="saveTest">Lưu kết quả</button></div></div></div></div>
@section Scripts {
<script>
const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
const jsonHeaders = {'Content-Type':'application/json','RequestVerificationToken':token};
const money = v => new Intl.NumberFormat('vi-VN').format(v || 0) + ' đ';
const esc = s => String(s ?? '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
async function api(url, options={}) { const r=await fetch(url, options); const d=await r.json(); if(!r.ok || d.success===false) throw new Error(d.message || 'Có lỗi xảy ra.'); return d; }
function pager(id, page, totalPages, load) { const e=document.getElementById(id); e.innerHTML=totalPages<2?'':`<button class="btn btn-sm btn-outline-secondary" ${page<=1?'disabled':''}>‹</button><span class="mx-2 small">Trang ${page}/${totalPages}</span><button class="btn btn-sm btn-outline-secondary" ${page>=totalPages?'disabled':''}>›</button>`; const b=e.querySelectorAll('button'); if(b[0])b[0].onclick=()=>load(page-1);if(b[1])b[1].onclick=()=>load(page+1); }
async function loadEnroll(page=1){ const d=await api(`/DangKy/DanhSachDangKy?keyword=${encodeURIComponent(document.getElementById('enrollSearch').value)}&page=${page}`); document.getElementById('enrollBody').innerHTML=d.items.map(x=>`<tr><td>DK-${String(x.id).padStart(4,'0')}</td><td>${esc(x.hocVien)}</td><td>${esc(x.lop)}</td><td>${esc(x.khoaHoc)}</td><td>${new Date(x.ngayDangKy).toLocaleDateString('vi-VN')}</td><td>${money(x.hocPhi)}</td><td>${esc(x.trangThai)}</td><td>${x.trangThai==='Đang học'?`<button class="btn btn-sm btn-outline-danger cancel" data-id="${x.id}">Hủy</button>`:''}</td></tr>`).join('') || '<tr><td colspan="8" class="text-center text-muted">Chưa có dữ liệu.</td></tr>'; pager('enrollPager',d.page,d.totalPages,loadEnroll); document.querySelectorAll('.cancel').forEach(b=>b.onclick=async()=>{if(confirm('Hủy đăng ký này?')){try{await api('/DangKy/HuyDangKy',{method:'POST',headers:jsonHeaders,body:JSON.stringify({dangKyId:+b.dataset.id})});loadEnroll();}catch(e){alert(e.message)}}}); }
async function loadTests(page=1){ const d=await api(`/DangKy/DanhSachKhaoThi?keyword=${encodeURIComponent(document.getElementById('testSearch').value)}&trangThai=${document.getElementById('testStatus').value}&page=${page}`); document.getElementById('testBody').innerHTML=d.items.map(x=>`<tr><td>${x.ma}</td><td>${esc(x.hoTen)}</td><td>${esc(x.dienThoai)}</td><td>${x.daThi?`<span class="badge ${x.diem==0?'bg-warning text-dark':'bg-primary'}">${x.diem}/100</span>`:'<span class="badge bg-secondary">Chưa thi</span>'}</td><td>${esc(x.trinhDo)||'—'}</td><td>${esc(x.nhanXet)||'—'}</td><td><button class="btn btn-sm btn-outline-primary edit-test" data-id="${x.id}">Ghi nhận</button></td></tr>`).join('') || '<tr><td colspan="7" class="text-center text-muted">Chưa có dữ liệu.</td></tr>'; pager('testPager',d.page,d.totalPages,loadTests); document.querySelectorAll('.edit-test').forEach(b=>b.onclick=()=>{document.getElementById('testStudent').value=b.dataset.id;bootstrap.Modal.getOrCreateInstance(document.getElementById('testModal')).show()}); }
async function loadInputs(){ const d=await api('/DangKy/DuLieuNhap'); studentSelect.innerHTML='<option value="">-- Chọn học viên --</option>'+d.hocViens.map(x=>`<option value="${x.id}">${x.ma}: ${esc(x.ten)}</option>`).join(''); testStudent.innerHTML=studentSelect.innerHTML; classSelect.innerHTML='<option value="">-- Chọn lớp --</option>'+d.lopHocs.map(x=>`<option value="${x.id}" data-fee="${x.hocPhi}" data-count="${x.siSo}" data-max="${x.siSoToiDa}">${esc(x.ten)} - ${esc(x.khoaHoc)}</option>`).join(''); }
const studentSelect=document.getElementById('studentSelect'), testStudent=document.getElementById('testStudent'), classSelect=document.getElementById('classSelect');
document.getElementById('classSelect').onchange=()=>{const o=classSelect.selectedOptions[0];document.getElementById('classInfo').textContent=o?.value?`Sĩ số: ${o.dataset.count}/${o.dataset.max} | Học phí chốt: ${money(o.dataset.fee)}`:''};
document.getElementById('btnEnroll').onclick=()=>{loadInputs().then(()=>bootstrap.Modal.getOrCreateInstance(document.getElementById('enrollModal')).show()).catch(e=>alert(e.message))}; document.getElementById('btnTest').onclick=()=>{loadInputs().then(()=>bootstrap.Modal.getOrCreateInstance(document.getElementById('testModal')).show()).catch(e=>alert(e.message))};
document.getElementById('saveEnroll').onclick=async()=>{try{await api('/DangKy/LuuDangKy',{method:'POST',headers:jsonHeaders,body:JSON.stringify({hocVienId:+studentSelect.value,lopHocId:+classSelect.value,ghiChu:document.getElementById('enrollNote').value})});bootstrap.Modal.getInstance(document.getElementById('enrollModal')).hide();loadEnroll();alert('Đã đăng ký thành công.')}catch(e){alert(e.message)}};
document.getElementById('saveTest').onclick=async()=>{try{const score=Number(document.getElementById('testScore').value);if(!Number.isFinite(score)||score<0||score>100)throw Error('Điểm phải từ 0 đến 100.');await api('/DangKy/LuuDiemDauVao',{method:'POST',headers:jsonHeaders,body:JSON.stringify({hocVienId:+testStudent.value,diemDauVao:score,trinhDoDeXuat:document.getElementById('testLevel').value,nhanXet:document.getElementById('testNote').value})});bootstrap.Modal.getInstance(document.getElementById('testModal')).hide();loadTests();alert('Đã lưu kết quả khảo thí.')}catch(e){alert(e.message)}};
document.getElementById('btnEnrollSearch').onclick=()=>loadEnroll();document.getElementById('enrollSearch').onkeydown=e=>{if(e.key==='Enter')loadEnroll()};document.getElementById('btnTestSearch').onclick=()=>loadTests();loadEnroll();loadTests();
</script>
}

