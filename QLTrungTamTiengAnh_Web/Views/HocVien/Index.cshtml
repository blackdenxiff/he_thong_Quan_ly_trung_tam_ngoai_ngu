@{
    ViewData["Title"] = "Quản lý Học viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 text-dark fw-bold">Hồ Sơ Học Viên & Tuyển Sinh</h4>
        <p class="text-muted small mb-0">Quản lý danh sách học viên, kết quả test đầu vào và xếp lớp đào tạo</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-danger"
                data-bs-toggle="modal" data-bs-target="#modalStudentTrash">
            <i class="fa-solid fa-trash-can me-1"></i> Thùng rác
        </button>

        <button class="btn btn-primary"
                data-bs-toggle="modal" data-bs-target="#modalStudent">
            <i class="fa-solid fa-user-plus me-1"></i>
            Tiếp Nhận Học Viên Mới
        </button>
    </div>
</div>

<!-- Bộ lọc Paging & Filtering -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">TÌM KIẾM</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="searchKeyword" placeholder="Nhập tên, số điện thoại, email..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">TRÌNH ĐỘ ĐẦU VÀO</label>
                <select class="form-select" id="filterLevel">
                    <option value="">-- Tất cả trình độ --</option>
                    <option value="A1">Mất gốc / A1 (0 - 30 điểm)</option>
                    <option value="A2">Sơ cấp / A2 (31 - 65 điểm)</option>
                    <option value="B1">Trung cấp / B1 (66 - 80 điểm)</option>
                    <option value="B2">Khá giỏi / B2 (81 - 100 điểm)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">TRẠNG THÁI HỌC TẬP</label>
                <select class="form-select" id="filterStatus">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Đang học">Đang học</option>
                    <option value="Chờ xếp lớp">Chờ xếp lớp</option>
                    <option value="Bảo lưu">Bảo lưu</option>
                    <option value="Hoàn thành">Hoàn thành</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="button" class="btn btn-secondary w-100" id="btnFilter">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <button type="button" class="btn btn-outline-secondary" id="btnResetFilter" title="Đặt lại">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bảng dữ liệu Học viên (Table) -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3">MÃ HV</th>
                        <th>HỌ VÀ TÊN</th>
                        <th>LIÊN HỆ</th>
                        <th>ĐẦU VÀO (TEST)</th>
                        <th>LỚP HIỆN TẠI</th>
                        <th>CAM KẾT</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end pe-3">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody id="studentTableBody">
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            Đang tải danh sách học viên...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <!-- Phân trang Paging -->
    <div class="card-footer bg-white d-flex justify-content-between
        align-items-center py-3 flex-wrap gap-2">
        <small class="text-muted" id="paginationInfo">
            Đang tải dữ liệu...
        </small>

        <ul class="pagination pagination-sm mb-0" id="paginationList">
        </ul>
    </div>
</div>

<!-- Modal 1: Tiếp nhận/Thêm học viên mới (Validation) -->
<div class="modal fade" id="modalStudent" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-plus me-2 text-primary"></i>Tiếp Nhận Hồ Sơ Học Viên</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="studentForm">
                    <input type="hidden" id="txtStudentId" value="0" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtStudentName" required placeholder="VD: Nguyễn Hoàng Long" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Giới tính</label>
                            <select class="form-select" id="selectGender">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Ngày sinh</label>
                            <input type="date" class="form-control" id="txtDob" value="2005-01-01" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" id="txtPhone" required placeholder="VD: 0912345678" pattern="[0-9]{10}" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email liên hệ <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="txtEmail" required placeholder="VD: long@example.com" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Lớp đăng ký
                            </label>

                            <select class="form-select" id="selectStudentClass">
                                <option value="">-- Chưa xếp lớp --</option>
                            </select>

                            <small class="text-muted">
                                Chọn lớp nếu học viên đăng ký ngay; có thể để trống và xếp lớp sau.
                            </small>
                        </div>

                        <!-- Đánh giá đầu vào F07 -->
                        <div class="col-12"><hr class="my-2" /><span class="badge bg-secondary mb-2">Kết quả đánh giá đầu vào</span></div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Trình độ xếp loại</label>
                            <select class="form-select" id="selectLevel">
                                <option value="A1">A1 (Căn bản - Mất gốc)</option>
                                <option value="A2">A2 (Sơ cấp)</option>
                                <option value="B1">B1 (Trung cấp / Mục tiêu TOEIC 500+)</option>
                                <option value="B2">B2 (Cao cấp / IELTS 6.5+)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Điểm thi đầu vào (0 - 100) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="txtScore" min="0" max="100" value="60" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Nhận xét của giáo viên khảo sát</label>
                            <textarea class="form-control" id="txtNotes" rows="2" placeholder="Ghi chú kỹ năng yếu, nguyện vọng học..."></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveStudent">Lưu Hồ Sơ</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 2: Xếp lớp & Đăng ký khóa học (F10) -->
<div class="modal fade" id="modalEnroll" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-graduation-cap me-2 text-success"></i>Xếp Lớp Đào Tạo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="enrollForm">
                    <input type="hidden" id="enrollStudentId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Học viên:</label>
                        <input type="text" class="form-control bg-light" id="enrollStudentName" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chọn lớp học đang mở <span class="text-danger">*</span></label>
                        <select class="form-select" id="selectClassEnroll" required>
                            <option value="1" data-fee="4500000">TOEIC500-K01 (Khai giảng 01/10/2026 - P.101)</option>
                            <option value="2" data-fee="7500000">IELTS6.5-K02 (Khai giảng 15/10/2026 - P.102)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Học phí áp dụng (VNĐ)</label>
                        <input type="number" class="form-control fw-bold text-primary" id="txtTuitionFee" value="4500000" readonly />
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="chkCommitment" checked>
                        <label class="form-check-label fw-semibold" for="chkCommitment">
                            Áp dụng chính sách Cam kết chuẩn đầu ra (F18)
                        </label>
                        <div class="small text-muted">Được học lại miễn phí nếu thi không đạt chuẩn quy định[cite: 1, 2].</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ghi chú đăng ký</label>
                        <input type="text" class="form-control" id="txtEnrollNote" placeholder="VD: Đăng ký ca tối, đã đóng cọc..." />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success" id="btnConfirmEnroll">Xác Nhận Xếp Lớp</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal thùng rác học viên -->
<div class="modal fade" id="modalStudentTrash" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-trash-can me-2 text-danger"></i>
                    Thùng rác học viên
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã HV</th>
                                <th>Họ tên</th>
                                <th>Số điện thoại</th>
                                <th>Email</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="studentTrashBody">
                            <tr>
                                <td colspan="5" class="text-center text-muted">
                                    Chưa tải dữ liệu
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Đóng
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            let currentPage = 1;
            const pageSize = 10;
            let searchTimer = null;

            const modalStudentElement =
                document.getElementById('modalStudent');

            const studentModal =
                bootstrap.Modal.getOrCreateInstance(modalStudentElement);

            // Chuyển dữ liệu thành HTML an toàn để tránh chèn HTML ngoài ý muốn.
            function escapeHtml(value) {
                return String(value ?? '').replace(/[&<>"']/g, function(c) {
                    return {
                        '&': '&amp;',
                        '<': '&lt;',
                        '>': '&gt;',
                        '"': '&quot;',
                        "'": '&#39;'
                    }[c];
                });
            }

            function formatDate(value) {
                if (!value) return '';

                const date = new Date(value);
                if (isNaN(date.getTime())) return '';

                return [
                    String(date.getDate()).padStart(2, '0'),
                    String(date.getMonth() + 1).padStart(2, '0'),
                    date.getFullYear()
                ].join('/');
            }

            function formatDateInput(value) {
                if (!value) return '';

                const date = new Date(value);
                if (isNaN(date.getTime())) return '';

                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');

                return `${year}-${month}-${day}`;
            }

            function statusBadge(status) {
                const colors = {
                    'Đang học': 'bg-success-subtle text-success border border-success-subtle',
                    'Chờ xếp lớp': 'bg-warning-subtle text-warning border border-warning-subtle',
                    'Bảo lưu': 'bg-secondary-subtle text-secondary border',
                    'Hoàn thành': 'bg-primary-subtle text-primary border border-primary-subtle'
                };

                const css = colors[status] || 'bg-secondary-subtle text-secondary border';

                return `<span class="badge ${css}">${escapeHtml(status || 'Chưa xác định')}</span>`;
            }

            function renderStudent(student) {
                const id = Number(student.hocVienID);
                const name = escapeHtml(student.hoTen);
                const gender = escapeHtml(student.gioiTinh || 'Chưa cập nhật');
                const dob = formatDate(student.ngaySinh);
                const phone = escapeHtml(student.soDienThoai || 'Chưa cập nhật');
                const email = escapeHtml(student.email || 'Chưa cập nhật');
                const level = escapeHtml(student.trinhDoDauVao || 'Chưa đánh giá');
                const score = student.diemDauVao == null
                    ? 'Chưa có điểm'
                    : `${escapeHtml(student.diemDauVao)} đ`;
                const notes = escapeHtml(student.nhanXetDauVao || '');
                const status = student.trangThai || '';

                const genderIcon = student.gioiTinh === 'Nữ'
                    ? 'fa-venus text-danger'
                    : 'fa-mars text-primary';

                return `
                            <tr data-id="${id}">
                                <td class="ps-3">
                                    <span class="badge bg-light text-dark border">
                                        HV-${String(id).padStart(3, '0')}
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">${name}</div>
                                    <small class="text-muted">
                                        <i class="fa-solid ${genderIcon} me-1"></i>
                                        ${gender}${dob ? ' • ' + dob : ''}
                                    </small>
                                </td>
                                <td>
                                    <div>${phone}</div>
                                    <small class="text-muted">${email}</small>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        ${level} - ${score}
                                    </span>
                                    ${notes ? `<div class="small text-muted text-truncate" style="max-width:150px" title="${notes}">${notes}</div>` : ''}
                                </td>
                                <td>
                                    <span class="text-muted fst-italic">Chưa xếp lớp</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">Chưa xét</span>
                                </td>
                                <td>${statusBadge(status)}</td>
                                <td class="text-end pe-3">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary me-1"
                                            title="Sửa hồ sơ"
                                            onclick="editStudent(${id})">
                                        <i class="fa-solid fa-user-pen"></i>
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            title="Xóa hồ sơ"
                                            onclick="confirmDelete(${id})">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                            </tr>`;
            }

            // Tải danh sách thật từ database.
            function loadStudents(page = 1) {
                currentPage = page;

                $('#studentTableBody').html(`
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    Đang tải dữ liệu...
                                </td>
                            </tr>`);

                $.ajax({
                    url: '/HocVien/DanhSach',
                    type: 'GET',
                    dataType: 'json',
                    data: {
                        tuKhoa: $('#searchKeyword').val().trim(),
                        trinhDo: $('#filterLevel').val(),
                        trangThai: $('#filterStatus').val(),
                        page: currentPage,
                        pageSize: pageSize
                    },
                    success: function(res) {
                        if (!res.success) {
                            $('#studentTableBody').html(`
                                        <tr>
                                            <td colspan="8" class="text-center text-danger py-4">
                                                Không thể tải danh sách học viên.
                                            </td>
                                        </tr>`);
                            return;
                        }

                        if (!res.data || res.data.length === 0) {
                            $('#studentTableBody').html(`
                                        <tr>
                                            <td colspan="8" class="text-center text-muted py-4">
                                                Không tìm thấy học viên phù hợp.
                                            </td>
                                        </tr>`);
                        } else {
                            $('#studentTableBody').html(
                                res.data.map(renderStudent).join('')
                            );
                        }

                        const total = res.total || 0;
                        const start = total === 0
                            ? 0
                            : (res.page - 1) * res.pageSize + 1;
                        const end = Math.min(
                            res.page * res.pageSize,
                            total
                        );

                        $('#paginationInfo').text(
                            `Hiển thị ${start} - ${end} trong tổng số ${total} học viên`
                        );

                        renderPagination(res.page, res.totalPages);
                    },
                    error: function(xhr) {
                        console.error(xhr.responseText);

                        $('#studentTableBody').html(`
                                    <tr>
                                        <td colspan="8" class="text-center text-danger py-4">
                                            Lỗi tải dữ liệu. Hãy kiểm tra controller và kết nối database.
                                        </td>
                                    </tr>`);

                        $('#paginationInfo').text('Không tải được dữ liệu.');
                        $('#paginationList').empty();
                    }
                });
            }

            // Vẽ nút phân trang.
            function renderPagination(page, totalPages) {
                const $list = $('#paginationList');
                $list.empty();

                if (!totalPages || totalPages <= 1) return;

                function addPage(label, targetPage, disabled, active) {
                    const li = $('<li>').addClass('page-item');

                    if (disabled) li.addClass('disabled');
                    if (active) li.addClass('active');

                    const link = $('<a>')
                        .addClass('page-link')
                        .attr('href', '#')
                        .text(label);

                    link.on('click', function(e) {
                        e.preventDefault();

                        if (!disabled && !active) {
                            loadStudents(targetPage);
                        }
                    });

                    li.append(link);
                    $list.append(li);
                }

                addPage('Trước', page - 1, page <= 1, false);

                for (let i = 1; i <= totalPages; i++) {
                    addPage(String(i), i, false, i === page);
                }

                addPage('Sau', page + 1, page >= totalPages, false);
            }

            // Lọc và tìm kiếm.
            $('#btnFilter').on('click', function() {
                loadStudents(1);
            });

            $('#searchKeyword').on('input', function() {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function() {
                    loadStudents(1);
                }, 350);
            });

            $('#filterLevel, #filterStatus').on('change', function() {
                loadStudents(1);
            });

            $('#btnResetFilter').on('click', function() {
                $('#searchKeyword').val('');
                $('#filterLevel').val('');
                $('#filterStatus').val('');

                loadStudents(1);
            });

            // Mở modal thêm mới.
            $('button[data-bs-target="#modalStudent"]').on('click', function() {
                $('#studentForm')[0].reset();
                $('#txtStudentId').val('0');
                $('#modalStudent .modal-title').html(
                    '<i class="fa-solid fa-user-plus me-2 text-primary"></i>Tiếp Nhận Hồ Sơ Học Viên'
                );
                $('#btnSaveStudent').text('Lưu Hồ Sơ');
            });

            // Mở modal sửa và nạp dữ liệu của học viên.
            window.editStudent = function(id) {
                $.ajax({
                    url: '/HocVien/DanhSach',
                    type: 'GET',
                    dataType: 'json',
                    data: {
                        tuKhoa: String(id),
                        page: 1,
                        pageSize: 100
                    },
                    success: function(res) {
                        const student = res.data?.find(
                            x => Number(x.hocVienID) === Number(id)
                        );

                        if (!student) {
                            Swal.fire('Thông báo', 'Không tìm thấy học viên.', 'warning');
                            return;
                        }

                        $('#studentForm')[0].reset();
                        $('#txtStudentId').val(student.hocVienID);
                        $('#txtStudentName').val(student.hoTen || '');
                        $('#selectGender').val(student.gioiTinh || 'Nam');
                        $('#txtDob').val(formatDateInput(student.ngaySinh));
                        $('#txtPhone').val(student.soDienThoai || '');
                        $('#txtEmail').val(student.email || '');
                        $('#selectLevel').val(student.trinhDoDauVao || 'A1');
                        $('#txtScore').val(student.diemDauVao ?? '');
                        $('#txtNotes').val(student.nhanXetDauVao || '');

                        $('#modalStudent .modal-title').html(
                            '<i class="fa-solid fa-user-pen me-2 text-primary"></i>Sửa Hồ Sơ Học Viên'
                        );
                        $('#btnSaveStudent').text('Cập Nhật');

                        studentModal.show();
                    },
                    error: function() {
                        Swal.fire('Lỗi', 'Không tải được thông tin học viên.', 'error');
                    }
                });
            };

            // Thêm mới hoặc cập nhật.
            $('#btnSaveStudent').on('click', function() {
                const form = document.getElementById('studentForm');

                if (!form.reportValidity()) return;

                const name = $('#txtStudentName').val().trim();
                const scoreText = $('#txtScore').val();
                const score = scoreText === ''
                    ? null
                    : Number(scoreText);

                if (!name) {
                    Swal.fire('Thiếu thông tin', 'Vui lòng nhập họ tên học viên.', 'warning');
                    return;
                }

                if (score === null || !Number.isFinite(score) ||
                    score < 0 || score > 100) {
                    Swal.fire('Điểm không hợp lệ', 'Điểm đầu vào phải từ 0 đến 100.', 'warning');
                    return;
                }

                const payload = {
                    hocVienID: Number($('#txtStudentId').val()) || 0,
                    hoTen: name,
                    ngaySinh: $('#txtDob').val() || null,
                    gioiTinh: $('#selectGender').val(),
                    soDienThoai: $('#txtPhone').val().trim(),
                    email: $('#txtEmail').val().trim(),
                    trinhDoDauVao: $('#selectLevel').val(),
                    diemDauVao: score,
                    nhanXetDauVao: $('#txtNotes').val().trim(),
                    lopHocID: Number($('#selectStudentClass').val()) || null
                };

                const $button = $('#btnSaveStudent');
                $button.prop('disabled', true);

                $.ajax({
                    url: '/HocVien/LuuHocVien',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify(payload),
                    success: function(res) {
                        if (res.success) {
                            studentModal.hide();

                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: res.message,
                                timer: 1500,
                                showConfirmButton: false
                            });

                            loadStudents(1);
                            $('#studentForm')[0].reset();
                            $('#txtStudentId').val('0');
                        } else {
                            Swal.fire('Không thể lưu', res.message, 'error');
                        }
                    },
                    error: function(xhr) {
                        console.error(xhr.responseText);
                        Swal.fire('Lỗi kết nối', 'Không thể lưu hồ sơ. Hãy kiểm tra controller và database.', 'error');
                    },
                    complete: function() {
                        $button.prop('disabled', false);
                    }
                });
            });

            // Xóa hồ sơ qua controller, không xóa HTML giả.
            window.confirmDelete = function(id) {
                Swal.fire({
                    title: 'Xóa hồ sơ học viên?',
                    text: 'Hồ sơ sẽ bị xóa khỏi database nếu không còn dữ liệu liên quan.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy'
                }).then(function(result) {
                    if (!result.isConfirmed) return;

                    $.ajax({
                        url: '/HocVien/XoaHocVien',
                        type: 'POST',
                        contentType: 'application/json; charset=utf-8',
                        data: JSON.stringify({
                            hocVienID: Number(id)
                        }),
                        success: function(res) {
                            if (res.success) {
                                Swal.fire({
                                    toast: true,
                                    position: 'top-end',
                                    icon: 'success',
                                    title: res.message,
                                    showConfirmButton: false,
                                    timer: 1800
                                });

                                loadStudents(currentPage);
                            } else {
                                Swal.fire('Không thể xóa', res.message, 'warning');
                            }
                        },
                        error: function(xhr) {
                            console.error(xhr.responseText);
                            Swal.fire('Lỗi', 'Không thể xóa hồ sơ học viên.', 'error');
                        }
                    });
                });
            };

            // Tải danh sách học viên trong thùng rác khi mở modal.
            $('#modalStudentTrash').on('show.bs.modal', function() {
                loadStudentTrash();
            });

            function loadStudentTrash() {
                $('#studentTrashBody').html(`
                            <tr>
                                <td colspan="5" class="text-center py-3">
                                    Đang tải dữ liệu...
                                </td>
                            </tr>
                        `);

                $.get('/HocVien/DanhSachThungRac')
                    .done(function(res) {
                        const items = res.data || [];

                        if (!res.success || items.length === 0) {
                            $('#studentTrashBody').html(`
                                        <tr>
                                            <td colspan="5"
                                                class="text-center text-muted py-4">
                                                Thùng rác đang trống.
                                            </td>
                                        </tr>
                                    `);
                            return;
                        }

                        const html = items.map(function(hv) {
                            const id = Number(hv.hocVienID);

                            return `
                                        <tr>
                                            <td>HV-${String(id).padStart(3, '0')}</td>
                                            <td>${escapeHtml(hv.hoTen)}</td>
                                            <td>${escapeHtml(hv.soDienThoai || '')}</td>
                                            <td>${escapeHtml(hv.email || '')}</td>
                                            <td>
                                                <button type="button"
                                                        class="btn btn-sm btn-success"
                                                        onclick="restoreStudent(${id})">
                                                    <i class="fa-solid fa-rotate-left me-1"></i>
                                                    Khôi phục
                                                </button>
                                            </td>
                                        </tr>
                                    `;
                        }).join('');

                        $('#studentTrashBody').html(html);
                    })
                    .fail(function(xhr) {
                        console.error(xhr.responseText);

                        $('#studentTrashBody').html(`
                                    <tr>
                                        <td colspan="5"
                                            class="text-center text-danger py-4">
                                            Không tải được thùng rác.
                                            Hãy kiểm tra action DanhSachThungRac.
                                        </td>
                                    </tr>
                                `);
                    });
            }

            // Khôi phục học viên.
            window.restoreStudent = function(id) {
                if (!confirm('Bạn có muốn khôi phục học viên này không?')) {
                    return;
                }

                $.ajax({
                    url: '/HocVien/KhoiPhucHocVien',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({ hocVienID: id })
                })
                    .done(function(res) {
                        alert(res.message || 'Đã xử lý yêu cầu.');

                        if (res.success) {
                            loadStudentTrash();
                            loadStudents(1);
                        }
                    })
                    .fail(function(xhr) {
                        console.error(xhr.responseText);
                        alert('Không thể khôi phục học viên.');
                    });
            };

            // Tải danh sách lớp từ database.
            function loadClassesForStudent() {
                const $select = $('#selectStudentClass');

                $select.html(
                    '<option value="">Đang tải danh sách lớp...</option>'
                );

                $.get('/HocVien/DanhSachLopDangKy')
                    .done(function(res) {
                        $select.empty();
                        $select.append(
                            '<option value="">-- Chưa xếp lớp --</option>'
                        );

                        if (!res.success || !res.data || res.data.length === 0) {
                            $select.append(
                                '<option value="" disabled>Hiện không có lớp phù hợp</option>'
                            );
                            return;
                        }

                        res.data.forEach(function(lop) {
                            const tenLop = escapeHtml(lop.tenLop);
                            const ngayBatDau = escapeHtml(lop.ngayBatDau);
                            const soLuong = Number(lop.soLuongDangKy);
                            const siSo = Number(lop.siSoToiDa);

                            $select.append(
                                $('<option>', {
                                    value: lop.lopHocID,
                                    text: `${tenLop} - Khai giảng ${ngayBatDau} - Sĩ số ${soLuong}/${siSo}`
                                })
                            );
                        });
                    })
                    .fail(function(xhr) {
                        console.error(xhr.responseText);

                        $select.html(
                            '<option value="">Không tải được danh sách lớp</option>'
                        );
                    });
            }

            // Mở form tiếp nhận thì cập nhật danh sách lớp.
            $('#modalStudent').on('show.bs.modal', function() {
                loadClassesForStudent();
            });

            // Khởi tạo danh sách từ database.
            loadStudents(1);
        });
    </script>
}


