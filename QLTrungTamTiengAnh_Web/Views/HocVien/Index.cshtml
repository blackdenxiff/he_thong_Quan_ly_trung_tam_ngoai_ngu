@{
    ViewData["Title"] = "Quản lý Học viên";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 text-dark fw-bold">Hồ Sơ Học Viên & Tuyển Sinh</h4>
        <p class="text-muted small mb-0">Quản lý danh sách học viên, kết quả test đầu vào và xếp lớp đào tạo</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalStudent">
        <i class="fa-solid fa-user-plus me-1"></i> Tiếp Nhận Học Viên Mới
    </button>
</div>

<!-- Bộ lọc Paging & Filtering -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">TÌM KIẾM</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="searchKeyword" placeholder="Nhập tên, số điện thoại, email..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">TRÌNH ĐỘ ĐẦU VÀO</label>
                <select class="form-select" id="filterLevel">
                    <option value="">-- Tất cả trình độ --</option>
                    <option value="A1">Mất gốc / A1 (0 - 30 điểm)</option>
                    <option value="A2">Sơ cấp / A2 (31 - 65 điểm)</option>
                    <option value="B1">Trung cấp / B1 (66 - 80 điểm)</option>
                    <option value="B2">Khá giỏi / B2 (81 - 100 điểm)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">TRẠNG THÁI HỌC TẬP</label>
                <select class="form-select" id="filterStatus">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Đang học">Đang học</option>
                    <option value="Chờ xếp lớp">Chờ xếp lớp</option>
                    <option value="Bảo lưu">Bảo lưu</option>
                    <option value="Hoàn thành">Hoàn thành</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="button" class="btn btn-secondary w-100" id="btnFilter">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <button type="button" class="btn btn-outline-secondary" id="btnResetFilter" title="Đặt lại">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bảng dữ liệu Học viên (Table) -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3">MÃ HV</th>
                        <th>HỌ VÀ TÊN</th>
                        <th>LIÊN HỆ</th>
                        <th>ĐẦU VÀO (TEST)</th>
                        <th>LỚP HIỆN TẠI</th>
                        <th>CAM KẾT</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end pe-3">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody id="studentTableBody">
                    <tr><td colspan="8" class="text-center text-muted py-4">Đang tải dữ liệu học viên...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <!-- Phân trang Paging -->
    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
        <small class="text-muted">Đang tải...</small>
    </div>
</div>

<!-- Modal 1: Tiếp nhận/Thêm học viên mới (Validation) -->
<div class="modal fade" id="modalStudent" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-plus me-2 text-primary"></i>Tiếp Nhận Hồ Sơ Học Viên</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="studentForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtStudentName" required placeholder="VD: Nguyễn Hoàng Long" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Giới tính</label>
                            <select class="form-select" id="selectGender">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Ngày sinh</label>
                            <input type="date" class="form-control" id="txtDob" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" id="txtPhone" required placeholder="VD: 0912345678" pattern="[0-9]{10}" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email liên hệ <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="txtEmail" required placeholder="VD: long@example.com" />
                        </div>

                        <!-- Đánh giá đầu vào F07 -->
                        <div class="col-12"><hr class="my-2" /><span class="badge bg-secondary mb-2">Kết quả đánh giá đầu vào</span></div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Trình độ xếp loại</label>
                            <select class="form-select" id="selectLevel">
                                <option value="A1">A1 (Căn bản - Mất gốc)</option>
                                <option value="A2">A2 (Sơ cấp)</option>
                                <option value="B1">B1 (Trung cấp / Mục tiêu TOEIC 500+)</option>
                                <option value="B2">B2 (Cao cấp / IELTS 6.5+)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Điểm thi đầu vào (0 - 100) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="txtScore" min="0" max="100" placeholder="Để trống nếu chưa khảo thí" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Nhận xét của giáo viên khảo sát</label>
                            <textarea class="form-control" id="txtNotes" rows="2" placeholder="Ghi chú kỹ năng yếu, nguyện vọng học..."></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveStudent">Lưu Hồ Sơ</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 2: Xếp lớp & Đăng ký khóa học (F10) -->
<div class="modal fade" id="modalEnroll" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-graduation-cap me-2 text-success"></i>Xếp Lớp Đào Tạo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="enrollForm">
                    <input type="hidden" id="enrollStudentId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Học viên:</label>
                        <input type="text" class="form-control bg-light" id="enrollStudentName" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chọn lớp học đang mở <span class="text-danger">*</span></label>
                        <select class="form-select" id="selectClassEnroll" required>
                            <option value="">-- Chọn lớp học --</option>
                        </select>
                        <div class="small text-muted mt-2" id="enrollClassInfo"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Học phí áp dụng (VNĐ)</label>
                        <input type="number" class="form-control fw-bold text-primary" id="txtTuitionFee" value="0" readonly />
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="chkCommitment" checked>
                        <label class="form-check-label fw-semibold" for="chkCommitment">
                            Áp dụng chính sách Cam kết chuẩn đầu ra (F18)
                        </label>
                        <div class="small text-muted">Cam kết được tạo ở trạng thái Chờ duyệt và liên kết với đăng ký lớp vừa tạo.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ghi chú đăng ký</label>
                        <input type="text" class="form-control" id="txtEnrollNote" placeholder="VD: Đăng ký ca tối, đã đóng cọc..." />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success" id="btnConfirmEnroll">Xác Nhận Xếp Lớp</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function() {
            let currentRowTarget = null;
            let studentPage = 1;
            function loadStudents(page = 1) {
                studentPage = page;
                $.getJSON('/HocVien/DanhSach', { keyword: $('#searchKeyword').val().trim(), trinhDo: $('#filterLevel').val(), trangThai: $('#filterStatus').val(), page: page })
                    .done(res => {
                        if (!res.success) return Swal.fire('Lỗi', res.message || 'Không tải được học viên.', 'error');
                        const body = $('#studentTableBody').empty();
                        if (!res.items.length) body.append('<tr><td colspan="8" class="text-center text-muted py-4">Không có học viên phù hợp.</td></tr>');
                        res.items.forEach(x => body.append(`<tr><td class="ps-3"><span class="badge bg-light text-dark border">${x.ma}</span></td><td><div class="fw-bold text-dark">${$('<div>').text(x.hoTen).html()}</div><small class="text-muted">${x.trinhDo || 'Chưa khảo thí'}</small></td><td><div>${x.dienThoai || ''}</div><small class="text-muted">${x.email || ''}</small></td><td><span class="badge bg-info text-dark">${x.diem == null ? 'Chưa thi' : x.diem + ' điểm'}</span></td><td><span class="${x.lopHienTai ? 'fw-semibold text-primary' : 'text-muted'}">${x.lopHienTai || 'Chưa xếp lớp'}</span>${x.soDangKy > 1 ? `<div class="small text-muted">${x.soDangKy} đăng ký đang học</div>` : ''}</td><td>${x.coCamKet ? '<span class="badge bg-success"><i class="fa-solid fa-shield-check me-1"></i>Có cam kết</span>' : '<span class="badge bg-secondary">Không</span>'}</td><td><span class="badge bg-success-subtle text-success border">${x.trangThai}</span></td><td class="text-end pe-3"><button class="btn btn-sm btn-outline-success" title="Xếp lớp" onclick="openEnrollModal(${x.id}, '${String(x.hoTen).replace(/'/g, "\\'")}', this)"><i class="fa-solid fa-graduation-cap"></i></button><button class="btn btn-sm btn-outline-danger ms-1" title="Xóa" onclick="confirmDelete(this, ${x.id})"><i class="fa-solid fa-trash"></i></button></td></tr>`));
                        $('.card-footer small').first().text(`Tổng ${res.total} học viên • Trang ${res.page}/${res.totalPages || 1}`);
                    }).fail(() => Swal.fire('Lỗi kết nối', 'Không thể tải danh sách học viên.', 'error'));
            }
            $('#btnFilter').click(() => loadStudents(1));
            $('#btnResetFilter').click(() => { $('#searchKeyword,#filterLevel,#filterStatus').val(''); loadStudents(1); });
            loadStudents();

            // 1. Mở Modal Xếp lớp
            window.openEnrollModal = function(studentId, studentName, element) {
                currentRowTarget = $(element).closest("tr");
                $('#enrollStudentId').val(studentId);
                $('#enrollStudentName').val(studentName);
                $('#selectClassEnroll').prop('disabled', true).html('<option value="">Đang tải lớp học...</option>');
                $('#txtTuitionFee').val(0);
                $('#enrollClassInfo').text('Đang lấy dữ liệu lớp học từ hệ thống...');
                $('#modalEnroll').modal('show');
                $.getJSON('/HocVien/DanhSachLopCoTheXep', { hocVienId: studentId })
                    .done(res => {
                        if (!res.success) throw new Error(res.message || 'Không tải được lớp học.');
                        const select = $('#selectClassEnroll').empty().append(new Option('-- Chọn lớp học --', ''));
                        res.items.forEach(item => {
                            const room = item.phong || 'Chưa phân phòng';
                            const text = `${item.tenLop} — ${item.khoaHoc} — ${item.coSo}`;
                            const option = new Option(text, item.id);
                            $(option).data({ fee: item.hocPhi, course: item.khoaHoc, start: item.khaiGiang, branch: item.coSo, room, count: item.siSo, max: item.siSoToiDa });
                            select.append(option);
                        });
                        select.prop('disabled', false);
                        $('#enrollClassInfo').text(res.items.length ? 'Chọn một lớp để xem chi tiết.' : 'Không có lớp còn chỗ và phù hợp để xếp.');
                    })
                    .fail(xhr => {
                        $('#selectClassEnroll').html('<option value="">Không tải được lớp học</option>').prop('disabled', true);
                        $('#enrollClassInfo').text(xhr.responseJSON?.message || 'Không tải được danh sách lớp từ máy chủ.');
                    });
            };

            // 2. Tự động tính học phí khi chọn lớp
            $('#selectClassEnroll').change(function() {
                const option = $(this).find(':selected');
                const fee = option.data('fee') || 0;
                $('#txtTuitionFee').val(fee);
                if (!option.val()) return $('#enrollClassInfo').text('Chọn một lớp để xem chi tiết.');
                const start = new Date(option.data('start')).toLocaleDateString('vi-VN');
                $('#enrollClassInfo').text(`Khóa học: ${option.data('course')} • Khai giảng: ${start} • Cơ sở: ${option.data('branch')} • Phòng: ${option.data('room')} • Sĩ số: ${option.data('count')}/${option.data('max')}`);
            });

            // 3. Xử lý Đăng ký xếp lớp qua AJAX & cập nhật giao diện
            $('#btnConfirmEnroll').click(function() {
                if (!$('#selectClassEnroll').val()) return Swal.fire('Chưa chọn lớp', 'Vui lòng chọn một lớp học hợp lệ.', 'warning');
                const selectedClassText = $('#selectClassEnroll option:selected').text().split('(')[0].trim();
                const hasCommitment = $('#chkCommitment').is(':checked');

                const payload = {
                    hocVienId: parseInt($('#enrollStudentId').val()),
                    lopHocId: parseInt($('#selectClassEnroll').val()),
                    hocPhiApDung: parseFloat($('#txtTuitionFee').val()),
                    coCamKet: hasCommitment,
                    ghiChu: $('#txtEnrollNote').val()
                };

                $.ajax({
                    url: '/HocVien/DangKyLop',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    data: JSON.stringify(payload),
                    success: function(res) {
                        if (res.success) {
                            $('#modalEnroll').modal('hide');
                            loadStudents(studentPage);
                            Swal.fire('Hoàn tất!', res.message, 'success');
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    },
                    error: function(xhr) {
                        Swal.fire('Không thể xếp lớp', xhr.responseJSON?.message || 'Không thể gửi dữ liệu xếp lớp.', 'error');
                    }
                });
            });

            // 4. Xử lý Thêm học viên mới
            $('#btnSaveStudent').click(function() {
                const name = $('#txtStudentName').val().trim();
                const score = parseFloat($('#txtScore').val());

                if (!name) {
                    Swal.fire('Lỗi nhập liệu', 'Vui lòng nhập họ tên học viên!', 'warning');
                    return;
                }
                if (!isNaN(score) && (score < 0 || score > 100)) {
                    Swal.fire('Lỗi điểm số', 'Điểm kiểm tra đầu vào phải nằm trong thang từ 0 đến 100!', 'warning');
                    return;
                }

                const payload = {
                    hoTen: name,
                    soDienThoai: $('#txtPhone').val(),
                    email: $('#txtEmail').val(),
                    gioiTinh: $('#selectGender').val(),
                    trinhDoDauVao: $('#selectLevel').val(),
                    diemDauVao: score,
                    nhanXet: $('#txtNotes').val()
                };

                $.ajax({
                    url: '/HocVien/LuuHocVien',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    data: JSON.stringify(payload),
                    success: function(res) {
                        if (res.success) {
                            $('#modalStudent').modal('hide');
                            loadStudents(1);
                            Swal.fire('Thành công!', res.message, 'success');

                            loadStudents(1);
                            return;

                            const randomId = res.id;
                            const newTr = `
                                        <tr id="row_student_${randomId}">
                                            <td class="ps-3"><span class="badge bg-light text-dark border">HV-${randomId}</span></td>
                                            <td>
                                                <div class="fw-bold text-dark">${payload.hoTen}</div>
                                                <small class="text-muted">${payload.gioiTinh}</small>
                                            </td>
                                            <td>
                                                <div>${payload.soDienThoai}</div>
                                                <small class="text-muted">${payload.email}</small>
                                            </td>
                                            <td><span class="badge bg-info text-dark">${payload.trinhDoDauVao} - ${payload.diemDauVao} đ</span></td>
                                            <td><span class="text-muted fst-italic">Chưa xếp lớp</span></td>
                                            <td><span class="badge bg-secondary">Chưa xét</span></td>
                                            <td><span class="badge bg-warning-subtle text-warning border border-warning-subtle">Chờ xếp lớp</span></td>
                                            <td class="text-end pe-3">
                                                <button class="btn btn-sm btn-outline-success me-1" title="Xếp lớp" onclick="openEnrollModal(${randomId}, '${payload.hoTen}', this)">
                                                    <i class="fa-solid fa-graduation-cap"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" title="Xóa" onclick="confirmDelete(this, ${randomId})">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    `;
                            $('#studentTableBody').prepend(newTr);
                            $('#studentForm')[0].reset();
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    },
                    error: function() {
                        Swal.fire('Lỗi kết nối', 'Không thể lưu hồ sơ học viên', 'error');
                    }
                });
            });

            // 5. Xử lý Xóa học viên linh hoạt
            window.confirmDelete = function(btnElement, studentId) {
                let tr = null;
                if (btnElement instanceof HTMLElement || btnElement instanceof jQuery) {
                    tr = $(btnElement).closest("tr");
                } else if (typeof btnElement === 'number') {
                    tr = $(`button[onclick*="confirmDelete(${btnElement})"]`).closest("tr");
                }

                Swal.fire({
                    title: 'Xóa hồ sơ học viên?',
                    text: "Bạn có chắc chắn muốn xóa hồ sơ học viên này khỏi danh sách?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy'
                }).then((r) => {
                    if (r.isConfirmed) {
                        if (tr && tr.length > 0) {
                            $.ajax({ url: '/HocVien/XoaHocVien?hocVienId=' + encodeURIComponent(studentId), type: 'POST', headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() } })
                                .done(res => { if (res.success) { loadStudents(1); Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: res.message, showConfirmButton: false, timer: 1500 }); } else Swal.fire('Lỗi', res.message, 'error'); })
                                .fail(xhr => Swal.fire('Lỗi', xhr.responseJSON?.message || 'Không thể xóa hồ sơ.', 'error'));
                        }
                    }
                });
            };
        }); // <-- Đóng chính xác $(document).ready
    </script>
}
