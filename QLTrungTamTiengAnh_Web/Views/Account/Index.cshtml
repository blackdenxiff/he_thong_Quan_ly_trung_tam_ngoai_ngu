@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(function() {
            const pageSize = 10;
            let currentPage = 1;
            let activeUserId = null;
            const createModalEl = document.getElementById('modalCreateUser');
            const bulkModalEl = document.getElementById('modalBulkCreate');
            const editModalEl = document.getElementById('modalEditRole');
            const trashModalEl = document.getElementById('modalRecycleBin');
            const createModal = bootstrap.Modal.getOrCreateInstance(createModalEl);
            const bulkModal = bootstrap.Modal.getOrCreateInstance(bulkModalEl);
            const editModal = bootstrap.Modal.getOrCreateInstance(editModalEl);
            const trashModal = bootstrap.Modal.getOrCreateInstance(trashModalEl);

            function escapeHtml(value) {
                return String(value ?? '').replace(/[&<>"']/g, function(c) {
                    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
                });
            }

            function roleBadgeClass(role) {
                const r = (role || '').toLowerCase();
                if (r.includes('admin')) return 'bg-danger-subtle text-danger';
                if (r.includes('quản lý') || r.includes('quanly')) return 'bg-primary-subtle text-primary';
                if (r.includes('giáo viên') || r.includes('giangvien')) return 'bg-info-subtle text-info';
                if (r.includes('nhân viên') || r.includes('nhanvien')) return 'bg-success-subtle text-success';
                return 'bg-secondary-subtle text-secondary';
            }

            function renderRows(items) {
                const $tbody = $('#userTableBody').empty();
                if (!Array.isArray(items) || items.length === 0) {
                    $tbody.html('<tr><td colspan="6" class="text-center text-muted py-4">Không tìm thấy tài khoản phù hợp.</td></tr>');
                    return;
                }

                items.forEach(function(u) {
                    const statusClass = u.trangThai === 'Hoạt động'
                        ? 'bg-success-subtle text-success'
                        : 'bg-danger-subtle text-danger';
                    const lockText = u.trangThai === 'Hoạt động' ? 'Khóa' : 'Mở khóa';
                    const lockIcon = u.trangThai === 'Hoạt động' ? 'fa-lock' : 'fa-lock-open';
                    const row = `
                                <tr data-id="${Number(u.nguoiDungId)}"
                                    data-username="${escapeHtml(u.tenDangNhap)}"
                                    data-fullname="${escapeHtml(u.hoTen)}"
                                    data-role-id="${Number(u.vaiTroId)}"
                                    data-status="${escapeHtml(u.trangThai)}">
                                    <td class="ps-3"><span class="badge bg-light text-dark border font-monospace">${escapeHtml(u.tenDangNhap)}</span></td>
                                    <td class="fw-semibold">${escapeHtml(u.hoTen || '')}</td>
                                    <td class="text-muted small">${escapeHtml(u.email || '')}</td>
                                    <td><span class="badge ${roleBadgeClass(u.vaiTro)} role-badge">${escapeHtml(u.vaiTro || 'Chưa phân quyền')}</span></td>
                                    <td><span class="badge ${statusClass} status-badge">${escapeHtml(u.trangThai)}</span></td>
                                    <td class="text-end pe-3 text-nowrap">
                                        <button type="button" class="btn btn-sm btn-outline-primary me-1 btn-edit-role" title="Phân quyền"><i class="fa-solid fa-user-shield"></i></button>
                                        <button type="button" class="btn btn-sm btn-outline-warning me-1 btn-toggle-lock" title="${lockText}"><i class="fa-solid ${lockIcon}"></i></button>
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-soft-delete" title="Xóa mềm"><i class="fa-solid fa-trash"></i></button>
                                    </td>
                                </tr>`;
                    $tbody.append(row);
                });
            }

            function renderPagination(page, totalPages) {
                const $ul = $('#usersPagination').empty();
                if (totalPages <= 1) return;
                for (let i = 1; i <= totalPages; i++) {
                    $ul.append(`<li class="page-item ${i === page ? 'active' : ''}"><button class="page-link" type="button" data-page="${i}">${i}</button></li>`);
                }
            }

            function loadUsers(page) {
                const requestedPage = page || 1;
                $.ajax({
                    url: '/Account/GetAccounts',
                    type: 'GET',
                    dataType: 'json',
                    data: {
                        keyword: $('#searchUserKw').val().trim(),
                        role: $('#filterUserRole').val() || '',
                        trangThai: $('#filterUserStatus').val() || '',
                        page: requestedPage,
                        pageSize: pageSize
                    },
                    success: function(res) {
                        if (!res || !res.success) {
                            $('#userTableBody').html('<tr><td colspan="6" class="text-center text-danger py-4">Máy chủ không trả về danh sách tài khoản hợp lệ.</td></tr>');
                            return;
                        }

                        currentPage = res.currentPage || 1;
                        renderRows(res.items || []);
                        renderPagination(currentPage, res.totalPages || 0);
                        $('#statTotalUsers, #statTotalUsersTop').text(res.totalItems || 0);
                        const total = res.totalItems || 0;
                        const start = total ? ((currentPage - 1) * pageSize + 1) : 0;
                        const end = Math.min(currentPage * pageSize, total);
                        $('#displayRange').text(`${start}-${end}`);
                    },
                    error: function(xhr) {
                        console.error('GetAccounts:', xhr.status, xhr.responseText);
                        $('#userTableBody').html(`<tr><td colspan="6" class="text-center text-danger py-4">Không tải được danh sách tài khoản (HTTP ${xhr.status}). Kiểm tra F12 → Network.</td></tr>`);
                    }
                });
            }

            function loadUnlinkedPersons(group) {
                const $person = $('#selectPerson');
                if ($person.hasClass('select2-hidden-accessible')) {
                    $person.select2('destroy');
                }
                $person.prop('disabled', true).empty().append(new Option('Đang tải danh sách...', ''));

                $('#txtPersonName, #txtPersonCode, #txtPersonDob, #txtUsernameModal, #txtDefaultPassword').val('');

                $.ajax({
                    url: '/Account/GetUnlinkedPersons',
                    type: 'GET',
                    dataType: 'json',
                    data: { loai: group },
                    success: function(res) {
                        $person.empty().append(new Option('-- Chọn người --', ''));
                        if (!res || !res.success) {
                            Swal.fire('Lỗi', res?.message || 'Không tải được hồ sơ.', 'error');
                            return;
                        }

                        (res.items || []).forEach(function(p) {
                            const suffix = p.ngaySinh ? ` - Ngày sinh: ${p.ngaySinh}` : '';
                            const label = `${p.hoTen || ''} (Mã: ${p.ma || ''}${suffix})`;
                            const option = new Option(label, p.id);
                            $(option).attr({
                                'data-ma': p.ma || '',
                                'data-hoten': p.hoTen || '',
                                'data-ngaysinh': p.ngaySinh || ''
                            });
                            $person.append(option);
                        });

                        $person.select2({
                            dropdownParent: $('#modalCreateUser'),
                            width: '100%',
                            placeholder: 'Nhập tên hoặc mã để tìm...',
                            allowClear: true
                        });

                        if (!res.items || res.items.length === 0) {
                            $person.append(new Option('Không còn hồ sơ chưa có tài khoản', ''));
                        }
                    },
                    error: function(xhr) {
                        console.error('GetUnlinkedPersons:', xhr.status, xhr.responseText);
                        $person.empty().append(new Option('Không tải được danh sách', ''));
                        Swal.fire('Lỗi', `Không tải được danh sách hồ sơ (HTTP ${xhr.status}).`, 'error');
                    },
                    complete: function() {
                        $person.prop('disabled', false);
                    }
                });
            }

            $('#menuCreateSingle').on('click', function(e) {
                e.preventDefault();
                $('#formCreateUser')[0].reset();
                $('#selectGroup').val('HocVien');
                createModal.show();
                loadUnlinkedPersons('HocVien');
            });

            $('#selectGroup').on('change', function() {
                loadUnlinkedPersons($(this).val());
            });

            $('#selectPerson').on('change', function() {
                const $option = $(this).find('option:selected');
                const id = $(this).val();
                const name = $option.attr('data-hoten') || '';
                const code = $option.attr('data-ma') || '';
                const dob = $option.attr('data-ngaysinh') || '';

                $('#txtPersonName').val(name);
                $('#txtPersonCode').val(code);
                $('#txtPersonDob').val(dob);

                if (!id) {
                    $('#txtUsernameModal, #txtDefaultPassword').val('');
                    return;
                }

                const prefix = $('#selectGroup').val() === 'HocVien' ? 'HV' : 'NS';
                const usernameSlug = (name || '')
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .replace(/đ/g, 'd').replace(/Đ/g, 'D')
                    .replace(/[^a-zA-Z0-9]/g, '')
                    .toLowerCase();

                $('#txtUsernameModal').val(`${prefix}${String(id).padStart(3, '0')}${usernameSlug ? '_' + usernameSlug : ''}`);
                $('#txtDefaultPassword').val(dob ? dob.split('/').join('') : '123456');
            });

            $('#btnSaveUser').on('click', function() {
                const payload = {
                    loai: $('#selectGroup').val(),
                    personId: Number($('#selectPerson').val()),
                    tenDangNhap: $('#txtUsernameModal').val().trim(),
                    matKhauPlain: $('#txtDefaultPassword').val(),
                    vaiTroId: Number($('#selectRoleModal').val())
                };

                if (!payload.personId || !payload.tenDangNhap || !payload.vaiTroId) {
                    Swal.fire('Thiếu thông tin', 'Vui lòng chọn hồ sơ, nhập tên đăng nhập và chọn vai trò.', 'warning');
                    return;
                }

                Swal.fire({
                    title: 'Xác nhận cấp tài khoản?',
                    text: `Tên đăng nhập: ${payload.tenDangNhap}`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Khởi tạo',
                    cancelButtonText: 'Hủy'
                }).then(function(result) {
                    if (!result.isConfirmed) return;
                    $.ajax({
