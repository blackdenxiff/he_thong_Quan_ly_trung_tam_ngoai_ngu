@using System.Collections.Generic
@model dynamic
@{
    ViewData["Title"] = "Quản lý Tài khoản & Phân quyền";
    var roles = ViewBag.VaiTros as IEnumerable<QLTrungTamTiengAnh_Web.Controllers.RoleOptionDto>
        ?? Enumerable.Empty<QLTrungTamTiengAnh_Web.Controllers.RoleOptionDto>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="h4 mb-1 fw-bold text-dark">Quản Lý Tài Khoản & Phân Quyền Người Dùng</h2>
        <p class="text-muted mb-0">Quản trị danh sách đăng nhập, cấp quyền vai trò hệ thống và kiểm soát bảo mật.</p>
    </div>
    <div class="dropdown">
        <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown">
            <i class="fa-solid fa-user-plus me-1"></i> Cấp Tài Khoản Mới
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="#" id="menuCreateSingle"><i class="fa-solid fa-user-plus me-2"></i>Cấp tài khoản đơn lẻ</a></li>
            <li><a class="dropdown-item" href="#" id="menuCreateBulk"><i class="fa-solid fa-layer-group me-2"></i>Cấp tài khoản hàng loạt</a></li>
            <li><a class="dropdown-item" href="#" id="menuRecycleBin"><i class="fa-solid fa-trash-can me-2"></i>Thùng rác tài khoản</a></li>
        </ul>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm p-3 h-100">
            <span class="text-muted small">TỔNG TÀI KHOẢN</span>
            <div class="fs-3 fw-bold" id="statTotalUsersTop">0</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm p-3 h-100">
            <span class="text-primary small">QUẢN TRỊ VIÊN / QUẢN LÝ</span>
            <div class="fs-3 fw-bold text-primary" id="statAdminUsers">0</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm p-3 h-100">
            <span class="text-success small">GIẢNG VIÊN & NHÂN VIÊN</span>
            <div class="fs-3 fw-bold text-success" id="statStaffUsers">0</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm p-3 h-100">
            <span class="text-danger small">TÀI KHOẢN BỊ KHÓA</span>
            <div class="fs-3 fw-bold text-danger" id="statLockedUsers">0</div>
        </div>
    </div>
</div>

<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-lg-5">
                <input type="search" class="form-control" id="searchUserKw" placeholder="Tìm tên đăng nhập, họ tên hoặc email..." />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <select id="filterUserRole" class="form-select">
                    <option value="">-- Tất cả vai trò --</option>
                    @foreach (var role in roles)
                    {
                        <option value="@role.VaiTroID">@role.TenVaiTro</option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <select id="filterUserStatus" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Hoạt động">Hoạt động</option>
                    <option value="Đã khóa">Đã khóa</option>
                </select>
            </div>
            <div class="col-12 col-lg-2 d-flex gap-2">
                <button type="button" class="btn btn-secondary flex-grow-1" id="btnFilterUser"><i class="fa-solid fa-filter me-1"></i>Lọc</button>
                <button type="button" class="btn btn-outline-secondary" id="btnResetUserFilter" title="Đặt lại"><i class="fa-solid fa-rotate-right"></i></button>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">TÊN ĐĂNG NHẬP</th>
                    <th>HỌ VÀ TÊN</th>
                    <th>EMAIL</th>
                    <th>VAI TRÒ</th>
                    <th>TRẠNG THÁI</th>
                    <th class="text-end pe-3">THAO TÁC</th>
                </tr>
            </thead>
            <tbody id="userTableBody">
                <tr><td colspan="6" class="text-center text-muted py-4">Đang tải danh sách...</td></tr>
            </tbody>
        </table>
    </div>
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
        <small class="text-muted">Hiển thị <span id="displayRange">0-0</span> / <span id="statTotalUsers">0</span> người dùng</small>
        <nav aria-label="Phân trang"><ul class="pagination mb-0" id="usersPagination"></ul></nav>
    </div>
</div>

<!-- Modal cấp tài khoản đơn lẻ -->
<div class="modal fade" id="modalCreateUser" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-plus me-2 text-primary"></i>Cấp Tài Khoản Đơn Lẻ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <form id="formCreateUser">
                    <div class="mb-3">
                        <label for="selectGroup" class="form-label fw-semibold">1. Nhóm đối tượng</label>
                        <select class="form-select" id="selectGroup" required>
                            <option value="HocVien">Học viên chưa có tài khoản</option>
                            <option value="NhanSu">Nhân sự / Giảng viên chưa có tài khoản</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="selectPerson" class="form-label fw-semibold">2. Chọn hồ sơ</label>
                        <select class="form-select" id="selectPerson" style="width:100%" required>
                            <option value="">-- Chọn người --</option>
                        </select>
                        <div class="form-text">Tìm theo tên hoặc mã. Mỗi lần chỉ tải 10 hồ sơ; kéo xuống để tải tiếp.</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label" for="txtPersonName">Họ và tên</label>
                            <input class="form-control bg-light" id="txtPersonName" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="txtPersonCode">Mã hồ sơ</label>
                            <input class="form-control bg-light" id="txtPersonCode" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="txtPersonDob">Ngày sinh</label>
                            <input class="form-control bg-light" id="txtPersonDob" readonly />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="txtUsernameModal">3. Tên đăng nhập</label>
                        <input class="form-control font-monospace" id="txtUsernameModal" required maxlength="50" />
                        <div class="form-text">Tên đăng nhập được gợi ý tự động và có thể chỉnh sửa.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="txtDefaultPassword">4. Mật khẩu khởi tạo</label>
                        <input class="form-control bg-light" id="txtDefaultPassword" readonly />
                        <div class="form-text">Mật khẩu theo ngày sinh (ddMMyyyy); nếu không có ngày sinh, mặc định là 123456. Backend sẽ băm trước khi lưu.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="selectRoleModal">5. Vai trò hệ thống</label>
                        <select class="form-select" id="selectRoleModal" required>
                            <option value="">-- Chọn vai trò --</option>
                            @foreach (var role in roles)
                            {
                                <option value="@role.VaiTroID">@role.TenVaiTro</option>
                            }
                        </select>
                    </div>
                    <div class="alert alert-info small mb-0">Tài khoản mới sẽ được yêu cầu đổi mật khẩu trong lần đăng nhập đầu tiên.</div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveUser"><i class="fa-solid fa-floppy-disk me-1"></i>Khởi tạo tài khoản</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal cấp hàng loạt -->
<div class="modal fade" id="modalBulkCreate" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fa-solid fa-people-group me-2"></i>Cấp tài khoản hàng loạt</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="bulkType">Nhóm đối tượng</label>
                    <select class="form-select" id="bulkType">
                        <option value="HocVien">Học viên chưa có tài khoản</option>
                        <option value="NhanSu">Nhân sự / Giảng viên chưa có tài khoản</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="bulkRole">Vai trò hệ thống</label>
                    <select class="form-select" id="bulkRole">
                        <option value="">-- Chọn vai trò --</option>
                        @foreach (var role in roles)
                        {
                            <option value="@role.VaiTroID">@role.TenVaiTro</option>
                        }
                    </select>
                </div>
                <div class="alert alert-info small mb-0">Tên đăng nhập tự động theo mã hồ sơ. Mật khẩu mặc định theo ngày sinh.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success" id="btnDoBulkCreate">Tiến hành cấp hàng loạt</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal phân quyền -->
<div class="modal fade" id="modalEditRole" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-shield me-2 text-primary"></i>Phân quyền vai trò</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="txtEditUsername">Tên đăng nhập</label>
                    <input class="form-control bg-light" id="txtEditUsername" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="txtEditFullName">Họ tên</label>
                    <input class="form-control bg-light" id="txtEditFullName" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="selectNewRole">Vai trò mới</label>
                    <select class="form-select" id="selectNewRole" required>
                        <option value="">-- Chọn vai trò --</option>
                        @foreach (var role in roles)
                        {
                            <option value="@role.VaiTroID">@role.TenVaiTro</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnUpdateRole">Cập nhật quyền hạn</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal thùng rác -->
<div class="modal fade" id="modalRecycleBin" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-trash-can me-2"></i>Thùng rác tài khoản</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="search" id="trashSearch" class="form-control mb-3" placeholder="Tìm tên đăng nhập trong thùng rác..." autocomplete="off" />
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Tên đăng nhập</th><th>Vai trò</th><th>Ngày xóa</th><th>Thao tác</th></tr></thead>
                        <tbody id="trashTableBody"><tr><td colspan="4" class="text-center text-muted">Chưa tải dữ liệu.</td></tr></tbody>
                    </table>
                </div>
                <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 gap-2">
                    <small class="text-muted">Hiển thị <span id="trashDisplayRange">0-0</span> / <span id="trashTotal">0</span></small>
                    <nav aria-label="Phân trang thùng rác"><ul class="pagination pagination-sm mb-0" id="trashPagination"></ul></nav>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
<style>
    .select2-container .select2-selection--single {
        height: 38px;
        border: 1px solid #dee2e6;
        border-radius: .375rem;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 36px;
        padding-left: 12px;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 36px;
    }

    .select2-dropdown {
        z-index: 2000;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(function() {
            const pageSize = 10;
            let currentPage = 1;
            let currentTrashPage = 1;
            let activeUserId = null;
            let accountsRequest = null;
            let trashRequest = null;
            let trashSearchTimer = null;
            const createModalEl = document.getElementById('modalCreateUser');
            const bulkModalEl = document.getElementById('modalBulkCreate');
            const editModalEl = document.getElementById('modalEditRole');
            const trashModalEl = document.getElementById('modalRecycleBin');
            const createModal = bootstrap.Modal.getOrCreateInstance(createModalEl);
            const bulkModal = bootstrap.Modal.getOrCreateInstance(bulkModalEl);
            const editModal = bootstrap.Modal.getOrCreateInstance(editModalEl);
            const trashModal = bootstrap.Modal.getOrCreateInstance(trashModalEl);

            function escapeHtml(value) {
                return String(value ?? '').replace(/[&<>"']/g, function(c) {
                    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
                });
            }

            function roleBadgeClass(role) {
                const r = (role || '').toLowerCase();
                if (r.includes('admin')) return 'bg-danger-subtle text-danger';
                if (r.includes('quản lý') || r.includes('quanly')) return 'bg-primary-subtle text-primary';
                if (r.includes('giáo viên') || r.includes('giangvien')) return 'bg-info-subtle text-info';
                if (r.includes('nhân viên') || r.includes('nhanvien')) return 'bg-success-subtle text-success';
                return 'bg-secondary-subtle text-secondary';
            }

            function renderRows(items) {
                const $tbody = $('#userTableBody').empty();
                if (!Array.isArray(items) || items.length === 0) {
                    $tbody.html('<tr><td colspan="6" class="text-center text-muted py-4">Không tìm thấy tài khoản phù hợp.</td></tr>');
                    return;
                }

                items.forEach(function(u) {
                    const statusClass = u.trangThai === 'Hoạt động'
                        ? 'bg-success-subtle text-success'
                        : 'bg-danger-subtle text-danger';
                    const lockText = u.trangThai === 'Hoạt động' ? 'Khóa' : 'Mở khóa';
                    const lockIcon = u.trangThai === 'Hoạt động' ? 'fa-lock' : 'fa-lock-open';
                    const row = `
                                        <tr data-id="${Number(u.nguoiDungId)}"
                                            data-username="${escapeHtml(u.tenDangNhap)}"
                                            data-fullname="${escapeHtml(u.hoTen)}"
                                            data-role-id="${Number(u.vaiTroId)}"
                                            data-status="${escapeHtml(u.trangThai)}">
                                            <td class="ps-3"><span class="badge bg-light text-dark border font-monospace">${escapeHtml(u.tenDangNhap)}</span></td>
                                            <td class="fw-semibold">${escapeHtml(u.hoTen || '')}</td>
                                            <td class="text-muted small">${escapeHtml(u.email || '')}</td>
                                            <td><span class="badge ${roleBadgeClass(u.vaiTro)} role-badge">${escapeHtml(u.vaiTro || 'Chưa phân quyền')}</span></td>
                                            <td><span class="badge ${statusClass} status-badge">${escapeHtml(u.trangThai)}</span></td>
                                            <td class="text-end pe-3 text-nowrap">
                                                <button type="button" class="btn btn-sm btn-outline-primary me-1 btn-edit-role" title="Phân quyền"><i class="fa-solid fa-user-shield"></i></button>
                                                <button type="button" class="btn btn-sm btn-outline-warning me-1 btn-toggle-lock" title="${lockText}"><i class="fa-solid ${lockIcon}"></i></button>
                                                <button type="button" class="btn btn-sm btn-outline-danger btn-soft-delete" title="Xóa mềm"><i class="fa-solid fa-trash"></i></button>
                                            </td>
                                        </tr>`;
                    $tbody.append(row);
                });
            }

            // Chỉ vẽ tối đa 5 nút trang cùng Trước/Sau, kể cả khi có hàng nghìn trang.
            function renderPagination(page, totalPages, target) {
                const $ul = $(target).empty();
                if (totalPages <= 1) return;
                const add = (number, label, disabled = false, active = false) => {
                    $ul.append(`<li class="page-item ${disabled ? 'disabled' : ''} ${active ? 'active' : ''}">
                                <button type="button" class="page-link" data-page="${number}" ${disabled ? 'disabled' : ''}>${label}</button>
                            </li>`);
                };
                add(Math.max(1, page - 1), '‹', page <= 1);
                const start = Math.max(1, Math.min(page - 2, totalPages - 4));
                const end = Math.min(totalPages, start + 4);
                for (let i = start; i <= end; i++) add(i, String(i), false, i === page);
                add(Math.min(totalPages, page + 1), '›', page >= totalPages);
            }

            function loadStats() {
                $.getJSON('/Account/GetAccountStats')
                    .done(function(res) {
                        if (!res || !res.success) return;
                        $('#statTotalUsersTop').text(res.totalAccounts ?? 0);
                        $('#statAdminUsers').text(res.adminManagers ?? 0);
                        $('#statStaffUsers').text(res.staffAccounts ?? 0);
                        $('#statLockedUsers').text(res.lockedAccounts ?? 0);
                    })
                    .fail(function(xhr) { console.error('GetAccountStats:', xhr.status); });
            }

            function loadUsers(page) {
                const requestedPage = Math.max(1, Number(page) || 1);
                if (accountsRequest && accountsRequest.readyState !== 4) accountsRequest.abort();
                $('#userTableBody').html('<tr><td colspan="6" class="text-center text-muted py-4">Đang tải...</td></tr>');
                accountsRequest = $.ajax({
                    url: '/Account/GetAccounts',
                    type: 'GET',
                    dataType: 'json',
                    data: {
                        keyword: $('#searchUserKw').val().trim(),
                        role: $('#filterUserRole').val() || '',
                        trangThai: $('#filterUserStatus').val() || '',
                        page: requestedPage,
                        pageSize: pageSize
                    },
                    success: function(res) {
                        if (!res || !res.success) {
                            $('#userTableBody').html('<tr><td colspan="6" class="text-center text-danger py-4">Máy chủ không trả về danh sách tài khoản hợp lệ.</td></tr>');
                            return;
                        }
                        currentPage = res.currentPage || 1;
                        renderRows(res.items || []);
                        renderPagination(currentPage, res.totalPages || 0, '#usersPagination');
                        $('#statTotalUsers').text(res.totalItems || 0);
                        const total = res.totalItems || 0;
                        const start = total ? ((currentPage - 1) * pageSize + 1) : 0;
                        const end = Math.min(currentPage * pageSize, total);
                        $('#displayRange').text(`${start}-${end}`);
                    },
                    error: function(xhr, status) {
                        if (status === 'abort') return;
                        console.error('GetAccounts:', xhr.status, xhr.responseText);
                        $('#userTableBody').html(`<tr><td colspan="6" class="text-center text-danger py-4">Không tải được danh sách tài khoản (HTTP ${xhr.status}).</td></tr>`);
                    }
                });
            }

            // Select2 remote search: mỗi request chỉ tải 10 hồ sơ chưa có tài khoản.
            // Dữ liệu ở trang tiếp theo chỉ tải khi kéo xuống cuối danh sách.
            function loadUnlinkedPersons(group) {
                const $person = $('#selectPerson');
                if ($person.hasClass('select2-hidden-accessible')) $person.select2('destroy');
                $person.empty().append(new Option('', ''));
                $('#txtPersonName, #txtPersonCode, #txtPersonDob, #txtUsernameModal, #txtDefaultPassword').val('');
                $person.select2({
                    dropdownParent: $('#modalCreateUser'),
                    width: '100%',
                    placeholder: '-- Chọn người hoặc nhập tên/mã để tìm --',
                    allowClear: true,
                    ajax: {
                        url: '/Account/GetUnlinkedPersons',
                        dataType: 'json',
                        delay: 300,
                        cache: false,
                        data: function(params) {
                            return {
                                loai: $('#selectGroup').val(),
                                keyword: params.term || '',
                                page: params.page || 1
                            };
                        },
                        processResults: function(res) {
                            if (!res || !res.success) {
                                console.error('GetUnlinkedPersons:', res?.message);
                                return { results: [], pagination: { more: false } };
                            }
                            return {
                                results: (res.items || []).map(function(p) {
                                    return {
                                        id: p.id,
                                        text: `${p.hoTen} (Mã: ${p.ma}${p.ngaySinh ? ', Sinh: ' + p.ngaySinh : ''})`,
                                        ma: p.ma,
                                        hoTen: p.hoTen,
                                        ngaySinh: p.ngaySinh
                                    };
                                }),
                                pagination: { more: res.hasMore === true }
                            };
                        }
                    },
                    language: {
                        noResults: () => 'Không tìm thấy hồ sơ chưa có tài khoản',
                        searching: () => 'Đang tìm...',
                        loadingMore: () => 'Đang tải thêm 10 hồ sơ...'
                    }
                });
            }

            $('#menuCreateSingle').on('click', function(e) {
                e.preventDefault();
                $('#formCreateUser')[0].reset();
                $('#selectGroup').val('HocVien');
                createModal.show();
                loadUnlinkedPersons('HocVien');
            });

            $('#selectGroup').on('change', function() {
                loadUnlinkedPersons($(this).val());
            });

            $('#selectPerson').on('change', function() {
                const selected = $(this).select2('data')[0] || {};
                const id = $(this).val();
                const name = selected.hoTen || '';
                const code = selected.ma || '';
                const dob = selected.ngaySinh || '';

                $('#txtPersonName').val(name);
                $('#txtPersonCode').val(code);
                $('#txtPersonDob').val(dob);
                if (!id) {
                    $('#txtUsernameModal, #txtDefaultPassword').val('');
                    return;
                }

                const prefix = $('#selectGroup').val() === 'HocVien' ? 'HV' : 'NS';
                const usernameSlug = (name || '')
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .replace(/đ/g, 'd').replace(/Đ/g, 'D')
                    .replace(/[^a-zA-Z0-9]/g, '')
                    .toLowerCase();
                const codePrefix = `${prefix}${String(id).padStart(3, '0')}`;
                const suffix = usernameSlug ? '_' + usernameSlug : '';
                $('#txtUsernameModal').val((codePrefix + suffix).slice(0, 50));
                $('#txtDefaultPassword').val(dob ? dob.split('/').join('') : '123456');
            });

            $('#btnSaveUser').on('click', function() {
                const payload = {
                    loai: $('#selectGroup').val(),
                    personId: Number($('#selectPerson').val()),
                    tenDangNhap: $('#txtUsernameModal').val().trim(),
                    vaiTroId: Number($('#selectRoleModal').val())
                };

                if (!payload.personId || !payload.tenDangNhap || !payload.vaiTroId) {
                    Swal.fire('Thiếu thông tin', 'Vui lòng chọn hồ sơ, nhập tên đăng nhập và chọn vai trò.', 'warning');
                    return;
                }

                Swal.fire({
                    title: 'Xác nhận cấp tài khoản?',
                    text: `Tên đăng nhập: ${payload.tenDangNhap}`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Khởi tạo',
                    cancelButtonText: 'Hủy'
                }).then(function(result) {
                    if (!result.isConfirmed) return;
                    $.ajax({
                        url: '/Account/CapTaiKhoanDonLe',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(payload),
                        success: function(res) {
                            if (!res || !res.success) {
                                Swal.fire('Không thể cấp tài khoản', res?.message || 'Có lỗi xảy ra.', 'error');
                                return;
                            }
                            createModal.hide();
                            Swal.fire('Thành công', res.message, 'success');
                            loadUsers(1);
                            loadStats();
                        },
                        error: function(xhr) {
                            console.error('CapTaiKhoanDonLe:', xhr.status, xhr.responseText);
                            Swal.fire('Lỗi máy chủ', `Không thể cấp tài khoản (HTTP ${xhr.status}).`, 'error');
                        }
                    });
                });
            });

            $('#btnFilterUser').on('click', function() { loadUsers(1); });
            $('#btnResetUserFilter').on('click', function() {
                $('#searchUserKw').val('');
                $('#filterUserRole, #filterUserStatus').val('');
                loadUsers(1);
            });
            $('#searchUserKw').on('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    loadUsers(1);
                }
            });
            $('#filterUserRole, #filterUserStatus').on('change', function() { loadUsers(1); });
            $(document).on('click', '#usersPagination [data-page]', function() {
                loadUsers(Number($(this).attr('data-page')));
            });

            $(document).on('click', '.btn-toggle-lock', function() {
                const $row = $(this).closest('tr');
                const id = Number($row.attr('data-id'));
                const username = $row.attr('data-username');
                const isLocking = $row.attr('data-status') === 'Hoạt động';

                Swal.fire({
                    title: isLocking ? `Khóa tài khoản ${username}?` : `Mở khóa tài khoản ${username}?`,
                    text: isLocking ? 'Tài khoản sẽ không thể đăng nhập.' : 'Tài khoản có thể đăng nhập lại.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: isLocking ? 'Khóa tài khoản' : 'Mở khóa',
                    cancelButtonText: 'Hủy'
                }).then(function(result) {
                    if (!result.isConfirmed) return;
                    $.ajax({
                        url: '/Account/DoiTrangThaiKhoa',
                        type: 'POST',
                        data: { id: id, khoa: isLocking },
                        success: function(res) {
                            if (!res || !res.success) {
                                Swal.fire('Không thành công', res?.message || 'Không thể đổi trạng thái.', 'error');
                                return;
                            }
                            Swal.fire('Thành công', res.message, 'success');
                            loadUsers(currentPage);
                            loadStats();
                        },
                        error: function(xhr) {
                            console.error('DoiTrangThaiKhoa:', xhr.status, xhr.responseText);
                            Swal.fire('Lỗi', `Không thể đổi trạng thái (HTTP ${xhr.status}).`, 'error');
                        }
                    });
                });
            });

            $(document).on('click', '.btn-soft-delete', function() {
                const $row = $(this).closest('tr');
                const id = Number($row.attr('data-id'));
                const username = $row.attr('data-username');

                Swal.fire({
                    title: `Xóa mềm tài khoản ${username}?`,
                    text: 'Tài khoản sẽ được chuyển vào thùng rác và có thể khôi phục.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Xóa mềm',
                    cancelButtonText: 'Hủy'
                }).then(function(result) {
                    if (!result.isConfirmed) return;
                    $.ajax({
                        url: '/Account/SoftDelete',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(id),
                        success: function(res) {
                            if (!res || !res.success) {
                                Swal.fire('Không thành công', res?.message || 'Không thể xóa tài khoản.', 'error');
                                return;
                            }
                            Swal.fire('Thành công', res.message, 'success');
                            loadUsers(1);
                            loadStats();
                        },
                        error: function(xhr) {
                            console.error('SoftDelete:', xhr.status, xhr.responseText);
                            Swal.fire('Lỗi', `Không thể xóa mềm (HTTP ${xhr.status}).`, 'error');
                        }
                    });
                });
            });

            $(document).on('click', '.btn-edit-role', function() {
                const $row = $(this).closest('tr');
                activeUserId = Number($row.attr('data-id'));
                $('#txtEditUsername').val($row.attr('data-username'));
                $('#txtEditFullName').val($row.attr('data-fullname'));
                $('#selectNewRole').val(String($row.attr('data-role-id') || ''));
                editModal.show();
            });

            $('#btnUpdateRole').on('click', function() {
                const roleId = Number($('#selectNewRole').val());
                if (!activeUserId || !roleId) {
                    Swal.fire('Thiếu thông tin', 'Vui lòng chọn vai trò.', 'warning');
                    return;
                }

                $.ajax({
                    url: '/Account/CapNhatQuyen',
                    type: 'POST',
                    data: { id: activeUserId, vaiTroMoi: roleId },
                    success: function(res) {
                        if (!res || !res.success) {
                            Swal.fire('Lỗi', res?.message || 'Không thể cập nhật vai trò.', 'error');
                            return;
                        }
                        editModal.hide();
                        Swal.fire('Thành công', res.message, 'success');
                        loadUsers(currentPage);
                        loadStats();
                    },
                    error: function(xhr) {
                        console.error('CapNhatQuyen:', xhr.status, xhr.responseText);
                        Swal.fire('Lỗi', `Không thể cập nhật vai trò (HTTP ${xhr.status}).`, 'error');
                    }
                });
            });

            $('#menuCreateBulk').on('click', function(e) {
                e.preventDefault();
                $('#bulkType').val('HocVien');
                $('#bulkRole').val('');
                bulkModal.show();
            });

            $('#btnDoBulkCreate').on('click', function() {
                const payload = {
                    loai: $('#bulkType').val(),
                    vaiTroId: Number($('#bulkRole').val())
                };
                if (!payload.vaiTroId) {
                    Swal.fire('Thiếu thông tin', 'Vui lòng chọn vai trò hệ thống.', 'warning');
                    return;
                }

                Swal.fire({
                    title: 'Xác nhận cấp hàng loạt?',
                    text: 'Hệ thống sẽ tạo tài khoản cho các hồ sơ chưa có tài khoản trong nhóm đã chọn.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Tiến hành',
                    cancelButtonText: 'Hủy'
                }).then(function(result) {
                    if (!result.isConfirmed) return;
                    $.ajax({
                        url: '/Account/CapTaiKhoanHangLoat',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(payload),
                        success: function(res) {
                            if (!res || !res.success) {
                                Swal.fire('Lỗi', res?.message || 'Không thể cấp hàng loạt.', 'error');
                                return;
                            }
                            bulkModal.hide();
                            Swal.fire('Hoàn tất', res.message, 'success');
                            loadUsers(1);
                            loadStats();
                        },
                        error: function(xhr) {
                            console.error('CapTaiKhoanHangLoat:', xhr.status, xhr.responseText);
                            Swal.fire('Lỗi', `Không thể cấp hàng loạt (HTTP ${xhr.status}).`, 'error');
                        }
                    });
                });
            });

            // Thùng rác: tìm kiếm/phân trang tại server, không tải toàn bộ một lần.
            function loadTrash(page = 1) {
                const requestedPage = Math.max(1, Number(page) || 1);
                if (trashRequest && trashRequest.readyState !== 4) trashRequest.abort();
                $('#trashTableBody').html('<tr><td colspan="4" class="text-center text-muted">Đang tải...</td></tr>');
                trashRequest = $.ajax({
                    url: '/Account/Trash',
                    type: 'GET',
                    dataType: 'json',
                    data: { page: requestedPage, keyword: $('#trashSearch').val().trim() },
                    success: function(res) {
                        if (!res || !res.success) {
                            $('#trashTableBody').html('<tr><td colspan="4" class="text-center text-danger">Không tải được thùng rác.</td></tr>');
                            return;
                        }
                        currentTrashPage = res.currentPage || 1;
                        const $tbody = $('#trashTableBody').empty();
                        if (!res.items || res.items.length === 0) {
                            $tbody.html('<tr><td colspan="4" class="text-center text-muted">Thùng rác trống hoặc không có kết quả.</td></tr>');
                        } else {
                            res.items.forEach(function(u) {
                                const deletedAt = u.deletedAt ? new Date(u.deletedAt).toLocaleString('vi-VN') : '';
                                $tbody.append(`<tr data-id="${Number(u.nguoiDungId)}">
                                            <td>${escapeHtml(u.tenDangNhap)}</td>
                                            <td>${escapeHtml(u.vaiTro)}</td>
                                            <td>${escapeHtml(deletedAt)}</td>
                                            <td><button type="button" class="btn btn-sm btn-success btn-restore">Khôi phục</button></td>
                                        </tr>`);
                            });
                        }
                        const total = res.totalItems || 0;
                        const first = total ? (currentTrashPage - 1) * pageSize + 1 : 0;
                        const last = Math.min(currentTrashPage * pageSize, total);
                        $('#trashDisplayRange').text(`${first}-${last}`);
                        $('#trashTotal').text(total);
                        renderPagination(currentTrashPage, res.totalPages || 0, '#trashPagination');
                    },
                    error: function(xhr, status) {
                        if (status === 'abort') return;
                        $('#trashTableBody').html(`<tr><td colspan="4" class="text-danger text-center">Lỗi tải thùng rác (HTTP ${xhr.status}).</td></tr>`);
                    }
                });
            }

            $('#menuRecycleBin').on('click', function(e) {
                e.preventDefault();
                $('#trashSearch').val('');
                trashModal.show();
                loadTrash(1);
            });

            $('#trashSearch').on('input', function() {
                clearTimeout(trashSearchTimer);
                trashSearchTimer = setTimeout(() => loadTrash(1), 300);
            });
            $(document).on('click', '#trashPagination [data-page]', function() {
                loadTrash(Number($(this).attr('data-page')));
            });

            $(document).on('click', '.btn-restore', function() {
                const id = Number($(this).closest('tr').attr('data-id'));
                Swal.fire({
                    title: 'Khôi phục tài khoản?',
                    text: 'Tài khoản sẽ được đưa trở lại danh sách.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Khôi phục',
                    cancelButtonText: 'Hủy'
                }).then(function(result) {
                    if (!result.isConfirmed) return;
                    $.post('/Account/Restore', { id: id })
                        .done(function(res) {
                            if (!res || !res.success) {
                                Swal.fire('Lỗi', res?.message || 'Không thể khôi phục.', 'error');
                                return;
                            }
                            Swal.fire('Thành công', res.message, 'success');
                            loadTrash(currentTrashPage);
                            loadUsers(1);
                            loadStats();
                        })
                        .fail(function(xhr) {
                            Swal.fire('Lỗi', `Không thể khôi phục (HTTP ${xhr.status}).`, 'error');
                        });
                });
            });

            loadStats();
            loadUsers(1);
        });
    </script>
}
