@{
    ViewData["Title"] = "Quản lý Bảng lương";
}

<style>
    @@media print {
        body * { visibility: hidden; }
        #payslipPrintArea, #payslipPrintArea * { visibility: visible; }
        #payslipPrintArea {
            position: absolute; left: 0; top: 0; width: 100%;
            margin: 0; padding: 24px !important; background: white !important;
        }
        .modal-footer, .btn-close { display: none !important; }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 text-dark fw-bold">Bảng Lương & Chi Trả Thù Lao</h4>
        <p class="text-muted small mb-0">Tính toán thu nhập giảng viên theo giờ đứng lớp, phụ cấp và giải ngân lương tháng</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalSalary" onclick="openCreateSalaryModal()">
        <i class="fa-solid fa-calculator me-1"></i> Tính Lương Nhân Sự Mới
    </button>
</div>

<!-- 4 Thẻ chỉ số tổng quỹ lương -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-muted small fw-semibold">TỔNG QUỸ LƯƠNG</span>
            <h4 class="fw-bold mb-0 text-dark" id="statTotalPayroll">0 đ</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-success small fw-semibold">ĐÃ CHI TRẢ</span>
            <h4 class="fw-bold mb-0 text-success" id="statPaidPayroll">0 đ</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-warning small fw-semibold">CHƯA GIẢI NGÂN</span>
            <h4 class="fw-bold mb-0 text-warning" id="statPendingPayroll">0 đ</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-primary small fw-semibold">TỔNG GIỜ ĐỨNG LỚP</span>
            <h4 class="fw-bold mb-0 text-primary" id="statTotalHours">0 giờ</h4>
        </div>
    </div>
</div>

<!-- Bảng lương nhân sự -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3">MÃ PHIẾU</th>
                        <th>GIẢNG VIÊN / NHÂN VIÊN</th>
                        <th>KỲ LƯƠNG</th>
                        <th>LƯƠNG CƠ BẢN</th>
                        <th>GIỜ DẠY & THÙ LAO</th>
                        <th>PHỤ CẤP / THƯỞNG</th>
                        <th>THỰC LĨNH</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end pe-3">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody id="salaryTableBody">
                    <!-- Dữ liệu từ SQL sẽ được đổ vào đây -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal 1: Tính Lương Nhân Sự Mới -->
<div class="modal fade" id="modalSalary" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-calculator me-2 text-primary"></i>Lập Bảng Tính Lương Chi Tiết</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formSalary">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Chọn Nhân Sự / Giảng Viên <span class="text-danger">*</span></label>
                            <select class="form-select" id="selectStaffSalary" required>
                                <option value="">-- Đang tải nhân sự từ CSDL --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Kỳ Lương Tháng</label>
                            <input type="text" class="form-control bg-light" id="txtSalaryMonth" value="10/2026" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Lương Cơ Bản (VNĐ)</label>
                            <input type="number" class="form-control bg-light fw-bold" id="txtBaseSalary" value="0" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Số Giờ Dạy Trong Tháng</label>
                            <input type="number" class="form-control" id="txtTeachHours" value="20" min="0" step="1" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Đơn Giá / Giờ (VNĐ)</label>
                            <input type="number" class="form-control" id="txtHourlyRate" value="180000" min="0" step="10000" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Phụ Cấp (VNĐ)</label>
                            <input type="number" class="form-control" id="txtAllowance" value="500000" min="0" step="100000" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Thưởng Thêm (VNĐ)</label>
                            <input type="number" class="form-control" id="txtBonus" value="0" min="0" step="100000" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Khấu Trừ / Phạt (VNĐ)</label>
                            <input type="number" class="form-control text-danger" id="txtDeduction" value="0" min="0" step="50000" />
                        </div>
                        <div class="col-12">
                            <div class="p-3 bg-light rounded d-flex justify-content-between align-items-center border">
                                <div>
                                    <span class="text-muted fw-semibold">TỔNG LƯƠNG THỰC LĨNH:</span>
                                </div>
                                <h3 class="fw-bold text-success mb-0" id="displayNetSalary">0 đ</h3>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveSalary">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Lưu Phiếu Lương
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 2: In & Xem Trước Phiếu Lương -->
<div class="modal fade" id="modalPrintPayslip" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-body p-4" id="payslipPrintArea">
                <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
                    <div>
                        <h5 class="fw-bold mb-0 text-primary">TRUNG TÂM ANH NGỮ ENGLISH CENTER</h5>
                        <p class="small text-muted mb-0">Hà Nội - Hotline: 0900000001</p>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-light text-dark border fs-6" id="pSlipCode">PL-1001</span>
                    </div>
                </div>
                <div class="text-center my-3">
                    <h4 class="fw-bold text-dark text-uppercase mb-1">PHIẾU THANH TOÁN THÙ LAO & LƯƠNG</h4>
                    <span class="text-muted fw-semibold">Kỳ lương: <span id="pSlipMonth">10/2026</span></span>
                </div>
                <div class="row g-2 mb-3 small bg-light p-3 rounded">
                    <div class="col-6"><strong>Họ và tên:</strong> <span id="pSlipName" class="fw-bold text-dark"></span></div>
                    <div class="col-6"><strong>Chức vụ:</strong> <span id="pSlipRole"></span></div>
                    <div class="col-6"><strong>Trạng thái:</strong> <span id="pSlipStatus" class="badge"></span></div>
                </div>
                <table class="table table-bordered table-sm small mb-3">
                    <thead class="bg-light">
                        <tr>
                            <th>KHOẢN MỤC</th>
                            <th class="text-center">SỐ LƯỢNG</th>
                            <th class="text-end">ĐƠN GIÁ</th>
                            <th class="text-end">THÀNH TIỀN</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1. Lương cơ bản</td>
                            <td class="text-center">1 tháng</td>
                            <td class="text-end" id="pSlipBaseRate">0 đ</td>
                            <td class="text-end fw-semibold" id="pSlipBaseTotal">0 đ</td>
                        </tr>
                        <tr>
                            <td>2. Thù lao giảng dạy</td>
                            <td class="text-center" id="pSlipHours">0 giờ</td>
                            <td class="text-end" id="pSlipHourlyRate">0 đ</td>
                            <td class="text-end fw-semibold" id="pSlipTeachingBonus">0 đ</td>
                        </tr>
                        <tr>
                            <td>3. Phụ cấp & Thưởng</td>
                            <td class="text-center">--</td>
                            <td class="text-end">--</td>
                            <td class="text-end text-success fw-semibold" id="pSlipAllowance">0 đ</td>
                        </tr>
                        <tr>
                            <td>4. Khấu trừ</td>
                            <td class="text-center">--</td>
                            <td class="text-end">--</td>
                            <td class="text-end text-danger fw-semibold" id="pSlipDeduction">0 đ</td>
                        </tr>
                        <tr class="table-active border-top">
                            <td colspan="3" class="fw-bold text-uppercase fs-6">TỔNG THỰC LĨNH:</td>
                            <td class="text-end fw-bold text-primary fs-5" id="pSlipNetTotal">0 đ</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="window.print()">
                    <i class="fa-solid fa-print me-1"></i> In Ngay
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let globalStaffList = [];

            loadDanhSachBangLuong();

            function loadDanhSachBangLuong() {
                $.ajax({
                    url: '/BangLuong/LayDanhSachBangLuong',
                    type: 'GET',
                    success: function (res) {
                        if (res.success) {
                            let tbody = $('#salaryTableBody');
                            tbody.empty();
                            let list = res.data;
                            globalStaffList = res.nhanSuList;

                            let selectStaff = $('#selectStaffSalary');
                            selectStaff.empty();
                            
                            // Log ra console để check dữ liệu từ SQL
                            console.log("Danh sách nhân sự từ CSDL: ", globalStaffList);

                            if(globalStaffList.length === 0) {
                                selectStaff.append('<option value="">-- Chưa có dữ liệu nhân sự trong CSDL --</option>');
                            } else {
                                selectStaff.append('<option value="">-- Chọn nhân sự từ CSDL --</option>');
                                globalStaffList.forEach(ns => {
                                    // Sửa lại cho hỗ trợ cả trường hợp JSON Serialize bị viết hoa chữ cái đầu (nhanVienId hoặc NhanVienId)
                                    let id = ns.nhanVienId || ns.NhanVienId;
                                    let name = ns.hoTen || ns.HoTen;
                                    let base = ns.luongCoBan || ns.LuongCoBan || 0;
                                    selectStaff.append(`<option value="${id}" data-base="${base}">${name}</option>`);
                                });
                            }

                            if (list.length === 0) {
                                tbody.append('<tr><td colspan="9" class="text-center py-4 text-muted">Chưa có phiếu lương nào trong cơ sở dữ liệu.</td></tr>');
                                updateStats([]);
                                return;
                            }

                            list.forEach(function (item) {
                                // Hỗ trợ JSON viết hoa
                                let id = item.bangLuongId || item.BangLuongId;
                                let hoTen = item.hoTen || item.HoTen;
                                let chucVu = item.chucVu || item.ChucVu;
                                let thangNam = item.thangNam || item.ThangNam;
                                let luongCoBan = item.luongCoBan || item.LuongCoBan || 0;
                                let soGioDay = item.soGioDay || item.SoGioDay || 0;
                                let phuCap = item.phuCap || item.PhuCap || 0;
                                let thuong = item.thuong || item.Thuong || 0;
                                let khauTru = item.khauTru || item.KhauTru || 0;
                                let thucLinh = item.thucLinh || item.ThucLinh || 0;
                                let trangThai = item.trangThai || item.TrangThai;

                                let badgeClass = trangThai === 'Đã chi trả' ? 'bg-success-subtle text-success border-success-subtle' : 'bg-warning-subtle text-warning border-warning-subtle';
                                let payBtn = trangThai === 'Đã chi trả' ? '' : `
                                    <button class="btn btn-sm btn-outline-success me-1 btn-pay" title="Chi trả lương" onclick="confirmPaySalary(${id}, ${thucLinh})">
                                        <i class="fa-solid fa-money-bill-transfer"></i>
                                    </button>`;

                                let tr = `
                                    <tr>
                                        <td class="ps-3"><span class="badge bg-light text-dark border fw-bold">PL-${id}</span></td>
                                        <td>
                                            <div class="fw-bold text-dark">${hoTen}</div>
                                            <small class="text-muted">${chucVu}</small>
                                        </td>
                                        <td><span class="badge bg-light text-primary border">${thangNam}</span></td>
                                        <td>${luongCoBan.toLocaleString()} đ</td>
                                        <td>
                                            <div><strong>${soGioDay} giờ</strong></div>
                                            <small class="text-muted">Thù lao: ${(soGioDay * 180000).toLocaleString()} đ</small>
                                        </td>
                                        <td class="text-success">+${(phuCap + thuong).toLocaleString()} đ</td>
                                        <td class="fw-bold text-dark fs-6">${thucLinh.toLocaleString()} đ</td>
                                        <td><span class="badge ${badgeClass} border status-badge">${trangThai}</span></td>
                                        <td class="text-end pe-3">
                                            ${payBtn}
                                            <button class="btn btn-sm btn-outline-secondary" title="In phiếu" onclick="printPayslip('PL-${id}', '${hoTen}', '${chucVu}', '${thangNam}', ${luongCoBan}, ${soGioDay}, 180000, ${soGioDay * 180000}, ${phuCap + thuong}, ${khauTru}, ${thucLinh}, '${trangThai}')">
                                                <i class="fa-solid fa-print"></i>
                                            </button>
                                        </td>
                                    </tr>
                                `;
                                tbody.append(tr);
                            });

                            updateStats(list);
                        } else {
                            // BẮT LỖI TỪ C#: Nếu try-catch trong SQL bị ném lỗi, thông báo sẽ hiện lên đây
                            Swal.fire('Lỗi tải dữ liệu', res.message, 'error');
                            $('#selectStaffSalary').empty().append('<option value="">-- Lỗi tải CSDL --</option>');
                            $('#salaryTableBody').append(`<tr><td colspan="9" class="text-center py-4 text-danger">Lỗi CSDL: ${res.message}</td></tr>`);
                        }
                    },
                    error: function(err) {
                        console.error("AJAX Error:", err);
                        Swal.fire('Lỗi kết nối', 'Không thể kết nối đến máy chủ. Kiểm tra lại kết nối mạng hoặc xem Console.', 'error');
                    }
                });
            }

            $('#selectStaffSalary').change(function () {
                const opt = $(this).find(':selected');$('#txtBaseSalary').val(parseFloat(opt.data('base')) || 0);
                calculateSalary();
            });

            $('#txtTeachHours, #txtHourlyRate, #txtAllowance, #txtBonus, #txtDeduction').on('input', function () {
                calculateSalary();
            });

            function calculateSalary() {
                const base = parseFloat($('#txtBaseSalary').val()) || 0;
                let hours = parseFloat($('#txtTeachHours').val()) || 0;
                let rate = parseFloat($('#txtHourlyRate').val()) || 0;
                let allowance = parseFloat($('#txtAllowance').val()) || 0;
                let bonus = parseFloat($('#txtBonus').val()) || 0;
                let deduction = parseFloat($('#txtDeduction').val()) || 0;

                const net = base + (hours * rate) + allowance + bonus - deduction;
                $('#displayNetSalary').text(net.toLocaleString() + ' đ');
            }

            window.openCreateSalaryModal = function () {
                $('#formSalary')[0].reset();
                $('#txtSalaryMonth').val('10/2026');
                $('#txtTeachHours').val(20);
                $('#txtHourlyRate').val(180000);
                $('#txtAllowance').val(500000);
                $('#txtBonus').val(0);
                $('#txtDeduction').val(0);
                $('#displayNetSalary').text('0 đ');
            };

            $('#btnSaveSalary').click(function () {
                const staffId = $('#selectStaffSalary').val();
                if (!staffId) {
                    Swal.fire('Thiếu dữ liệu', 'Vui lòng chọn nhân sự!', 'warning');
                    return;
                }

                const payload = {
                    nhanVienId: parseInt(staffId),
                    thangNam: $('#txtSalaryMonth').val(),
                    luongCoBan: parseFloat($('#txtBaseSalary').val()) || 0,
                    soGioDay: parseFloat($('#txtTeachHours').val()) || 0,
                    donGiaGio: parseFloat($('#txtHourlyRate').val()) || 0,
                    phuCap: parseFloat($('#txtAllowance').val()) || 0,
                    thuong: parseFloat($('#txtBonus').val()) || 0,
                    khauTru: parseFloat($('#txtDeduction').val()) || 0
                };

                $.ajax({
                    url: '/BangLuong/LuuBangLuong',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            $('#modalSalary').modal('hide');
                            Swal.fire('Thành công!', res.message, 'success');
                            loadDanhSachBangLuong();
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    }
                });
            });

            window.confirmPaySalary = function (id, amount) {
                Swal.fire({
                    title: 'Xác nhận giải ngân lương?',
                    text: `Chi trả số tiền ${amount.toLocaleString()} đ cho nhân sự này?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#10b981',
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy'
                }).then((r) => {
                    if (r.isConfirmed) {
                        $.ajax({
                            url: '/BangLuong/ChiTraLuong?bangLuongId=' + id,
                            type: 'POST',
                            success: function (res) {
                                if (res.success) {
                                    Swal.fire('Thành công', res.message, 'success');
                                    loadDanhSachBangLuong();
                                } else {
                                    Swal.fire('Lỗi', res.message, 'error');
                                }
                            }
                        });
                    }
                });
            };

            window.printPayslip = function (code, name, role, month, base, hours, rate, teachBonus, allow, ded, net, status) {
                $('#pSlipCode').text(code);
                $('#pSlipName').text(name);
                $('#pSlipRole').text(role);
                $('#pSlipMonth').text(month);
                $('#pSlipBaseRate').text(base.toLocaleString() + ' đ');
                $('#pSlipBaseTotal').text(base.toLocaleString() + ' đ');
                $('#pSlipHours').text(hours + ' giờ');
                $('#pSlipHourlyRate').text(rate.toLocaleString() + ' đ');
                $('#pSlipTeachingBonus').text(teachBonus.toLocaleString() + ' đ');
                $('#pSlipAllowance').text('+' + allow.toLocaleString() + ' đ');
                $('#pSlipDeduction').text('-' + ded.toLocaleString() + ' đ');
                $('#pSlipNetTotal').text(net.toLocaleString() + ' đ');
                $('#pSlipStatus').text(status).attr('class', status === 'Đã chi trả' ? 'badge bg-success-subtle text-success' : 'badge bg-warning-subtle text-warning');

                $('#modalPrintPayslip').modal('show');
            };

            function updateStats(list) {
                let totalPayroll = 0;
                let paidPayroll = 0;
                let pendingPayroll = 0;
                let totalHours = 0;

                list.forEach(item => {
                    // Hỗ trợ JSON viết hoa
                    let thucLinh = item.thucLinh || item.ThucLinh || 0;
                    let trangThai = item.trangThai || item.TrangThai;
                    let soGioDay = item.soGioDay || item.SoGioDay || 0;

                    totalPayroll += thucLinh;
                    if (trangThai === 'Đã chi trả') {
                        paidPayroll += thucLinh;
                    } else {
                        pendingPayroll += thucLinh;
                    }
                    totalHours += soGioDay;
                });

                $('#statTotalPayroll').text(totalPayroll.toLocaleString() + ' đ');
                $('#statPaidPayroll').text(paidPayroll.toLocaleString() + ' đ');
                $('#statPendingPayroll').text(pendingPayroll.toLocaleString() + ' đ');
                $('#statTotalHours').text(totalHours + ' giờ');
            }
        });
    </script>
}