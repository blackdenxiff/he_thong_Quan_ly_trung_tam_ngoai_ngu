@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Thời khóa biểu & Phòng học";
    var userRole = Context.Session.GetString("UserRole") ?? "Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 text-dark fw-bold">Thời Khóa Biểu & Quản Lý Phòng Học</h4>
        <p class="text-muted small mb-0">Theo dõi lịch học theo tuần, điều phối phòng học chống trùng ca và phân công dạy thay (F12, F13, RN02)</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm" id="btnPrevWeek"><i class="fa-solid fa-chevron-left"></i></button>
        <button class="btn btn-outline-secondary btn-sm fw-semibold" id="btnCurrentWeek">Tuần Hiện Tại (05/10 - 11/10/2026)</button>
        <button class="btn btn-outline-secondary btn-sm" id="btnNextWeek"><i class="fa-solid fa-chevron-right"></i></button>
        @if (userRole == "Admin" || userRole == "Quản lý" || userRole == "Nhân viên")
        {
            <button class="btn btn-primary btn-sm ms-2" data-bs-toggle="modal" data-bs-target="#modalSchedule">
                <i class="fa-solid fa-calendar-plus me-1"></i> Xếp Lịch Mới
            </button>
        }
    </div>
</div>

<!-- Lưới thời khóa biểu (Timetable Grid) -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered mb-0 align-middle text-center" style="min-width: 900px;">
                <thead class="bg-light">
                    <tr>
                        <th style="width: 130px;" class="py-3">KHUNG GIỜ</th>
                        <th>Thứ 2<br /><small class="text-muted fw-normal">05/10</small></th>
                        <th>Thứ 3<br /><small class="text-muted fw-normal">06/10</small></th>
                        <th>Thứ 4<br /><small class="text-muted fw-normal">07/10</small></th>
                        <th>Thứ 5<br /><small class="text-muted fw-normal">08/10</small></th>
                        <th>Thứ 6<br /><small class="text-muted fw-normal">09/10</small></th>
                        <th>Thứ 7<br /><small class="text-muted fw-normal">10/10</small></th>
                        <th>Chủ Nhật<br /><small class="text-muted fw-normal">11/10</small></th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Ca Sáng -->
                    <tr>
                        <td class="bg-light fw-bold text-secondary">
                            <div>Ca Sáng</div>
                            <small class="text-muted fw-normal">08:00 - 10:00</small>
                        </td>
                        <td class="cell-slot" data-day="Thứ 2" data-time="Ca sáng (08:00 - 10:00)">
                            <!-- Buổi học: Có phân công DẠY THAY -->
                            <div class="schedule-card p-2 rounded bg-warning-subtle border border-warning text-start small" 
                                 data-id="201" data-room="P.102" data-classname="IELTS6.5-K02" 
                                 data-owner-id="2" data-owner="Nguyễn Quản Lý" 
                                 data-actual-id="3" data-actual="Lê Văn Hướng Dẫn" 
                                 data-issub="true" style="cursor: pointer;">
                                <div class="fw-bold text-dark d-flex justify-content-between align-items-center">
                                    <span>IELTS6.5-K02</span>
                                    <span class="badge bg-warning text-dark border">Dạy thay</span>
                                </div>
                                <div class="text-muted"><i class="fa-solid fa-chalkboard-user me-1"></i>Chính: Nguyễn Quản Lý</div>
                                <div class="text-danger fw-semibold"><i class="fa-solid fa-user-tag me-1"></i>Đứng lớp: Lê Văn Hướng Dẫn</div>
                                <span class="badge bg-primary mt-1">P.102</span>
                            </div>
                        </td>
                        <td class="cell-slot" data-day="Thứ 3" data-time="Ca sáng (08:00 - 10:00)"></td>
                        <td class="cell-slot" data-day="Thứ 4" data-time="Ca sáng (08:00 - 10:00)">
                            <div class="schedule-card p-2 rounded bg-info-subtle border border-info text-start small" 
                                 data-id="202" data-room="P.102" data-classname="IELTS6.5-K02" 
                                 data-owner-id="2" data-owner="Nguyễn Quản Lý" 
                                 data-actual-id="2" data-actual="Nguyễn Quản Lý" 
                                 data-issub="false" style="cursor: pointer;">
                                <div class="fw-bold text-dark">IELTS6.5-K02</div>
                                <div class="text-muted"><i class="fa-solid fa-chalkboard-user me-1"></i>GV: Nguyễn Quản Lý</div>
                                <span class="badge bg-primary mt-1">P.102</span>
                            </div>
                        </td>
                        <td class="cell-slot" data-day="Thứ 5" data-time="Ca sáng (08:00 - 10:00)"></td>
                        <td class="cell-slot" data-day="Thứ 6" data-time="Ca sáng (08:00 - 10:00)">
                            <div class="schedule-card p-2 rounded bg-info-subtle border border-info text-start small" 
                                 data-id="203" data-room="P.102" data-classname="IELTS6.5-K02" 
                                 data-owner-id="2" data-owner="Nguyễn Quản Lý" 
                                 data-actual-id="2" data-actual="Nguyễn Quản Lý" 
                                 data-issub="false" style="cursor: pointer;">
                                <div class="fw-bold text-dark">IELTS6.5-K02</div>
                                <div class="text-muted"><i class="fa-solid fa-chalkboard-user me-1"></i>GV: Nguyễn Quản Lý</div>
                                <span class="badge bg-primary mt-1">P.102</span>
                            </div>
                        </td>
                        <td class="cell-slot" data-day="Thứ 7" data-time="Ca sáng (08:00 - 10:00)"></td>
                        <td class="cell-slot" data-day="Chủ Nhật" data-time="Ca sáng (08:00 - 10:00)"></td>
                    </tr>
                    <!-- Ca Chiều -->
                    <tr>
                        <td class="bg-light fw-bold text-secondary">
                            <div>Ca Chiều</div>
                            <small class="text-muted fw-normal">14:00 - 16:00</small>
                        </td>
                        <td class="cell-slot" data-day="Thứ 2" data-time="Ca chiều (14:00 - 16:00)"></td>
                        <td class="cell-slot" data-day="Thứ 3" data-time="Ca chiều (14:00 - 16:00)">
