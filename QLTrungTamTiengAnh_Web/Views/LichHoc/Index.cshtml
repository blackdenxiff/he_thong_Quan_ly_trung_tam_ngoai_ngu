                                 data-actual-id="3" data-actual="Lê Văn Hướng Dẫn" 
                                 data-issub="false" style="cursor: pointer;">
                                <div class="fw-bold text-dark">GIAOTIEP-K01</div>
                                <div class="text-muted"><i class="fa-solid fa-chalkboard-user me-1"></i>GV: Lê Văn Hướng Dẫn</div>
                                <span class="badge bg-secondary mt-1">P.103</span>
                            </div>
                        </td>
                        <td class="cell-slot" data-day="Thứ 4" data-time="Ca chiều (14:00 - 16:00)"></td>
                        <td class="cell-slot" data-day="Thứ 5" data-time="Ca chiều (14:00 - 16:00)">
