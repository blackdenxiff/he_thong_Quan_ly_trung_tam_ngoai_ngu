@{
    ViewData["Title"] = "Thời khóa biểu & Phòng học";
    var danhSachLich = ViewBag.DanhSachLich as List<QuanLyTrungTamNgoaiNgu.Models.LichHoc> ?? new();
    var danhSachLop = ViewBag.DanhSachLop as List<QuanLyTrungTamNgoaiNgu.Models.LopHoc> ?? new();
    var danhSachPhong = ViewBag.DanhSachPhong as List<QuanLyTrungTamNgoaiNgu.Models.PhongHoc> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h4 class="mb-1 text-dark fw-bold">Thời Khóa Biểu & Quản Lý Phòng Học</h4>
        <p class="text-muted small mb-0">Theo dõi lịch đào tạo theo tuần từ SQL Server, điều phối phòng học và chống trùng ca</p>
    </div>

    <!-- Bộ lọc tìm lịch theo lớp học & Các nút điều hướng -->
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="input-group input-group-sm" style="width: 240px;">
            <select class="form-select form-select-sm" id="filterClass">
                <option value="0">-- Tất cả các lớp --</option>
                @foreach (var lop in danhSachLop)
                {
                    <option value="@lop.TenLop">Lớp: @lop.TenLop</option>
                }
            </select>
        </div>
        <button class="btn btn-outline-secondary btn-sm" id="btnPrevWeek"><i class="fa-solid fa-chevron-left"></i></button>
        <button class="btn btn-outline-secondary btn-sm fw-semibold" id="btnCurrentWeek">Tuần (05/10 - 11/10)</button>
        <button class="btn btn-outline-secondary btn-sm" id="btnNextWeek"><i class="fa-solid fa-chevron-right"></i></button>
        <button class="btn btn-primary btn-sm ms-1" data-bs-toggle="modal" data-bs-target="#modalSchedule">
            <i class="fa-solid fa-calendar-plus me-1"></i> Xếp Lịch Học Mới
        </button>
    </div>
</div>

<!-- Lưới thời khóa biểu (Timetable Grid) động từ SQL -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered mb-0 align-middle text-center" style="min-width: 900px;">
                <thead class="bg-light">
                    <tr>
                        <th style="width: 130px;" class="py-3">KHUNG GIỜ</th>
                        <th>Thứ 2<br /><small class="text-muted fw-normal">05/10</small></th>
                        <th>Thứ 3<br /><small class="text-muted fw-normal">06/10</small></th>
                        <th>Thứ 4<br /><small class="text-muted fw-normal">07/10</small></th>
                        <th>Thứ 5<br /><small class="text-muted fw-normal">08/10</small></th>
                        <th>Thứ 6<br /><small class="text-muted fw-normal">09/10</small></th>
                        <th>Thứ 7<br /><small class="text-muted fw-normal">10/10</small></th>
                        <th>Chủ Nhật<br /><small class="text-muted fw-normal">11/10</small></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        string[] cacCa = { "Ca Sáng", "Ca Chiều", "Ca Tối" };
                        string[] khungGioArr = { "Ca sáng (08:00 - 10:00)", "Ca chiều (14:00 - 16:00)", "Ca tối (18:00 - 20:00)" };
                        string[] thuArr = { "Thứ 2", "Thứ 3", "Thứ 4", "Thứ 5", "Thứ 6", "Thứ 7", "Chủ Nhật" };
                    }

                    @for (int i = 0; i < cacCa.Length; i++)
                    {
                        string tenCa = cacCa[i];
                        string khungGio = khungGioArr[i];
                        string gioHienThi = tenCa == "Ca Sáng" ? "08:00 - 10:00" : (tenCa == "Ca Chiều" ? "14:00 - 16:00" : "18:00 - 20:00");

                        <tr>
                            <td class="bg-light fw-bold text-secondary">
                                <div>@tenCa</div>
                                <small class="text-muted fw-normal">@gioHienThi</small>
                            </td>

                            @foreach (var thu in thuArr)
                            {
                                <td class="cell-slot" data-day="@thu" data-time="@khungGio">
                                    @{
                                        var listLichCell = danhSachLich.Where(l =>
                                        {
                                            string thuCuaLich = l.NgayHoc.DayOfWeek switch
                                            {
                                                DayOfWeek.Monday => "Thứ 2",
                                                DayOfWeek.Tuesday => "Thứ 3",
                                                DayOfWeek.Wednesday => "Thứ 4",
                                                DayOfWeek.Thursday => "Thứ 5",
                                                DayOfWeek.Friday => "Thứ 6",
                                                DayOfWeek.Saturday => "Thứ 7",
                                                DayOfWeek.Sunday => "Chủ Nhật",
                                                _ => ""
                                            };
                                            bool matchThu = (thuCuaLich == thu);

                                            // Khớp chính xác giờ bắt đầu với ca học tương ứng
                                            bool matchGio = false;
                                            if (tenCa == "Ca Sáng") { matchGio = l.GioBatDau.Hours == 8; }
                                            else if (tenCa == "Ca Chiều") { matchGio = l.GioBatDau.Hours == 14; }
                                            else if (tenCa == "Ca Tối") { matchGio = l.GioBatDau.Hours >= 18; }

                                            return matchThu && matchGio;
                                        }).ToList();
                                    }

                                    @foreach (var item in listLichCell)
                                    {
                                        string roomName = item.PhongHoc?.TenPhong ?? "P.101";
                                        string className = item.LopHoc?.TenLop ?? "Lớp học";
                                        string teacherName = item.LopHoc?.GiaoVienPhuTrach?.HoTen ?? "Chưa phân công";
                                        string ghiChu = item.GhiChu ?? "Không có ghi chú";

                                        <div class="schedule-card p-2 rounded bg-primary-subtle border border-primary text-start small mb-1 shadow-sm"
                                             style="cursor: pointer;"
                                             data-id="@item.LichHocID"
                                             data-room="@roomName"
                                             data-classname="@className"
                                             data-teacher="@teacherName"
                                             data-date="@item.NgayHoc.ToString("dd/MM/yyyy")"
                                             data-time="@item.GioBatDau.ToString(@"hh\:mm") - @item.GioKetThuc.ToString(@"hh\:mm")"
                                             data-note="@ghiChu">
                                            <div class="fw-bold text-dark">@className</div>
                                            <div class="text-muted"><i class="fa-solid fa-chalkboard-user me-1"></i>GV: @teacherName</div>
                                            <span class="badge bg-success mt-1">@roomName</span>
                                        </div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Xếp Ca Học Mới -->
<div class="modal fade" id="modalSchedule" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-calendar-plus me-2 text-primary"></i>Xếp Lịch Học & Phân Phòng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formSchedule">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lớp Học <span class="text-danger">*</span></label>
                        <select class="form-select" id="schedClass" required>
                            @if (danhSachLop.Any())
                            {
                                foreach (var lop in danhSachLop)
                                {
                                    <option value="@lop.LopHocID" data-name="@lop.TenLop" data-teacher="@(lop.GiaoVienPhuTrach?.HoTen ?? "Chưa phân công")">
                                        @lop.TenLop (GV: @(lop.GiaoVienPhuTrach?.HoTen ?? "Chưa phân công"))
                                    </option>
                                }
                            }
                            else
                            {
                                <option value="0">-- Chưa có lớp học trong SQL --</option>
                            }
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Thứ Trong Tuần</label>
                            <select class="form-select" id="schedDay">
                                <option value="Thứ 2">Thứ 2</option>
                                <option value="Thứ 3">Thứ 3</option>
                                <option value="Thứ 4">Thứ 4</option>
                                <option value="Thứ 5">Thứ 5</option>
                                <option value="Thứ 6">Thứ 6</option>
                                <option value="Thứ 7">Thứ 7</option>
                                <option value="Chủ Nhật">Chủ Nhật</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Khung Giờ</label>
                            <select class="form-select" id="schedTime">
                                <option value="Ca sáng (08:00 - 10:00)">Ca Sáng (08:00 - 10:00)</option>
                                <option value="Ca chiều (14:00 - 16:00)">Ca Chiều (14:00 - 16:00)</option>
                                <option value="Ca tối (18:00 - 20:00)">Ca Tối (18:00 - 20:00)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phòng Học <span class="text-danger">*</span></label>
                        <select class="form-select" id="schedRoom" required>
                            @if (danhSachPhong.Any())
                            {
                                foreach (var p in danhSachPhong)
                                {
                                    <option value="@p.TenPhong">@p.TenPhong (@p.TrangThai)</option>
                                }
                            }
                            else
                            {
                                <option value="P.101">Phòng 101</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ghi Chú Ca Học</label>
                        <input type="text" class="form-control" id="schedNote" placeholder="VD: Buổi lý thuyết / thực hành..." />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveSchedule">
                    <i class="fa-solid fa-check me-1"></i> Lưu Vào CSDL
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Chi Tiết Lịch Học & Xóa -->
<div class="modal fade" id="modalDetailSchedule" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-primary"><i class="fa-solid fa-circle-info me-2"></i>Chi Tiết Ca Học</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="detailLichId" />
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-muted fw-semibold">Lớp Học:</span>
                        <span id="detailClassName" class="fw-bold text-dark">--</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-muted fw-semibold">Giảng Viên:</span>
                        <span id="detailTeacher" class="text-dark">--</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-muted fw-semibold">Ngày Học:</span>
                        <span id="detailDate" class="text-dark">--</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-muted fw-semibold">Khung Giờ:</span>
                        <span id="detailTime" class="text-dark">--</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-muted fw-semibold">Phòng Học:</span>
                        <span id="detailRoom" class="badge bg-success align-self-center">--</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-muted fw-semibold">Ghi Chú:</span>
                        <span id="detailNote" class="text-muted fst-italic">--</span>
                    </li>
                </ul>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button type="button" class="btn btn-outline-danger" id="btnDeleteSchedule">
                    <i class="fa-solid fa-trash me-1"></i> Xóa Lịch Học Này
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // 1. Chức năng tìm kiếm / lọc lịch học theo lớp trên bảng TKB
            $('#filterClass').change(function() {
                const selectedClass = $(this).val();

                $('.schedule-card').each(function() {
                    const cardClassName = $(this).data('classname');
                    if (selectedClass === "0" || cardClassName === selectedClass) {
                        $(this).show();
                        if (selectedClass !== "0") {
                            $(this).addClass('border-danger shadow'); // Làm nổi bật lớp được tìm
                        } else {
                            $(this).removeClass('border-danger shadow');
                        }
                    } else {
                        $(this).hide();
                    }
                });
            });

            // 2. Kích vào thẻ lịch học trên TKB -> Sổ ra Modal thông tin chi tiết
            $(document).on('click', '.schedule-card', function() {
                const id = $(this).data('id');
                const className = $(this).data('classname');
                const teacher = $(this).data('teacher');
                const date = $(this).data('date');
                const time = $(this).data('time');
                const room = $(this).data('room');
                const note = $(this).data('note');

                $('#detailLichId').val(id);
                $('#detailClassName').text(className);
                $('#detailTeacher').text(teacher);
                $('#detailDate').text(date);
                $('#detailTime').text(time);
                $('#detailRoom').text(room);
                $('#detailNote').text(note);

                $('#modalDetailSchedule').modal('show');
            });

            // 3. Xử lý nút Xóa lịch học từ Modal chi tiết
            $('#btnDeleteSchedule').click(function() {
                const lichId = $('#detailLichId').val();

                Swal.fire({
                    title: 'Xác nhận xóa lịch học?',
                    text: "Thao tác này sẽ xóa vĩnh viễn ca học khỏi cơ sở dữ liệu SQL Server!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/LichHoc/XoaLich',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ lichHocId: parseInt(lichId) }),
                            success: function(res) {
                                if (res.success) {
                                    $('#modalDetailSchedule').modal('hide');
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Đã xóa!',
                                        text: res.message,
                                        timer: 1500,
                                        showConfirmButton: false
                                    }).then(() => {
                                        location.reload();
                                    });
                                } else {
                                    Swal.fire('Lỗi', res.message, 'error');
                                }
                            },
                            error: function() {
                                Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ để xóa lịch học!', 'error');
                            }
                        });
                    }
                });
            });

            // 4. Xử lý thêm lịch mới và lưu xuống SQL
            $('#btnSaveSchedule').click(function() {
                const classOpt = $('#schedClass option:selected');
                const classId = parseInt($('#schedClass').val());
                const className = classOpt.data('name');
                const teacher = classOpt.data('teacher');
                const day = $('#schedDay').val();
                const time = $('#schedTime').val();
                const room = $('#schedRoom').val();
                const note = $('#schedNote').val();

                if (!classId || classId <= 0) {
                    Swal.fire('Cảnh báo', 'Vui lòng chọn lớp học hợp lệ!', 'warning');
                    return;
                }

                const payload = {
                    lopHocId: classId,
                    tenLop: className,
                    giangVien: teacher,
                    thuTrongTuan: day,
                    khungGio: time,
                    phongHoc: room,
                    ghiChu: note
                };

                $.ajax({
                    url: '/LichHoc/XepLich',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(res) {
                        if (res.success) {
                            $('#modalSchedule').modal('hide');
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công!',
                                text: res.message,
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Xung đột lịch', res.message, 'error');
                        }
                    },
                    error: function() {
                        Swal.fire('Lỗi', 'Không thể kết nối lưu lịch học xuống cơ sở dữ liệu!', 'error');
                    }
                });
            });
        });
    </script>
}