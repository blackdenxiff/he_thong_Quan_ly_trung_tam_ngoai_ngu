                            <div class="schedule-card p-2 rounded bg-primary-subtle border border-primary text-start small" 
                                 data-id="207" data-room="P.101" data-classname="TOEIC500-K01" 
                                 data-owner-id="1" data-owner="Trần Thị Giảng Viên" 
                                 data-actual-id="1" data-actual="Trần Thị Giảng Viên" 
                                 data-issub="false" style="cursor: pointer;">
                                <div class="fw-bold text-dark">TOEIC500-K01</div>
                                <div class="text-muted"><i class="fa-solid fa-chalkboard-user me-1"></i>GV: Trần Thị Giảng Viên</div>
                                <span class="badge bg-success mt-1">P.101</span>
                            </div>
                        </td>
                        <td class="cell-slot" data-day="Thứ 5" data-time="Ca tối (18:00 - 20:00)"></td>
                        <td class="cell-slot" data-day="Thứ 6" data-time="Ca tối (18:00 - 20:00)">
                            <div class="schedule-card p-2 rounded bg-primary-subtle border border-primary text-start small" 
                                 data-id="208" data-room="P.101" data-classname="TOEIC500-K01" 
                                 data-owner-id="1" data-owner="Trần Thị Giảng Viên" 
                                 data-actual-id="1" data-actual="Trần Thị Giảng Viên" 
                                 data-issub="false" style="cursor: pointer;">
                                <div class="fw-bold text-dark">TOEIC500-K01</div>
                                <div class="text-muted"><i class="fa-solid fa-chalkboard-user me-1"></i>GV: Trần Thị Giảng Viên</div>
                                <span class="badge bg-success mt-1">P.101</span>
                            </div>
                        </td>
                        <td class="cell-slot" data-day="Thứ 7" data-time="Ca tối (18:00 - 20:00)"></td>
                        <td class="cell-slot" data-day="Chủ Nhật" data-time="Ca tối (18:00 - 20:00)"></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal 1: Xếp Ca Học Mới -->
<div class="modal fade" id="modalSchedule" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-calendar-plus me-2 text-primary"></i>Xếp Lịch Học & Phân Phòng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formSchedule">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lớp Học <span class="text-danger">*</span></label>
                        <select class="form-select" id="schedClass" required>
                            <option value="1" data-name="TOEIC500-K01" data-teacher-id="1" data-teacher="Trần Thị Giảng Viên">TOEIC500-K01 (GV: Trần Thị Giảng Viên)</option>
                            <option value="2" data-name="IELTS6.5-K02" data-teacher-id="2" data-teacher="Nguyễn Quản Lý">IELTS6.5-K02 (GV: Nguyễn Quản Lý)</option>
                            <option value="3" data-name="GIAOTIEP-K01" data-teacher-id="3" data-teacher="Lê Văn Hướng Dẫn">GIAOTIEP-K01 (GV: Lê Văn Hướng Dẫn)</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Thứ Trong Tuần</label>
                            <select class="form-select" id="schedDay">
                                <option value="Thứ 2">Thứ 2</option>
                                <option value="Thứ 3">Thứ 3</option>
                                <option value="Thứ 4">Thứ 4</option>
                                <option value="Thứ 5">Thứ 5</option>
                                <option value="Thứ 6">Thứ 6</option>
                                <option value="Thứ 7">Thứ 7</option>
                                <option value="Chủ Nhật">Chủ Nhật</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Khung Giờ</label>
                            <select class="form-select" id="schedTime">
                                <option value="Ca sáng (08:00 - 10:00)">Ca Sáng (08:00 - 10:00)</option>
                                <option value="Ca chiều (14:00 - 16:00)">Ca Chiều (14:00 - 16:00)</option>
                                <option value="Ca tối (18:00 - 20:00)">Ca Tối (18:00 - 20:00)</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phòng Học <span class="text-danger">*</span></label>
                        <select class="form-select" id="schedRoom" required>
                            <option value="P.101">Phòng 101 (25 chỗ - Máy chiếu)</option>
                            <option value="P.102">Phòng 102 (30 chỗ - Phòng Lab)</option>
                            <option value="P.103">Phòng 103 (20 chỗ - Cơ bản)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ghi Chú Ca Học</label>
                        <input type="text" class="form-control" id="schedNote" placeholder="VD: Buổi thực hành phòng Lab nghe nói..." />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveSchedule">
                    <i class="fa-solid fa-check me-1"></i> Lưu Vào Thời Khóa Biểu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 2: Chỉnh Sửa Ca Học & Điều Động Dạy Thay (F13, RN02) -->
<div class="modal fade" id="modalEditSchedule" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Điều Chỉnh Ca Học & Phân Công</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formEditSchedule">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lớp Học</label>
                        <input type="text" class="form-control bg-light fw-bold" id="editClassName" readonly />
                    </div>

                    <!-- Khu vực phân công Dạy Thay (RN02) -->
                    <div class="p-3 bg-light rounded border mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold text-dark small"><i class="fa-solid fa-user-clock text-warning me-1"></i>PHÂN CÔNG DẠY THAY BUỔI NÀY:</span>
                            <span class="badge bg-secondary" id="badgeSubStatus">Chính thức</span>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">Giáo viên phụ trách gốc (Chủ nhiệm):</label>
                            <input type="text" class="form-control form-control-sm bg-white" id="editTeacherOwner" readonly />
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-1">Giảng viên đứng lớp thực tế buổi này:</label>
                            <select class="form-select form-select-sm" id="selectActualTeacher">
                                <option value="1" data-name="Trần Thị Giảng Viên">GV-001: Trần Thị Giảng Viên</option>
                                <option value="2" data-name="Nguyễn Quản Lý">GV-002: Nguyễn Quản Lý</option>
                                <option value="3" data-name="Lê Văn Hướng Dẫn">GV-003: Lê Văn Hướng Dẫn</option>
                            </select>
                            <small class="text-muted" style="font-size: 0.75rem;">Quy tắc RN02: Giáo viên phụ trách lớp không bị đổi khi có dạy thay, dữ liệu ghi nhận vào <code>PhanCongDay</code> để tính lương[cite: 4].</small>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Thứ Trong Tuần</label>
                            <select class="form-select" id="editDay">
                                <option value="Thứ 2">Thứ 2</option>
                                <option value="Thứ 3">Thứ 3</option>
                                <option value="Thứ 4">Thứ 4</option>
                                <option value="Thứ 5">Thứ 5</option>
                                <option value="Thứ 6">Thứ 6</option>
                                <option value="Thứ 7">Thứ 7</option>
                                <option value="Chủ Nhật">Chủ Nhật</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Khung Giờ</label>
                            <select class="form-select" id="editTime">
                                <option value="Ca sáng (08:00 - 10:00)">Ca Sáng (08:00 - 10:00)</option>
                                <option value="Ca chiều (14:00 - 16:00)">Ca Chiều (14:00 - 16:00)</option>
                                <option value="Ca tối (18:00 - 20:00)">Ca Tối (18:00 - 20:00)</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phòng Học <span class="text-danger">*</span></label>
                        <select class="form-select" id="editRoom" required>
                            <option value="P.101">Phòng 101 (25 chỗ - Máy chiếu)</option>
                            <option value="P.102">Phòng 102 (30 chỗ - Phòng Lab)</option>
                            <option value="P.103">Phòng 103 (20 chỗ - Cơ bản)</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button type="button" class="btn btn-outline-danger" id="btnDeleteSchedule">
                    <i class="fa-solid fa-trash me-1"></i> Hủy Ca Học
                </button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-primary" id="btnUpdateSchedule">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Cập Nhật
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let activeCard = null; // Thẻ ca học đang được click chọn

            // Nút chuyển tuần
            $('#btnPrevWeek, #btnNextWeek').click(function () {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'info',
                    title: 'Đang tải lịch tuần tiếp theo...',
                    showConfirmButton: false,
                    timer: 1000
                });
            });

            // 1. SỰ KIỆN CLICK VÀO THẺ CA HỌC
            $(document).on('click', '.schedule-card', function () {
                activeCard = $(this);
                const currentTd = activeCard.closest('td.cell-slot');
                const className = activeCard.data('classname');
                const room = activeCard.data('room');
                const day = currentTd.data('day');
                const time = currentTd.data('time');

                const ownerTeacher = activeCard.data('owner') || 'Trần Thị Giảng Viên';
                const actualId = activeCard.data('actual-id') || activeCard.data('owner-id') || 1;
                const isSub = activeCard.data('issub') === true || activeCard.data('issub') === 'true';

                // Nạp vào modal chỉnh sửa
                $('#editClassName').val(className);
                $('#editTeacherOwner').val(ownerTeacher);
                $('#selectActualTeacher').val(actualId);
                $('#editDay').val(day);
                $('#editTime').val(time);
                $('#editRoom').val(room);

                if (isSub) {
                    $('#badgeSubStatus').attr('class', 'badge bg-warning text-dark border').text('Có dạy thay');
                } else {
                    $('#badgeSubStatus').attr('class', 'badge bg-secondary').text('Chính thức');
                }

                $('#modalEditSchedule').modal('show');
            });

            // 2. CẬP NHẬT CA HỌC & PHÂN CÔNG DẠY THAY QUA AJAX (F12 & F13)
            $('#btnUpdateSchedule').click(function () {
                if (!activeCard) return;

                const newDay = $('#editDay').val();
                const newTime = $('#editTime').val();
                const newRoom = $('#editRoom').val();
                const className = $('#editClassName').val();
                const ownerName = $('#editTeacherOwner').val();
                const ownerId = parseInt(activeCard.data('owner-id')) || 1;

                const actualTeacherOpt = $('#selectActualTeacher option:selected');
                const actualId = parseInt($('#selectActualTeacher').val());
                const actualName = actualTeacherOpt.data('name');
                const isSubstitute = (actualId !== ownerId);

                const targetCell = $(`td.cell-slot[data-day="${newDay}"][data-time="${newTime}"]`);

                // Kiểm tra xung đột phòng học nếu đổi ô ca học
                let isConflict = false;
                let conflictClassName = "";
                targetCell.find('.schedule-card').each(function () {
                    if (!$(this).is(activeCard) &&$(this).data('room') === newRoom) {
                        isConflict = true;
                        conflictClassName = $(this).data('classname');
                        return false;
                    }
                });

                if (isConflict) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Xung đột phòng học!',
                        html: `Phòng <b>${newRoom}</b> vào <b>${newDay}</b> (${newTime}) đã có lớp <b>${conflictClassName}</b>!<br/>Vui lòng chọn phòng khác.`,
                        confirmButtonColor: '#ef4444'
                    });
                    return;
                }

                // Gửi AJAX phân công dạy thay (F13)
                const payloadSub = {
                    phanCongId: 0,
                    lichHocId: parseInt(activeCard.data('id')) || 1,
                    tenLop: className,
                    giaoVienPhuTrachId: ownerId,
                    tenGiaoVienPhuTrach: ownerName,
                    giaoVienThucTeId: actualId,
                    tenGiaoVienThucTe: actualName,
                    thuTrongTuan: newDay,
                    khungGio: newTime,
                    lyDoDayThay: isSubstitute ? 'Giáo viên phụ trách báo bận đột xuất' : '',
                    laDayThay: isSubstitute
                };

                $.ajax({
                    url: '/LichHoc/PhanCongDayThay',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payloadSub),
                    success: function (res) {
                        $('#modalEditSchedule').modal('hide');
                        Swal.fire('Thành công', res.message, 'success');

                        // Cập nhật thuộc tính của thẻ ca học
                        activeCard.data('room', newRoom);
                        activeCard.data('actual-id', actualId);
                        activeCard.data('actual', actualName);
                        activeCard.data('issub', isSubstitute);

                        // Cập nhật giao diện thẻ (hiển thị nhãn dạy thay nếu có)
                        if (isSubstitute) {
                            activeCard.attr('class', 'schedule-card p-2 rounded bg-warning-subtle border border-warning text-start small mt-1');
                            activeCard.html(`
                                <div class="fw-bold text-dark d-flex justify-content-between align-items-center">
                                    <span>${className}</span>
                                    <span class="badge bg-warning text-dark border">Dạy thay</span>
                                </div>
                                <div class="text-muted"><i class="fa-solid fa-chalkboard-user me-1"></i>Chính: ${ownerName}</div>
                                <div class="text-danger fw-semibold"><i class="fa-solid fa-user-tag me-1"></i>Đứng lớp: ${actualName}</div>
                                <span class="badge bg-primary mt-1">${newRoom}</span>
                            `);
                        } else {
                            activeCard.attr('class', 'schedule-card p-2 rounded bg-info-subtle border border-info text-start small mt-1');
                            activeCard.html(`
                                <div class="fw-bold text-dark">${className}</div>
                                <div class="text-muted"><i class="fa-solid fa-chalkboard-user me-1"></i>GV: ${ownerName}</div>
                                <span class="badge bg-primary mt-1">${newRoom}</span>
                            `);
                        }

                        // Di chuyển thẻ sang ô mới nếu có thay đổi Thứ / Ca
                        targetCell.append(activeCard);
                    }
                });
            });

            // 3. HỦY / XÓA CA HỌC
            $('#btnDeleteSchedule').click(function () {
                if (!activeCard) return;

                Swal.fire({
                    title: 'Hủy ca học này?',
                    text: 'Lịch học sẽ bị xóa khỏi thời khóa biểu tuần!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy'
                }).then((r) => {
                    if (r.isConfirmed) {
                        activeCard.fadeOut(250, function () {
                            $(this).remove();$('#modalEditSchedule').modal('hide');
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: 'Đã hủy ca học thành công',
                                showConfirmButton: false,
                                timer: 1500
                            });
                        });
                    }
                });
            });

            // 4. XẾP CA HỌC MỚI (F12)
            $('#btnSaveSchedule').click(function () {
                const classOpt = $('#schedClass option:selected');
                const classId = parseInt($('#schedClass').val());
                const className = classOpt.data('name');
                const teacherId = parseInt(classOpt.data('teacher-id')) || 1;
                const teacher = classOpt.data('teacher');

                const day = $('#schedDay').val();
                const time = $('#schedTime').val();
                const room = $('#schedRoom').val();
                const note = $('#schedNote').val();

                const targetCell = $(`td.cell-slot[data-day="${day}"][data-time="${time}"]`);

                // Kiểm tra trùng phòng
                let isConflict = false;
                let conflictClassName = "";
                targetCell.find('.schedule-card').each(function () {
                    if ($(this).data('room') === room) {
                        isConflict = true;
                        conflictClassName = $(this).data('classname');
                        return false;
                    }
                });

                if (isConflict) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Xung đột phòng học!',
                        html: `Phòng <b>${room}</b> vào <b>${day}</b> (${time}) đã được gán cho lớp <b>${conflictClassName}</b>!<br/>Vui lòng chọn phòng khác.`,
                        confirmButtonColor: '#ef4444'
                    });
                    return;
                }

                const randomId = Math.floor(Math.random() * 800) + 200;
                const newCard = `
                    <div class="schedule-card p-2 rounded bg-success-subtle border border-success text-start small mt-1" 
                         data-id="${randomId}" data-room="${room}" data-classname="${className}" 
                         data-owner-id="${teacherId}" data-owner="${teacher}" 
                         data-actual-id="${teacherId}" data-actual="${teacher}" 
                         data-issub="false" style="cursor: pointer;">
                        <div class="fw-bold text-dark">${className}</div>
                        <div class="text-muted"><i class="fa-solid fa-chalkboard-user me-1"></i>GV: ${teacher}</div>
                        <span class="badge bg-dark mt-1">${room}</span>
                    </div>
                `;

                targetCell.append(newCard);
                $('#modalSchedule').modal('hide');
                $('#formSchedule')[0].reset();
                Swal.fire('Thành công!', `Đã xếp lịch lớp ${className} vào phòng ${room}!`, 'success');
            });
        });
    </script>
}