@model IEnumerable<QuanLyTrungTamNgoaiNgu.Models.HoaDon>

@{
    ViewData["Title"] = "Quản lý Học phí & Hóa đơn";
    bool isHocVien = ViewBag.IsHocVien ?? false;

    // Tính toán thống kê dựa HOÀN TOÀN vào CSDL SQL
    decimal totalPayable = Model.Sum(h => h.TongPhaiTra);

    // Tổng đã thu = Tiền của các hóa đơn đã đánh dấu "Đã thu đủ" + Tiền thực tế đã thanh toán của các hóa đơn "Chưa đủ"
    decimal totalCollected = Model.Sum(h =>
        (h.TrangThai == "Đã thu đủ" || h.TrangThai == "Đã thanh toán")
        ? h.TongPhaiTra
        : (h.ThanhToans != null ? h.ThanhToans.Sum(t => t.SoTien) : 0));

    decimal totalRemaining = totalPayable - totalCollected;

    // Đếm chính xác theo cột TrangThai
    int unpaidCount = Model.Count(h => h.TrangThai != "Đã thu đủ" && h.TrangThai != "Đã thanh toán");
}

<!-- Tiêu đề trang và Nút Lập Hóa Đơn Mới (Chỉ hiện nút cho Admin / Nhân viên) -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 text-dark fw-bold">
            @(isHocVien ? "Thông Tin Hóa Đơn & Học Phí Của Tôi" : "Quản Lý Học Phí & Hóa Đơn")
        </h4>
        <p class="text-muted small mb-0">
            @(isHocVien ? "Theo dõi lịch sử giao dịch thanh toán và số tiền học phí còn phải đóng" : "Theo dõi công nợ, xuất hóa đơn đào tạo và ghi nhận các đợt thanh toán")
        </p>
    </div>
    @if (!isHocVien)
    {
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalInvoice">
            <i class="fa-solid fa-file-invoice-dollar me-1"></i> Lập Hóa Đơn Mới
        </button>
    }
</div>

<!-- 4 Thẻ thống kê tài chính thời gian thực -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-muted small fw-semibold">@(isHocVien ? "TỔNG HỌC PHÍ PHẢI NỘP" : "TỔNG PHẢI THU")</span>
            <h4 class="fw-bold mb-0 text-dark" id="statTotalPayable">@totalPayable.ToString("N0") đ</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-success small fw-semibold">@(isHocVien ? "ĐÃ THANH TOÁN" : "ĐÃ THU")</span>
            <h4 class="fw-bold mb-0 text-success" id="statTotalCollected">@totalCollected.ToString("N0") đ</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-danger small fw-semibold">@(isHocVien ? "SỐ TIỀN CÒN PHẢI ĐÓNG" : "CÔNG NỢ CÒN LẠI")</span>
            <h4 class="fw-bold mb-0 text-danger" id="statRemainingDebt">@totalRemaining.ToString("N0") đ</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-warning small fw-semibold">@(isHocVien ? "HÓA ĐƠN CHƯA THANH TOÁN" : "HÓA ĐƠN CHƯA THU ĐỦ")</span>
            <h4 class="fw-bold mb-0 text-warning" id="statUnpaidCount">@unpaidCount</h4>
        </div>
    </div>
</div>

<!-- Khung Bộ lọc tìm kiếm Hóa đơn -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="searchInvoice" placeholder="Tìm theo mã HĐ, tên học viên, SĐT..." />
                </div>
            </div>
            <div class="col-md-4">
                <select class="form-select" id="filterInvoiceStatus">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Chưa đủ">Chưa đủ</option>
                    <option value="Đã thu đủ">Đã thu đủ</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="button" class="btn btn-secondary w-100" id="btnFilterInv">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <button type="button" class="btn btn-outline-secondary" id="btnResetInvFilter" title="Đặt lại">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bảng dữ liệu Hóa đơn -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3">MÃ HĐ</th>
                        <th>HỌC VIÊN</th>
                        <th>KHOẢN THU (LỚP HỌC)</th>
                        <th>NGÀY LẬP</th>
                        <th>TỔNG TIỀN</th>
                        <th>GIẢM GIÁ</th>
                        <th>PHẢI THU</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end pe-3">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody id="invoiceTableBody">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            bool isCompleted = (item.TrangThai == "Đã thu đủ" || item.TrangThai == "Đã thanh toán");

                            decimal daThu = 0;
                            if (isCompleted)
                            {
                                daThu = item.TongPhaiTra;
                            }
                            else
                            {
                                daThu = item.ThanhToans != null ? item.ThanhToans.Sum(t => t.SoTien) : 0;
                            }

                            decimal conLai = item.TongPhaiTra - daThu;
                            if (conLai < 0) conLai = 0;

                            <tr id="row_inv_@item.HoaDonID"
                                data-invoice-id="@item.HoaDonID"
                                data-student-name="@(item.HocVien?.HoTen ?? "Khách lẻ")"
                                data-class-name="Khóa học đào tạo"
                                data-total="@item.TongTien"
                                data-discount="@item.GiamGia"
                                data-payable="@item.TongPhaiTra"
                                data-paid="@daThu"
                                data-remaining="@conLai">

                                <td class="ps-3"><span class="badge bg-light text-dark border fw-bold">HD-@item.HoaDonID</span></td>
                                <td>
                                    <div class="fw-bold text-dark">@(item.HocVien?.HoTen ?? "N/A")</div>
                                    <small class="text-muted">HV-@(item.HocVienID) • @(item.HocVien?.SoDienThoai ?? "")</small>
                                </td>
                                <td>
                                    <span class="fw-semibold text-primary">Khóa học ngoại ngữ</span>
                                    <div class="small text-muted">@(item.GhiChu ?? "Học phí chuẩn đầu ra")</div>
                                </td>
                                <td><small class="text-muted">@item.NgayLap.ToString("dd/MM/yyyy")</small></td>
                                <td>@item.TongTien.ToString("N0") đ</td>
                                <td class="text-danger">-@item.GiamGia.ToString("N0") đ</td>
                                <td class="fw-bold text-dark">@item.TongPhaiTra.ToString("N0") đ</td>
                                <td class="status-cell">
                                    @if (isCompleted)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle status-badge">Đã thu đủ</span>
                                        <div class="small text-muted paid-text">Đã thu: @daThu.ToString("N0") đ</div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle status-badge">Chưa đủ</span>
                                        <div class="small text-muted paid-text">Đã thu: @daThu.ToString("N0") đ</div>
                                    }
                                </td>
                                <td class="text-end pe-3 action-cell">
                                    @if (!isHocVien && !isCompleted)
                                    {
                                        <button class="btn btn-sm btn-outline-success me-1 btn-pay" title="Thu tiền" onclick="openPaymentModal(this)">
                                            <i class="fa-solid fa-hand-holding-dollar"></i>
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-secondary" title="Xem chi tiết & In phiếu" onclick="printInvoice(this)">
                                        <i class="fa-solid fa-print"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                @(isHocVien ? "Bạn chưa có dữ liệu hóa đơn hoặc lịch sử giao dịch học phí nào." : "Không có dữ liệu hóa đơn nào trong hệ thống.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
        <small class="text-muted">Hiển thị <span id="displayCount">@(Model?.Count() ?? 0)</span> hóa đơn</small>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item disabled"><a class="page-link" href="#">Trước</a></li>
            <li class="page-item active"><a class="page-link" href="#">1</a></li>
            <li class="page-item disabled"><a class="page-link" href="#">Sau</a></li>
        </ul>
    </div>
</div>

<!-- Modal 1: Lập Hóa Đơn Mới (Chỉ dành cho Admin / Nhân viên) -->
@if (!isHocVien)
{
    <div class="modal fade" id="modalInvoice" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-file-invoice-dollar me-2 text-primary"></i>Phát Hành Hóa Đơn Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="formNewInvoice">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Chọn Học Viên <span class="text-danger">*</span></label>
                                <select class="form-select" id="selectStudent" required>
                                    <option value="">-- Chọn học viên cần lập hóa đơn --</option>
                                    @if (ViewBag.DanhSachHocVien != null)
                                    {
                                        foreach (var hv in ViewBag.DanhSachHocVien as List<QuanLyTrungTamNgoaiNgu.Models.HocVien>)
                                        {
                                            <option value="@hv.HocVienID" data-name="@hv.HoTen" data-class="Khóa học ngoại ngữ chuẩn" data-fee="4500000">
                                                HV-0@(hv.HocVienID): @hv.HoTen (@hv.SoDienThoai)
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Khoản Thu / Lớp Đào Tạo</label>
                                <input type="text" class="form-control bg-light" id="txtClassName" readonly placeholder="Chọn học viên để nạp tự động..." />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Tổng Tiền Niêm Yết (VNĐ)</label>
                                <input type="number" class="form-control fw-bold bg-light" id="txtTotalFee" value="0" readonly />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Giảm Giá / Học Bổng (VNĐ)</label>
                                <input type="number" class="form-control" id="txtDiscount" value="0" min="0" step="50000" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Tổng Phải Thu Thực Tế (VNĐ)</label>
                                <input type="number" class="form-control fw-bold text-primary bg-light" id="txtFinalAmount" value="0" readonly />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Ghi Chú Hóa Đơn</label>
                                <input type="text" class="form-control" id="txtInvoiceNote" placeholder="VD: Khuyến mãi đăng ký sớm..." />
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-primary" id="btnSaveInvoice">
                        <i class="fa-solid fa-check me-1"></i> Xác Nhận Xuất Hóa Đơn
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal 2: Ghi Nhận Thu Tiền -->
    <div class="modal fade" id="modalPayment" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-hand-holding-dollar me-2 text-success"></i>Ghi Nhận Thanh Toán</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="formPayment">
                        <input type="hidden" id="payInvoiceId" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Học viên nộp tiền:</label>
                            <input type="text" class="form-control bg-light fw-bold" id="payStudentName" readonly />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Số tiền công nợ còn lại (VNĐ):</label>
                            <input type="text" class="form-control bg-light fw-bold text-danger" id="payRemainingDisplay" readonly />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Số tiền thu đợt này <span class="text-danger">*</span></label>
                            <input type="number" class="form-control fw-bold text-success fs-5" id="payAmountInput" min="10000" step="50000" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Phương thức giao dịch</label>
                            <select class="form-select" id="payMethodSelect">
                                <option value="Chuyển khoản QR">Chuyển khoản ngân hàng (QR)</option>
                                <option value="Tiền mặt">Tiền mặt tại quầy</option>
                                <option value="Quẹt thẻ POS">Thẻ POS / Visa</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ghi chú phiếu thu</label>
                            <input type="text" class="form-control" id="payNoteInput" placeholder="VD: Mã giao dịch..." />
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-success" id="btnConfirmPayment">
                        <i class="fa-solid fa-receipt me-1"></i> Xác Nhận Thu Tiền
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Xem Chi Tiết & In Phiếu Thu (Dùng chung cho cả Học viên và Admin) -->
<div class="modal fade" id="modalPrintReceipt" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body p-4" id="printArea">
                <div class="text-center mb-3">
                    <h5 class="fw-bold mb-0 text-primary">TRUNG TÂM ANH NGỮ ENGLISH CENTER</h5>
                    <p class="small text-muted mb-1">Cơ sở Cầu Giấy: 123 Đường Cầu Giấy, Hà Nội - Hotline: 0900000001</p>
                    <h4 class="fw-bold text-dark mt-3">PHIẾU THU HỌC PHÍ</h4>
                    <span class="badge bg-light text-dark border" id="printReceiptCode">HD-001</span>
                </div>
                <hr />
                <table class="table table-borderless table-sm small mb-3">
                    <tbody>
                        <tr><td><strong>Học viên:</strong></td><td id="printStudent">--</td></tr>
                        <tr><td><strong>Lớp học:</strong></td><td id="printClass">Khóa học đào tạo</td></tr>
                        <tr><td><strong>Học phí:</strong></td><td id="printTotal">0 đ</td></tr>
                        <tr><td><strong>Giảm trừ:</strong></td><td id="printDiscount" class="text-danger">0 đ</td></tr>
                        <tr class="border-top"><td><strong>Phải nộp:</strong></td><td id="printPayable" class="fw-bold text-primary">0 đ</td></tr>
                        <tr><td><strong>Đã thanh toán:</strong></td><td id="printPaid" class="fw-bold text-success">0 đ</td></tr>
                        <tr><td><strong>Còn lại:</strong></td><td id="printRemain" class="fw-bold text-danger">0 đ</td></tr>
                    </tbody>
                </table>
                <div class="d-flex justify-content-between text-center mt-4 small">
                    <div>
                        <p class="mb-5"><strong>Người nộp tiền</strong><br /><em>(Ký, ghi rõ họ tên)</em></p>
                    </div>
                    <div>
                        <p class="mb-5"><strong>Người lập phiếu</strong><br /><em>(Ký, đóng dấu)</em></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="window.print()">
                    <i class="fa-solid fa-print me-1"></i> In Ngay
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            let activeInvoiceRow = null;
            const isHocVien = @(isHocVien ? "true" : "false");

            if (!isHocVien) {
                // 1. Tự động nạp lớp & học phí khi chọn học viên
                $('#selectStudent').change(function() {
                    const opt = $(this).find(':selected');
                    const className = opt.data('class') || '';
                    const fee = parseFloat(opt.data('fee')) || 0;

                    $('#txtClassName').val(className);
                    $('#txtTotalFee').val(fee);
                    calculateInvoice();
                });

                $('#txtDiscount').on('input', function() {
                    calculateInvoice();
                });

                function calculateInvoice() {
                    const total = parseFloat($('#txtTotalFee').val()) || 0;
                    let discount = parseFloat($('#txtDiscount').val()) || 0;

                    if (discount < 0) {
                        discount = 0;
                        $('#txtDiscount').val(0);
                    }
                    if (discount > total) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Giảm giá không hợp lệ',
                            text: 'Số tiền giảm giá không được lớn hơn tổng học phí!'
                        });
                        discount = total;
                        $('#txtDiscount').val(total);
                    }

                    const finalAmt = total - discount;
                    $('#txtFinalAmount').val(finalAmt);
                }

                // Lập Hóa Đơn mới
                $('#btnSaveInvoice').click(function() {
                    const studentId = $('#selectStudent').val();
                    const total = parseFloat($('#txtTotalFee').val()) || 0;
                    const discount = parseFloat($('#txtDiscount').val()) || 0;

                    if (!studentId) {
                        Swal.fire('Thiếu thông tin', 'Vui lòng chọn học viên cần lập hóa đơn!', 'warning');
                        return;
                    }

                    const payload = {
                        hocVienId: parseInt(studentId),
                        dangKyId: null,
                        tongTien: total,
                        giamGia: discount,
                        ghiChu: $('#txtInvoiceNote').val()
                    };

                    $.ajax({
                        url: '/HoaDon/LapHoaDon',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(payload),
                        success: function(res) {
                            if (res.success) {
                                $('#modalInvoice').modal('hide');
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công!',
                                    text: res.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Lỗi', res.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Lỗi kết nối', 'Không thể gửi dữ liệu đến server', 'error');
                        }
                    });
                });

                // Mở Modal Thu tiền
                window.openPaymentModal = function(btnElement) {
                    activeInvoiceRow = $(btnElement).closest("tr");
                    const invId = activeInvoiceRow.data("invoice-id");
                    const studentName = activeInvoiceRow.data("student-name");

                    const payable = parseFloat(String(activeInvoiceRow.data("payable")).replace(/,/g, '')) || 0;
                    const paid = parseFloat(String(activeInvoiceRow.data("paid")).replace(/,/g, '')) || 0;

                    let remaining = payable - paid;
                    if (remaining < 0) remaining = 0;

                    $('#payInvoiceId').val(invId);
                    $('#payStudentName').val(studentName);
                    $('#payRemainingDisplay').val(remaining.toLocaleString('vi-VN') + ' đ');
                    $('#payAmountInput').val(remaining > 0 ? remaining : 0).attr('max', remaining > 0 ? remaining : null);

                    $('#modalPayment').modal('show');
                };

                // Xác nhận thanh toán
                $('#btnConfirmPayment').click(function() {
                    const invId = parseInt($('#payInvoiceId').val());
                    const payAmt = parseFloat($('#payAmountInput').val()) || 0;

                    const payable = parseFloat(String(activeInvoiceRow.data("payable")).replace(/,/g, '')) || 0;
                    const paid = parseFloat(String(activeInvoiceRow.data("paid")).replace(/,/g, '')) || 0;
                    let remaining = payable - paid;
                    if (remaining < 0) remaining = 0;

                    if (payAmt <= 0) {
                        Swal.fire('Lỗi số tiền', 'Vui lòng nhập số tiền thanh toán lớn hơn 0!', 'warning');
                        return;
                    }
                    if (payAmt > remaining) {
                        Swal.fire('Cảnh báo', 'Số tiền thu không được lớn hơn công nợ còn lại!', 'warning');
                        return;
                    }

                    const payload = {
                        hoaDonId: invId,
                        soTien: payAmt,
                        phuongThuc: $('#payMethodSelect').val(),
                        ghiChu: $('#payNoteInput').val()
                    };

                    $.ajax({
                        url: '/HoaDon/ThuTien',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(payload),
                        success: function(res) {
                            $('#modalPayment').modal('hide');
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Đã thu tiền!',
                                    text: res.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Lỗi', res.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Lỗi kết nối', 'Không thể lưu thanh toán', 'error');
                        }
                    });
                });
            }

            // Popup In/Xem Hóa đơn (Dùng chung)
            window.printInvoice = function(btnElement) {
                const tr = $(btnElement).closest("tr");
                $('#printReceiptCode').text('HD-' + tr.data("invoice-id"));
                $('#printStudent').text(tr.data("student-name"));
                $('#printClass').text(tr.data("class-name"));
                $('#printTotal').text(parseFloat(tr.data("total")).toLocaleString() + ' đ');
                $('#printDiscount').text('-' + parseFloat(tr.data("discount")).toLocaleString() + ' đ');
                $('#printPayable').text(parseFloat(tr.data("payable")).toLocaleString() + ' đ');
                $('#printPaid').text(parseFloat(tr.data("paid")).toLocaleString() + ' đ');
                $('#printRemain').text(parseFloat(tr.data("remaining")).toLocaleString() + ' đ');

                $('#modalPrintReceipt').modal('show');
            };

            // Bộ lọc tìm kiếm
            $('#btnFilterInv').click(function() {
                const kw = $('#searchInvoice').val().toLowerCase().trim();
                const status = $('#filterInvoiceStatus').val();

                $('#invoiceTableBody tr').each(function() {
                    const rowText = $(this).text().toLowerCase();
                    const rowStatus = $(this).find('.status-badge').text().trim();

                    const matchKw = kw === '' || rowText.includes(kw);
                    const matchStatus = status === '' || rowStatus === status;

                    $(this).toggle(matchKw && matchStatus);
                });
            });

            $('#btnResetInvFilter').click(function() {
                $('#searchInvoice').val('');
                $('#filterInvoiceStatus').val('');
                $('#invoiceTableBody tr').show();
            });
        });
    </script>
}