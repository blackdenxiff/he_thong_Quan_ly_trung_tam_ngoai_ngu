@{
    ViewData["Title"] = "Quản lý Học phí & Hóa đơn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 text-dark fw-bold">Quản Lý Học Phí & Hóa Đơn</h4>
        <p class="text-muted small mb-0">Theo dõi công nợ, xuất hóa đơn đào tạo và ghi nhận các đợt thanh toán</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalInvoice">
        <i class="fa-solid fa-file-invoice-dollar me-1"></i> Lập Hóa Đơn Mới
    </button>
</div>

<!-- 4 Thẻ thống kê tài chính thời gian thực -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-muted small fw-semibold">TỔNG PHẢI THU</span>
            <h4 class="fw-bold mb-0 text-dark" id="statTotalPayable">8,500,000 đ</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-success small fw-semibold">ĐÃ THU</span>
            <h4 class="fw-bold mb-0 text-success" id="statTotalCollected">6,500,000 đ</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-danger small fw-semibold">CÔNG NỢ CÒN LẠI</span>
            <h4 class="fw-bold mb-0 text-danger" id="statRemainingDebt">2,000,000 đ</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-warning small fw-semibold">HÓA ĐƠN CHƯA THU ĐỦ</span>
            <h4 class="fw-bold mb-0 text-warning" id="statUnpaidCount">1</h4>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm Hóa đơn -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control" id="searchInvoice" placeholder="Tìm theo mã HĐ, tên học viên, SĐT..." />
                </div>
            </div>
            <div class="col-md-4">
                <select class="form-select" id="filterInvoiceStatus">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Chưa đủ">Chưa đủ</option>
                    <option value="Đã thu đủ">Đã thu đủ</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="button" class="btn btn-secondary w-100" id="btnFilterInv">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <button type="button" class="btn btn-outline-secondary" id="btnResetInvFilter" title="Đặt lại">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bảng dữ liệu Hóa đơn (Table) -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3">MÃ HĐ</th>
                        <th>HỌC VIÊN</th>
                        <th>KHOẢN THU (LỚP HỌC)</th>
                        <th>NGÀY LẬP</th>
                        <th>TỔNG TIỀN</th>
                        <th>GIẢM GIÁ</th>
                        <th>PHẢI THU</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end pe-3">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody id="invoiceTableBody">
                    <!-- Hóa đơn 1: Chưa thu đủ (Khớp với dữ liệu mẫu CSDL) -->
                    <tr id="row_inv_1" data-invoice-id="1" data-student-name="Lê Văn Học Viên" data-class-name="TOEIC500-K01" data-total="4500000" data-discount="500000" data-payable="4000000" data-paid="2000000" data-remaining="2000000">
                        <td class="ps-3"><span class="badge bg-light text-dark border fw-bold">HD-001</span></td>
                        <td>
                            <div class="fw-bold text-dark">Lê Văn Học Viên</div>
                            <small class="text-muted">HV-001 • 0900000003</small>
                        </td>
                        <td>
                            <span class="fw-semibold text-primary">TOEIC500-K01</span>
                            <div class="small text-muted">Học phí chuẩn đầu ra</div>
                        </td>
                        <td><small class="text-muted">01/10/2026</small></td>
                        <td>4,500,000 đ</td>
                        <td class="text-danger">-500,000 đ</td>
                        <td class="fw-bold text-dark">4,000,000 đ</td>
                        <td class="status-cell">
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle status-badge">Chưa đủ</span>
                            <div class="small text-muted paid-text">Đã thu: 2,000,000 đ</div>
                        </td>
                        <td class="text-end pe-3 action-cell">
                            <button class="btn btn-sm btn-outline-success me-1 btn-pay" title="Thu tiền lần 2" onclick="openPaymentModal(this)">
                                <i class="fa-solid fa-hand-holding-dollar"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" title="In hóa đơn" onclick="printInvoice(this)">
                                <i class="fa-solid fa-print"></i>
                            </button>
                        </td>
                    </tr>
                    <!-- Hóa đơn 2: Đã thu đủ -->
                    <tr id="row_inv_2" data-invoice-id="2" data-student-name="Trần Thị Mai Phương" data-class-name="TOEIC500-K01" data-total="4500000" data-discount="0" data-payable="4500000" data-paid="4500000" data-remaining="0">
                        <td class="ps-3"><span class="badge bg-light text-dark border fw-bold">HD-002</span></td>
                        <td>
                            <div class="fw-bold text-dark">Trần Thị Mai Phương</div>
                            <small class="text-muted">HV-002 • 0900000012</small>
                        </td>
                        <td>
                            <span class="fw-semibold text-primary">TOEIC500-K01</span>
                            <div class="small text-muted">Học phí chuẩn đầu ra</div>
                        </td>
                        <td><small class="text-muted">02/10/2026</small></td>
                        <td>4,500,000 đ</td>
                        <td class="text-muted">0 đ</td>
                        <td class="fw-bold text-dark">4,500,000 đ</td>
                        <td class="status-cell">
                            <span class="badge bg-success-subtle text-success border border-success-subtle status-badge">Đã thu đủ</span>
                            <div class="small text-muted paid-text">Đã thu: 4,500,000 đ</div>
                        </td>
                        <td class="text-end pe-3 action-cell">
                            <button class="btn btn-sm btn-outline-secondary" title="In hóa đơn" onclick="printInvoice(this)">
                                <i class="fa-solid fa-print"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
        <small class="text-muted">Hiển thị <span id="displayCount">2</span> hóa đơn trong hệ thống</small>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item disabled"><a class="page-link" href="#">Trước</a></li>
            <li class="page-item active"><a class="page-link" href="#">1</a></li>
            <li class="page-item disabled"><a class="page-link" href="#">Sau</a></li>
        </ul>
    </div>
</div>

<!-- Modal 1: Lập Hóa Đơn Mới (Client-side Validation & Calculation) -->
<div class="modal fade" id="modalInvoice" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-file-invoice-dollar me-2 text-primary"></i>Phát Hành Hóa Đơn Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formNewInvoice">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Chọn Học Viên <span class="text-danger">*</span></label>
                            <select class="form-select" id="selectStudent" required>
                                <option value="">-- Chọn học viên cần lập hóa đơn --</option>
                                <option value="1" data-name="Lê Văn Học Viên" data-class="TOEIC500-K01" data-fee="4500000">HV-001: Lê Văn Học Viên (Lớp: TOEIC500-K01)</option>
                                <option value="2" data-name="Trần Thị Mai Phương" data-class="TOEIC500-K01" data-fee="4500000">HV-002: Trần Thị Mai Phương (Lớp: TOEIC500-K01)</option>
                                <option value="3" data-name="Nguyễn Hữu Nam" data-class="IELTS6.5-K02" data-fee="7500000">HV-003: Nguyễn Hữu Nam (Lớp: IELTS6.5-K02)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Khoản Thu / Lớp Đào Tạo</label>
                            <input type="text" class="form-control bg-light" id="txtClassName" readonly placeholder="Chọn học viên để nạp tự động..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Tổng Tiền Niêm Yết (VNĐ)</label>
                            <input type="number" class="form-control fw-bold bg-light" id="txtTotalFee" value="0" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Giảm Giá / Học Bổng (VNĐ)</label>
                            <input type="number" class="form-control" id="txtDiscount" value="0" min="0" step="50000" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Tổng Phải Thu Thực Tế (VNĐ)</label>
                            <input type="number" class="form-control fw-bold text-primary bg-light" id="txtFinalAmount" value="0" readonly />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Ghi Chú Hóa Đơn</label>
                            <input type="text" class="form-control" id="txtInvoiceNote" placeholder="VD: Khuyến mãi đăng ký sớm trước ngày 01/10..." />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveInvoice">
                    <i class="fa-solid fa-check me-1"></i> Xác Nhận Xuất Hóa Đơn
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 2: Ghi Nhận Thu Tiền / Thanh Toán (ThanhToan) -->
<div class="modal fade" id="modalPayment" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-hand-holding-dollar me-2 text-success"></i>Ghi Nhận Thanh Toán</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formPayment">
                    <input type="hidden" id="payInvoiceId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Học viên nộp tiền:</label>
                        <input type="text" class="form-control bg-light fw-bold" id="payStudentName" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số tiền công nợ còn lại (VNĐ):</label>
                        <input type="text" class="form-control bg-light fw-bold text-danger" id="payRemainingDisplay" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số tiền thu đợt này <span class="text-danger">*</span></label>
                        <input type="number" class="form-control fw-bold text-success fs-5" id="payAmountInput" min="10000" step="50000" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phương thức giao dịch</label>
                        <select class="form-select" id="payMethodSelect">
                            <option value="Chuyển khoản QR">Chuyển khoản ngân hàng (QR)</option>
                            <option value="Tiền mặt">Tiền mặt tại quầy</option>
                            <option value="Quẹt thẻ POS">Thẻ POS / Visa</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ghi chú phiếu thu</label>
                        <input type="text" class="form-control" id="payNoteInput" placeholder="VD: Giao dịch qua VCB, mã GD 9928..." />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success" id="btnConfirmPayment">
                    <i class="fa-solid fa-receipt me-1"></i> Xác Nhận Thu Tiền
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Ẩn để In Phiếu Thu (Print Preview) -->
<div class="modal fade" id="modalPrintReceipt" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body p-4" id="printArea">
                <div class="text-center mb-3">
                    <h5 class="fw-bold mb-0 text-primary">TRUNG TÂM ANH NGỮ ENGLISH CENTER</h5>
                    <p class="small text-muted mb-1">Cơ sở Cầu Giấy: 123 Đường Cầu Giấy, Hà Nội - Hotline: 0900000001</p>
                    <h4 class="fw-bold text-dark mt-3">PHIẾU THU HỌC PHÍ</h4>
                    <span class="badge bg-light text-dark border" id="printReceiptCode">HD-001</span>
                </div>
                <hr />
                <table class="table table-borderless table-sm small mb-3">
                    <tbody>
                        <tr><td><strong>Học viên:</strong></td><td id="printStudent">Lê Văn Học Viên</td></tr>
                        <tr><td><strong>Lớp học:</strong></td><td id="printClass">TOEIC500-K01</td></tr>
                        <tr><td><strong>Ngày lập:</strong></td><td id="printDate">07/10/2026</td></tr>
                        <tr><td><strong>Học phí:</strong></td><td id="printTotal">4,500,000 đ</td></tr>
                        <tr><td><strong>Giảm trừ:</strong></td><td id="printDiscount" class="text-danger">0 đ</td></tr>
                        <tr class="border-top"><td><strong>Phải nộp:</strong></td><td id="printPayable" class="fw-bold text-primary">4,500,000 đ</td></tr>
                        <tr><td><strong>Đã thanh toán:</strong></td><td id="printPaid" class="fw-bold text-success">4,500,000 đ</td></tr>
                        <tr><td><strong>Còn lại:</strong></td><td id="printRemain" class="fw-bold text-danger">0 đ</td></tr>
                    </tbody>
                </table>
                <div class="d-flex justify-content-between text-center mt-4 small">
                    <div>
                        <p class="mb-5"><strong>Người nộp tiền</strong><br /><em>(Ký, ghi rõ họ tên)</em></p>
                    </div>
                    <div>
                        <p class="mb-5"><strong>Người lập phiếu</strong><br /><em>(Ký, đóng dấu)</em></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="window.print()">
                    <i class="fa-solid fa-print me-1"></i> In Ngay
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let activeInvoiceRow = null;

            // 1. Tự động nạp lớp & học phí khi chọn học viên trong Modal Lập Hóa Đơn
            $('#selectStudent').change(function () {
                const opt = $(this).find(':selected');
                const className = opt.data('class') || '';
                const fee = parseFloat(opt.data('fee')) || 0;

                $('#txtClassName').val(className);
                $('#txtTotalFee').val(fee);
                calculateInvoice();
            });

            // 2. Client-side Validation: Kiểm soát giảm giá và tính toán số tiền thực thu
            $('#txtDiscount').on('input', function () {
                calculateInvoice();
            });

            function calculateInvoice() {
                const total = parseFloat($('#txtTotalFee').val()) || 0;
                let discount = parseFloat($('#txtDiscount').val()) || 0;

                if (discount < 0) {
                    discount = 0;
                    $('#txtDiscount').val(0);
                }
                if (discount > total) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Giảm giá không hợp lệ',
                        text: 'Số tiền giảm giá không được lớn hơn tổng học phí!'
                    });
                    discount = total;
                    $('#txtDiscount').val(total);
                }

                const finalAmt = total - discount;
                $('#txtFinalAmount').val(finalAmt);
            }

            // 3. Xử lý Lập Hóa Đơn mới qua AJAX & Render DOM ngay lập tức
            $('#btnSaveInvoice').click(function () {
                const studentId = $('#selectStudent').val();
                const total = parseFloat($('#txtTotalFee').val()) || 0;
                const discount = parseFloat($('#txtDiscount').val()) || 0;
                const finalAmt = parseFloat($('#txtFinalAmount').val()) || 0;
                const studentName = $('#selectStudent option:selected').data('name');
                const className = $('#txtClassName').val();

                if (!studentId) {
                    Swal.fire('Thiếu thông tin', 'Vui lòng chọn học viên cần lập hóa đơn!', 'warning');
                    return;
                }

                const payload = {
                    hocVienId: parseInt(studentId),
                    dangKyId: 1,
                    tongTien: total,
                    giamGia: discount,
                    ghiChu: $('#txtInvoiceNote').val()
                };

                $.ajax({
                    url: '/HoaDon/LapHoaDon',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            $('#modalInvoice').modal('hide');
                            Swal.fire('Thành công!', res.message, 'success');

                            const randomId = Math.floor(Math.random() * 900) + 100;
                            const newTr = `
                                <tr id="row_inv_${randomId}" data-invoice-id="${randomId}" data-student-name="${studentName}" data-class-name="${className}" data-total="${total}" data-discount="${discount}" data-payable="${finalAmt}" data-paid="0" data-remaining="${finalAmt}">
                                    <td class="ps-3"><span class="badge bg-light text-dark border fw-bold">HD-${randomId}</span></td>
                                    <td>
                                        <div class="fw-bold text-dark">${studentName}</div>
                                        <small class="text-muted">HV-${studentId}</small>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-primary">${className}</span>
                                        <div class="small text-muted">Học phí chuẩn đầu ra</div>
                                    </td>
                                    <td><small class="text-muted">07/10/2026</small></td>
                                    <td>${total.toLocaleString()} đ</td>
                                    <td class="text-danger">-${discount.toLocaleString()} đ</td>
                                    <td class="fw-bold text-dark">${finalAmt.toLocaleString()} đ</td>
                                    <td class="status-cell">
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle status-badge">Chưa thu</span>
                                        <div class="small text-muted paid-text">Đã thu: 0 đ</div>
                                    </td>
                                    <td class="text-end pe-3 action-cell">
                                        <button class="btn btn-sm btn-outline-success me-1 btn-pay" title="Thu tiền" onclick="openPaymentModal(this)">
                                            <i class="fa-solid fa-hand-holding-dollar"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" title="In hóa đơn" onclick="printInvoice(this)">
                                            <i class="fa-solid fa-print"></i>
                                        </button>
                                    </td>
                                </tr>
                            `;

                            $('#invoiceTableBody').prepend(newTr);
                            $('#formNewInvoice')[0].reset();
                            updateFinancialStats();
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi kết nối', 'Không thể gửi dữ liệu đến server', 'error');
                    }
                });
            });

            // 4. Mở Modal Thu tiền cho hóa đơn
            window.openPaymentModal = function (btnElement) {
                activeInvoiceRow = $(btnElement).closest("tr");
                const invId = activeInvoiceRow.data("invoice-id");
                const studentName = activeInvoiceRow.data("student-name");
                const remaining = parseFloat(activeInvoiceRow.data("remaining")) || 0;

                $('#payInvoiceId').val(invId);
                $('#payStudentName').val(studentName);
                $('#payRemainingDisplay').val(remaining.toLocaleString() + ' đ');
                $('#payAmountInput').val(remaining).attr('max', remaining);
                $('#modalPayment').modal('show');
            };

            // 5. Gửi AJAX Thanh toán & Cập nhật số tiền, nhãn trạng thái trực tiếp
            $('#btnConfirmPayment').click(function () {
                const invId = parseInt($('#payInvoiceId').val());
                const payAmt = parseFloat($('#payAmountInput').val()) || 0;
                const remaining = parseFloat(activeInvoiceRow.data("remaining")) || 0;

                if (payAmt <= 0) {
                    Swal.fire('Lỗi số tiền', 'Vui lòng nhập số tiền thanh toán lớn hơn 0!', 'warning');
                    return;
                }
                if (payAmt > remaining) {
                    Swal.fire('Cảnh báo', 'Số tiền thu không được lớn hơn công nợ còn lại!', 'warning');
                    return;
                }

                const payload = {
                    hoaDonId: invId,
                    soTien: payAmt,
                    phuongThuc: $('#payMethodSelect').val(),
                    ghiChu: $('#payNoteInput').val()
                };

                $.ajax({
                    url: '/HoaDon/ThuTien',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        $('#modalPayment').modal('hide');
                        if (res.success) {
                            Swal.fire('Đã thu tiền!', res.message, 'success');

                            // Cập nhật lại số liệu trên dòng tr của hóa đơn
                            let currentPaid = parseFloat(activeInvoiceRow.data("paid")) || 0;
                            let currentPayable = parseFloat(activeInvoiceRow.data("payable")) || 0;

                            currentPaid += payAmt;
                            let newRemaining = currentPayable - currentPaid;

                            activeInvoiceRow.data("paid", currentPaid);
                            activeInvoiceRow.data("remaining", newRemaining);

                            if (newRemaining <= 0) {
                                // Đã thu hết nợ -> Chuyển thành Đã thu đủ và gỡ nút thu tiền
                                activeInvoiceRow.find(".status-badge")
                                    .removeClass("bg-warning-subtle text-warning border-warning-subtle bg-danger-subtle text-danger border-danger-subtle")
                                    .addClass("bg-success-subtle text-success border border-success-subtle")
                                    .text("Đã thu đủ");
                                activeInvoiceRow.find(".paid-text").text(`Đã thu: ${currentPaid.toLocaleString()} đ`);
                                activeInvoiceRow.find(".btn-pay").remove();
                            } else {
                                // Thu một phần -> Cập nhật số tiền đã thu
                                activeInvoiceRow.find(".paid-text").text(`Đã thu: ${currentPaid.toLocaleString()} đ`);
                            }

                            // Chớp sáng dòng vừa cập nhật
                            activeInvoiceRow.addClass("table-success");
                            setTimeout(() => activeInvoiceRow.removeClass("table-success"), 800);

                            updateFinancialStats();
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi kết nối', 'Không thể lưu thanh toán', 'error');
                    }
                });
            });

            // 6. Mở Popup In Phiếu Thu
            window.printInvoice = function (btnElement) {
                const tr = $(btnElement).closest("tr");
                $('#printReceiptCode').text('HD-00' + tr.data("invoice-id"));
                $('#printStudent').text(tr.data("student-name"));
                $('#printClass').text(tr.data("class-name"));
                $('#printTotal').text(parseFloat(tr.data("total")).toLocaleString() + ' đ');
                $('#printDiscount').text('-' + parseFloat(tr.data("discount")).toLocaleString() + ' đ');
                $('#printPayable').text(parseFloat(tr.data("payable")).toLocaleString() + ' đ');
                $('#printPaid').text(parseFloat(tr.data("paid")).toLocaleString() + ' đ');
                $('#printRemain').text(parseFloat(tr.data("remaining")).toLocaleString() + ' đ');

                $('#modalPrintReceipt').modal('show');
            };

            // 7. Hàm tự động tính toán lại 4 ô chỉ số thống kê trên đầu trang
            function updateFinancialStats() {
                let totalPayable = 0;
                let totalCollected = 0;
                let totalRemaining = 0;
                let unpaidCount = 0;

                $('#invoiceTableBody tr').each(function () {
                    const payable = parseFloat($(this).data('payable')) || 0;
                    const paid = parseFloat($(this).data('paid')) || 0;
                    const remaining = parseFloat($(this).data('remaining')) || 0;

                    totalPayable += payable;
                    totalCollected += paid;
                    totalRemaining += remaining;

                    if (remaining > 0) {
                        unpaidCount++;
                    }
                });

                $('#statTotalPayable').text(totalPayable.toLocaleString() + ' đ');
                $('#statTotalCollected').text(totalCollected.toLocaleString() + ' đ');
                $('#statRemainingDebt').text(totalRemaining.toLocaleString() + ' đ');
                $('#statUnpaidCount').text(unpaidCount);
                $('#displayCount').text($('#invoiceTableBody tr').length);
            }

            // Bộ lọc hóa đơn
            $('#btnFilterInv').click(function () {
                const kw = $('#searchInvoice').val().toLowerCase().trim();
                const status = $('#filterInvoiceStatus').val();

                $('#invoiceTableBody tr').each(function () {
                    const rowText = $(this).text().toLowerCase();
                    const rowStatus = $(this).find('.status-badge').text().trim();

                    const matchKw = kw === '' || rowText.includes(kw);
                    const matchStatus = status === '' || rowStatus === status;

                    $(this).toggle(matchKw && matchStatus);
                });
            });

            $('#btnResetInvFilter').click(function () {
                $('#searchInvoice').val('');
                $('#filterInvoiceStatus').val('');
                $('#invoiceTableBody tr').show();
            });
        });
    </script>
}