                const growth = report.tangTruongHocVien || [];
                makeChart('reportGrowthChart', { type: 'bar', data: { labels: growth.map(x => x.nhan), datasets: [{ label: 'Học viên mới', data: growth.map(x => x.hocVienMoi), backgroundColor: '#198754' }, { label: 'Đang học', data: growth.map(x => x.dangHoc), backgroundColor: '#0d6efd' }, { label: 'Hoàn thành', data: growth.map(x => x.hoanThanh), type: 'line', borderColor: '#fd7e14' }] }, options: { responsive: true } }, hasValues(growth));
                const distribution = report.phanBoKhoaHoc || [];
                makeChart('reportDistributionChart', { type: 'doughnut', data: { labels: distribution.map(x => x.nhan), datasets: [{ data: distribution.map(x => x.soLuong), backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6f42c1', '#20c997'] }] }, options: { responsive: true, plugins: { tooltip: { callbacks: { label: x => `${x.label}: ${x.raw} (${distribution[x.dataIndex].tyLe}%)` } } } } }, hasValues(distribution));
                const branches = report.quyMoCoSo || [];
                makeChart('reportBranchChart', { type: 'bar', data: { labels: branches.map(x => x.tenCoSo), datasets: [{ label: 'Phòng học', data: branches.map(x => x.soPhong), backgroundColor: '#20c997' }, { label: 'Nhân sự đang làm', data: branches.map(x => x.soNhanSu), backgroundColor: '#6f42c1' }] }, options: { responsive: true } }, hasValues(branches));
                const attendance = report.chuyenCan || [];
                makeChart('reportAttendanceChart', { type: 'bar', data: { labels: attendance.map(x => x.nhan), datasets: [{ label: 'Đúng giờ', data: attendance.map(x => x.dungGio), backgroundColor: '#198754' }, { label: 'Đi muộn', data: attendance.map(x => x.diMuon), backgroundColor: '#ffc107' }, { label: 'Vắng có phép', data: attendance.map(x => x.vangCoPhep), backgroundColor: '#0dcaf0' }, { label: 'Vắng không phép', data: attendance.map(x => x.vangKhongPhep), backgroundColor: '#dc3545' }, { label: 'Chưa điểm danh', data: attendance.map(x => x.chuaDiemDanh), backgroundColor: '#adb5bd' }] }, options: { responsive: true, scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true } } } }, hasValues(attendance));
            }
            function loadReport(filter) {
                const version = ++reportRequestVersion;
                $('#reportStatus').text('Đang tải dữ liệu báo cáo...');
                return postJson(urls.report, filter).done(res => {
                    if (version !== reportRequestVersion) return;
                    if (!res.success) { $('#reportStatus').text(res.message || 'Không có dữ liệu.'); return; }
                    renderReport(res.data);
                    $('#reportStatus').text('Số liệu được tính tại máy chủ theo bộ lọc đã áp dụng.');
                }).fail(xhr => { if (version === reportRequestVersion) { $('#reportStatus').text(errorMessage(xhr)); } });
            }
            function csvCell(value) { return `"${String(value ?? '').replace(/"/g, '""')}"`; }
            function exportReportCsv() {
                if (!latestReport) return Swal.fire('Thông báo', 'Hãy tải báo cáo trước khi xuất.', 'info');
                const rows = [['BÁO CÁO TỔNG HỢP'], ['Kỳ báo cáo', latestReport.kyBaoCao.nhanKy], ['Cập nhật', latestReport.capNhatLuc], [], ['DOANH THU'], ['Mốc', 'Doanh thu VNĐ'], ...latestReport.doanhThu.map(x => [x.nhan, x.giaTri]), [], ['TĂNG TRƯỞNG HỌC VIÊN'], ['Mốc', 'Học viên mới', 'Đang học', 'Hoàn thành'], ...latestReport.tangTruongHocVien.map(x => [x.nhan, x.hocVienMoi, x.dangHoc, x.hoanThanh]), [], ['PHÂN BỐ KHÓA HỌC'], ['Nhóm', 'Số lượng', 'Tỷ lệ %'], ...latestReport.phanBoKhoaHoc.map(x => [x.nhan, x.soLuong, x.tyLe]), [], ['QUY MÔ CƠ SỞ'], ['Cơ sở', 'Phòng học', 'Nhân sự'], ...latestReport.quyMoCoSo.map(x => [x.tenCoSo, x.soPhong, x.soNhanSu]), [], ['CHUYÊN CẦN'], ['Lớp', 'Đúng giờ', 'Đi muộn', 'Vắng có phép', 'Vắng không phép', 'Chưa điểm danh'], ...latestReport.chuyenCan.map(x => [x.nhan, x.dungGio, x.diMuon, x.vangCoPhep, x.vangKhongPhep, x.chuaDiemDanh])];
                const blob = new Blob(['\ufeff' + rows.map(row => row.map(csvCell).join(',')).join('\r\n')], { type: 'text/csv;charset=utf-8' });
                const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = 'BaoCaoTongHop.csv'; link.click(); URL.revokeObjectURL(link.href);
            }
            function printReport() {
                if (!latestReport) return Swal.fire('Thông báo', 'Hãy tải báo cáo trước khi xuất.', 'info');
                window.print();
            }
            $('#reportTimeType').on('change', showReportFields);
