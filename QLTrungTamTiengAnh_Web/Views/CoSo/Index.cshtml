@{
    ViewData["Title"] = "Quản lý Cơ sở & Điều chuyển";
}

@Html.AntiForgeryToken()

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="mb-1 text-dark fw-bold">Quản Lý Chi Nhánh & Điều Chuyển Công Tác</h4>
        <p class="text-muted small mb-0">Hệ thống mạng lưới cơ sở trung tâm và lịch sử luân chuyển nhân sự</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary" type="button" id="btnOpenTransferModal">
            <i class="fa-solid fa-arrows-split-up-and-left me-1"></i> Điều Chuyển Nhân Sự
        </button>
        <button class="btn btn-primary" type="button" id="btnOpenCreateBranch">
            <i class="fa-solid fa-plus me-1"></i> Thêm Cơ Sở Mới
        </button>
    </div>
</div>

<ul class="nav nav-pills mb-4" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-semibold" id="pills-branch-tab" data-bs-toggle="pill"
                data-bs-target="#pills-branch" type="button" role="tab">
            <i class="fa-solid fa-building me-1"></i> Danh Sách Cơ Sở
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="pills-trash-tab" data-bs-toggle="pill"
                data-bs-target="#pills-trash" type="button" role="tab">
            <i class="fa-solid fa-trash-can me-1"></i> Thùng Rác Cơ Sở
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="pills-transfer-tab" data-bs-toggle="pill"
                data-bs-target="#pills-transfer" type="button" role="tab">
            <i class="fa-solid fa-clock-rotate-left me-1"></i> Lịch Sử Điều Chuyển Nhân Sự
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="pills-branch" role="tabpanel">
        <div class="d-flex gap-2 mb-3">
            <input type="search" class="form-control" id="searchBranch" maxlength="100"
                   placeholder="Tìm tên, mã, địa chỉ hoặc số điện thoại cơ sở..." />
            <button type="button" class="btn btn-outline-primary" id="btnSearchBranch">Tìm kiếm</button>
        </div>
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3">MÃ CƠ SỞ</th>
                                <th>TÊN CƠ SỞ / CHI NHÁNH</th>
                                <th>ĐỊA CHỈ TRỤ SỞ</th>
                                <th>HOTLINE LIÊN HỆ</th>
                                <th>QUY MÔ ĐÀO TẠO</th>
                                <th>TRẠNG THÁI</th>
                                <th class="text-end pe-3">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody id="branchTableBody">
                            <tr><td colspan="7" class="text-center text-muted py-4">Đang tải dữ liệu cơ sở...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 gap-2 flex-wrap">
            <small class="text-muted" id="branchPageInfo"></small>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPrevBranch" disabled>Trang trước</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnNextBranch" disabled>Trang sau</button>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="pills-trash" role="tabpanel">
        <p class="text-muted small mb-3">Cơ sở đã xóa mềm vẫn được lưu trong SQL Server. Chỉ có thể xóa mềm khi không còn nhân sự, phòng học hoặc lớp học chưa xóa mềm. Khôi phục xong, cơ sở ở trạng thái tạm ngưng.</p>
        <div class="d-flex gap-2 mb-3">
            <input type="search" class="form-control" id="searchTrashBranch" maxlength="100"
                   placeholder="Tìm cơ sở đã xóa theo tên, mã hoặc địa chỉ..." />
            <button type="button" class="btn btn-outline-primary" id="btnSearchTrashBranch">Tìm kiếm</button>
        </div>
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3">MÃ CƠ SỞ</th>
                                <th>TÊN CƠ SỞ</th>
                                <th>ĐỊA CHỈ</th>
                                <th>SỐ ĐIỆN THOẠI</th>
                                <th>NGÀY XÓA MỀM</th>
                                <th class="text-end pe-3">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody id="trashBranchTableBody">
                            <tr><td colspan="6" class="text-center text-muted py-4">Chọn tab để tải thùng rác...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 gap-2 flex-wrap">
            <small class="text-muted" id="trashBranchPageInfo"></small>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPrevTrashBranch" disabled>Trang trước</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnNextTrashBranch" disabled>Trang sau</button>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="pills-transfer" role="tabpanel">
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3">MÃ ĐIỀU CHUYỂN</th>
                                <th>NHÂN SỰ / GIẢNG VIÊN</th>
                                <th>CƠ SỞ XUẤT PHÁT</th>
                                <th>CƠ SỞ ĐIỀU CHUYỂN ĐẾN</th>
                                <th>LÝ DO ĐIỀU ĐỘNG</th>
                                <th>NGƯỜI PHÊ DUYỆT</th>
                                <th>NGÀY HIỆU LỰC</th>
                                <th>TRẠNG THÁI</th>
                            </tr>
                        </thead>
                        <tbody id="transferTableBody">
                            <tr><td colspan="8" class="text-center text-muted py-4">Chọn tab để tải lịch sử...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 gap-2">
            <small class="text-muted" id="transferPageInfo"></small>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPrevTransfer" disabled>Trang trước</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnNextTransfer" disabled>Trang sau</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal thêm/sửa cơ sở: mã là giá trị HIỂN THỊ, tự sinh từ CoSoID. -->
<div class="modal fade" id="modalBranch" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalBranchTitle">Thêm Cơ Sở Đào Tạo Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <form id="formBranch">
                    <input type="hidden" id="hiddenBranchId" value="0" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="txtBranchCode">Mã Cơ Sở (tự động)</label>
                        <input type="text" class="form-control bg-light font-monospace" id="txtBranchCode" value="Tự sinh khi lưu" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="txtBranchName">Tên Cơ Sở / Chi Nhánh <span class="text-danger">*</span></label>
                        <input type="text" maxlength="100" class="form-control" id="txtBranchName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="txtBranchAddress">Địa Chỉ Chi Tiết <span class="text-danger">*</span></label>
                        <input type="text" maxlength="250" class="form-control" id="txtBranchAddress" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="txtBranchPhone">Hotline Liên Hệ</label>
                        <input type="tel" maxlength="20" class="form-control" id="txtBranchPhone" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveBranch">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Lưu Cơ Sở
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Điều chuyển phê duyệt ngay: NguoiDuyetID được xác định ở server. -->
<div class="modal fade" id="modalTransfer" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-arrows-split-up-and-left me-2 text-primary"></i>Phê Duyệt Điều Chuyển
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <form id="formTransfer">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="txtSearchTransferStaff">Tìm nhân sự / giáo viên</label>
                        <input type="text" class="form-control mb-2" id="txtSearchTransferStaff" placeholder="Nhập họ tên hoặc mã nhân sự..." />
                        <label class="form-label fw-semibold" for="selectTransferStaff">Chọn Nhân Sự / Giáo Viên <span class="text-danger">*</span></label>
                        <select class="form-select" id="selectTransferStaff" required>
                            <option value="">-- Chọn nhân sự điều chuyển --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="txtCurrentBranch">Cơ Sở Hiện Tại</label>
                        <input type="text" class="form-control bg-light" id="txtCurrentBranch" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="selectNewBranch">Điều Chuyển Sang Cơ Sở Mới <span class="text-danger">*</span></label>
                        <select class="form-select" id="selectNewBranch" required>
                            <option value="">-- Chọn cơ sở đến --</option>
                        </select>
                        <small class="text-muted">Cơ sở chuyển đến phải khác cơ sở hiện tại và đang hoạt động.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="txtTransferReason">Lý Do Điều Động Công Tác <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="txtTransferReason" rows="3" maxlength="300" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnExecuteTransfer">
                    <i class="fa-solid fa-check me-1"></i> Phê Duyệt Điều Chuyển
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            const branchModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalBranch'));
            const transferModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalTransfer'));
            const urls = {
                branches: '@Url.Action("DanhSachCoSo", "CoSo")',
                options: '@Url.Action("DanhSachCoSoLuaChon", "CoSo")',
                save: '@Url.Action("LuuCoSo", "CoSo")',
                status: '@Url.Action("DoiTrangThaiCoSo", "CoSo")',
                trash: '@Url.Action("DanhSachCoSoDaXoa", "CoSo")',
                softDelete: '@Url.Action("XoaMemCoSo", "CoSo")',
                restore: '@Url.Action("KhoiPhucCoSo", "CoSo")',
                staff: '@Url.Action("DanhSachNhanSu", "CoSo")',
                transfer: '@Url.Action("DieuChuyenNhanSu", "CoSo")',
                history: '@Url.Action("DanhSachLichSu", "CoSo")'
            };
            let branches = [];
            let trashBranches = [];
            let trashPage = 1;
            let trashTotalPages = 0;
            let trashLoaded = false;
            let transferBranches = [];
            let branchPage = 1;
            let branchTotalPages = 0;
            let staff = [];
            let transferPage = 1;
            let transferTotalPages = 0;
            let historyLoaded = false;

            function esc(value) {
                return String(value ?? '').replace(/[&<>"']/g, ch => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;
                })[ch]);
            }
            function errorMessage(xhr) {
                if (xhr.status === 401) return 'Phiên đăng nhập không hợp lệ. Hãy đăng nhập lại.';
                if (xhr.status === 403) return 'Bạn không có quyền thực hiện chức năng này.';
                if (xhr.status === 400 && !xhr.responseJSON?.message) return 'Yêu cầu bị từ chối. Hãy tải lại trang và thử lại.';
                return xhr.responseJSON?.message || 'Có lỗi xảy ra khi kết nối máy chủ.';
            }
            function fail(xhr) { Swal.fire('Không thành công', errorMessage(xhr), 'error'); }
            function postJson(url, payload) {
                return $.ajax({
                    url, type: 'POST', contentType: 'application/json',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    data: JSON.stringify(payload)
                });
            }
            function dateText(value) {
                if (!value) return '—';
                const d = new Date(value);
                return isNaN(d.getTime()) ? '—' : d.toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit', year: 'numeric' });
            }

            function renderBranches() {
                const tbody = $('#branchTableBody').empty();
                if (!branches.length) {
                    tbody.append('<tr><td colspan="7" class="text-center text-muted py-4">Chưa có cơ sở nào.</td></tr>');
                    return;
                }
                branches.forEach(b => {
                    const status = b.trangThai
                        ? '<span class="badge bg-success-subtle text-success border">Hoạt động</span>'
                        : '<span class="badge bg-secondary-subtle text-secondary border">Tạm ngưng</span>';
                    const action = b.trangThai
                        ? '<button type="button" class="btn btn-sm btn-outline-danger btn-status-branch" title="Tạm ngưng"><i class="fa-solid fa-ban"></i></button>'
                        : '<button type="button" class="btn btn-sm btn-outline-success btn-status-branch" title="Kích hoạt"><i class="fa-solid fa-rotate-left"></i></button>';
                    tbody.append(`<tr data-id="${b.coSoId}">
                            <td class="ps-3"><span class="badge bg-light text-primary border border-primary">${esc(b.maCoSo)}</span></td>
                            <td><span class="fw-bold text-dark">${esc(b.tenCoSo)}</span></td>
                            <td>${esc(b.diaChi)}</td>
                            <td>${esc(b.soDienThoai || '—')}</td>
                            <td><span class="badge bg-info-subtle text-info border">${b.soPhong} phòng • ${b.soNhanSu} nhân sự</span></td>
                            <td>${status}</td>
                            <td class="text-end pe-3 text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary me-1 btn-edit-branch" title="Sửa thông tin"><i class="fa-solid fa-pen"></i></button>
                                ${action}
                                <button type="button" class="btn btn-sm btn-outline-danger ms-1 btn-delete-branch" title="Xóa mềm (chuyển vào thùng rác)"><i class="fa-solid fa-trash-can"></i></button>
                            </td></tr>`);
                });
            }
            function loadBranches(page = branchPage) {
                $('#branchTableBody').html('<tr><td colspan="7" class="text-center py-4 text-muted">Đang tải cơ sở...</td></tr>');
                return $.getJSON(urls.branches, {
                    page, pageSize: 10, keyword: $('#searchBranch').val().trim()
                }).done(res => {
                    if (!res.success) {
                        $('#branchTableBody').html('<tr><td colspan="7" class="text-center text-danger py-4">Không tải được dữ liệu cơ sở.</td></tr>');
                        Swal.fire('Lỗi', res.message || 'Không tải được cơ sở.', 'error');
                        return;
                    }
                    branches = res.data || [];
                    branchPage = res.page;
                    branchTotalPages = res.totalPages;
                    renderBranches();
                    $('#branchPageInfo').text(`Tổng ${res.total} cơ sở • Trang ${branchPage}/${branchTotalPages || 1}`);
                    $('#btnPrevBranch').prop('disabled', branchPage <= 1);
                    $('#btnNextBranch').prop('disabled', branchPage >= branchTotalPages);
                }).fail(xhr => {
                    $('#branchTableBody').html('<tr><td colspan="7" class="text-center text-danger py-4">Không tải được dữ liệu từ máy chủ.</td></tr>');
                    fail(xhr);
                });
            }
            $('#btnSearchBranch').on('click', () => loadBranches(1));
            $('#searchBranch').on('keydown', function(e) {
                if (e.key === 'Enter') { e.preventDefault(); loadBranches(1); }
            });
            $('#btnPrevBranch').on('click', () => { if (branchPage > 1) loadBranches(branchPage - 1); });
            $('#btnNextBranch').on('click', () => { if (branchPage < branchTotalPages) loadBranches(branchPage + 1); });

            $('#btnOpenCreateBranch').on('click', () => {
                $('#formBranch')[0].reset();
                $('#hiddenBranchId').val('0');
                $('#txtBranchCode').val('Tự sinh khi lưu');
                $('#modalBranchTitle').text('Thêm Cơ Sở Đào Tạo Mới');
                branchModal.show();
            });
            $('#branchTableBody').on('click', '.btn-edit-branch', function() {
                const id = Number($(this).closest('tr').attr('data-id'));
                const b = branches.find(x => x.coSoId === id);
                if (!b) return;
                $('#formBranch')[0].reset();
                $('#hiddenBranchId').val(b.coSoId);
                $('#txtBranchCode').val(b.maCoSo);
                $('#txtBranchName').val(b.tenCoSo);
                $('#txtBranchAddress').val(b.diaChi);
                $('#txtBranchPhone').val(b.soDienThoai);
                $('#modalBranchTitle').text('Chỉnh Sửa Cơ Sở: ' + b.maCoSo);
                branchModal.show();
            });
            $('#btnSaveBranch').on('click', function() {
                if (!$('#formBranch')[0].reportValidity()) return;
                const payload = {
                    coSoId: Number($('#hiddenBranchId').val()) || 0,
                    tenCoSo: $('#txtBranchName').val().trim(),
                    diaChi: $('#txtBranchAddress').val().trim(),
                    soDienThoai: $('#txtBranchPhone').val().trim()
                };
                const btn = $(this).prop('disabled', true);
                postJson(urls.save, payload).done(res => {
                    if (!res.success) return Swal.fire('Lỗi', res.message, 'error');
                    branchModal.hide();
                    loadBranches(payload.coSoId === 0 ? 1 : branchPage);
                    Swal.fire('Thành công', res.message, 'success');
                }).fail(fail).always(() => btn.prop('disabled', false));
            });
            $('#branchTableBody').on('click', '.btn-status-branch', async function() {
                const id = Number($(this).closest('tr').attr('data-id'));
                const b = branches.find(x => x.coSoId === id);
                if (!b) return;
                const nextStatus = !b.trangThai;
                const r = await Swal.fire({
                    title: nextStatus ? 'Kích hoạt lại cơ sở?' : 'Tạm ngưng cơ sở?',
                    text: b.tenCoSo,
                    icon: 'warning', showCancelButton: true,
                    confirmButtonText: 'Xác nhận', cancelButtonText: 'Hủy'
                });
                if (!r.isConfirmed) return;
                postJson(urls.status, { coSoId: id, trangThai: nextStatus })
                    .done(res => { loadBranches(); Swal.fire('Thành công', res.message, 'success'); })
                    .fail(fail);
            });

            // Xóa mềm riêng với "tạm ngưng": chuyển vào thùng rác, không xóa SQL.
            $('#branchTableBody').on('click', '.btn-delete-branch', async function() {
                const id = Number($(this).closest('tr').attr('data-id'));
                const branch = branches.find(x => x.coSoId === id);
                if (!branch) return;
                const confirmation = await Swal.fire({
                    title: 'Xóa mềm cơ sở?',
                    html: `Cơ sở <b>${esc(branch.tenCoSo)}</b> sẽ được chuyển vào thùng rác.<br/>Không xóa được nếu còn nhân sự, phòng học hoặc lớp học chưa xóa mềm.`,
                    icon: 'warning', showCancelButton: true,
                    confirmButtonText: 'Chuyển vào thùng rác', cancelButtonText: 'Hủy',
                    confirmButtonColor: '#dc3545'
                });
                if (!confirmation.isConfirmed) return;
                const btn = $(this).prop('disabled', true);
                postJson(urls.softDelete, { coSoId: id })
                    .done(res => {
                        if (!res.success) return Swal.fire('Lỗi', res.message, 'error');
                        trashLoaded = false;
                        loadBranches(branchPage);
                        Swal.fire('Đã xóa mềm', res.message, 'success');
                    })
                    .fail(fail)
                    .always(() => btn.prop('disabled', false));
            });

            function loadTrash(page = trashPage) {
                $('#trashBranchTableBody').html('<tr><td colspan="6" class="text-center text-muted py-4">Đang tải thùng rác...</td></tr>');
                return $.getJSON(urls.trash, { page, pageSize: 10, keyword: $('#searchTrashBranch').val().trim() })
                    .done(res => {
                        if (!res.success) {
                            $('#trashBranchTableBody').html('<tr><td colspan="6" class="text-center text-danger py-4">Không tải được thùng rác.</td></tr>');
                            Swal.fire('Lỗi', res.message || 'Không tải được thùng rác.', 'error');
                            return;
                        }
                        trashBranches = res.data || [];
                        trashPage = res.page;
                        trashTotalPages = res.totalPages;
                        trashLoaded = true;
                        const tbody = $('#trashBranchTableBody').empty();
                        if (!trashBranches.length) {
                            tbody.append('<tr><td colspan="6" class="text-center text-muted py-4">Thùng rác trống.</td></tr>');
                        }
                        trashBranches.forEach(b => {
                            tbody.append(`<tr data-id="${b.coSoId}">
                                    <td class="ps-3"><span class="badge bg-light text-secondary border">${esc(b.maCoSo)}</span></td>
                                    <td><span class="fw-semibold">${esc(b.tenCoSo)}</span></td>
                                    <td>${esc(b.diaChi)}</td>
                                    <td>${esc(b.soDienThoai || '—')}</td>
                                    <td>${esc(dateText(b.deletedAt))}</td>
                                    <td class="text-end pe-3"><button type="button" class="btn btn-sm btn-outline-success btn-restore-branch"><i class="fa-solid fa-rotate-left me-1"></i>Khôi phục</button></td>
                                    </tr>`);
                        });
                        $('#trashBranchPageInfo').text(`Tổng ${res.total} cơ sở đã xóa • Trang ${trashPage}/${trashTotalPages || 1}`);
                        $('#btnPrevTrashBranch').prop('disabled', trashPage <= 1);
                        $('#btnNextTrashBranch').prop('disabled', trashPage >= trashTotalPages);
                    })
                    .fail(xhr => {
                        $('#trashBranchTableBody').html('<tr><td colspan="6" class="text-center text-danger py-4">Không tải được thùng rác.</td></tr>');
                        fail(xhr);
                    });
            }
            $('#pills-trash-tab').on('shown.bs.tab', () => { if (!trashLoaded) loadTrash(1); });
            $('#btnSearchTrashBranch').on('click', () => loadTrash(1));
            $('#searchTrashBranch').on('keydown', function(e) {
                if (e.key === 'Enter') { e.preventDefault(); loadTrash(1); }
            });
            $('#btnPrevTrashBranch').on('click', () => { if (trashPage > 1) loadTrash(trashPage - 1); });
            $('#btnNextTrashBranch').on('click', () => { if (trashPage < trashTotalPages) loadTrash(trashPage + 1); });
            $('#trashBranchTableBody').on('click', '.btn-restore-branch', async function() {
                const id = Number($(this).closest('tr').attr('data-id'));
                const branch = trashBranches.find(x => x.coSoId === id);
                if (!branch) return;
                const confirmation = await Swal.fire({
                    title: 'Khôi phục cơ sở?',
                    html: `Khôi phục <b>${esc(branch.tenCoSo)}</b>? Cơ sở sẽ trở lại danh sách ở trạng thái tạm ngưng.`,
                    icon: 'question', showCancelButton: true,
                    confirmButtonText: 'Khôi phục', cancelButtonText: 'Hủy'
                });
                if (!confirmation.isConfirmed) return;
                const btn = $(this).prop('disabled', true);
                postJson(urls.restore, { coSoId: id })
                    .done(res => {
                        if (!res.success) return Swal.fire('Lỗi', res.message, 'error');
                        loadTrash(trashPage);
                        loadBranches(1);
                        Swal.fire('Thành công', res.message, 'success');
                    })
                    .fail(fail)
                    .always(() => btn.prop('disabled', false));
            });

            function fillStaffOptions() {
                const query = $('#txtSearchTransferStaff').val().trim().toLocaleLowerCase('vi-VN');
                const selected = Number($('#selectTransferStaff').val());
                const select = $('#selectTransferStaff').empty().append('<option value="">-- Chọn nhân sự điều chuyển --</option>');
                staff.filter(s => !query || `${s.nhanSuId} ${s.hoTen} ${s.loaiNhanSu}`.toLocaleLowerCase('vi-VN').includes(query))
                    .forEach(s => select.append($('<option>').val(s.nhanSuId)
                        .text(`NS-${String(s.nhanSuId).padStart(3, '0')} • ${s.hoTen} (${s.tenCoSo})`)));
                if (selected && select.find(`option[value="${selected}"]`).length) select.val(String(selected));
                select.trigger('change');
            }
            function fillBranchOptions() {
                const select = $('#selectNewBranch').empty().append('<option value="">-- Chọn cơ sở đến --</option>');
                transferBranches.forEach(b =>
                    select.append($('<option>').val(b.coSoId).text(b.tenCoSo)));
            }
            $('#btnOpenTransferModal').on('click', function() {
                $('#formTransfer')[0].reset();
                $('#txtCurrentBranch').val('');
                $('#selectTransferStaff').html('<option value="">Đang tải danh sách...</option>');
                $('#selectNewBranch').html('<option value="">Đang tải cơ sở...</option>');
                $.when($.getJSON(urls.staff), $.getJSON(urls.options))
                    .done((staffResult, branchResult) => {
                        if (!staffResult[0].success || !branchResult[0].success) {
                            return Swal.fire('Lỗi', 'Không thể tải danh sách nhân sự và cơ sở.', 'error');
                        }
                        staff = staffResult[0].data || [];
                        transferBranches = branchResult[0].data || [];
                        fillStaffOptions();
                        fillBranchOptions();
                        transferModal.show();
                    }).fail(fail);
            });
            $('#txtSearchTransferStaff').on('input', fillStaffOptions);
            $('#selectTransferStaff').on('change', function() {
                const s = staff.find(x => x.nhanSuId === Number($(this).val()));
                $('#txtCurrentBranch').val(s?.tenCoSo || '');
                $('#selectNewBranch option').prop('disabled', false);
                if (s) $('#selectNewBranch option[value="' + s.coSoId + '"]').prop('disabled', true);
                if (s && Number($('#selectNewBranch').val()) === s.coSoId) $('#selectNewBranch').val('');
            });
            $('#btnExecuteTransfer').on('click', async function() {
                if (!$('#formTransfer')[0].reportValidity()) return;
                const staffId = Number($('#selectTransferStaff').val());
                const branchId = Number($('#selectNewBranch').val());
                const staffObj = staff.find(x => x.nhanSuId === staffId);
                const lyDo = $('#txtTransferReason').val().trim();
                if (!staffObj || !branchId || !lyDo) {
                    return Swal.fire('Thiếu thông tin', 'Vui lòng chọn nhân sự, cơ sở đến và nhập lý do.', 'warning');
                }
                if (staffObj.coSoId === branchId) {
                    return Swal.fire('Không hợp lệ', 'Cơ sở đến phải khác cơ sở hiện tại.', 'warning');
                }
                const r = await Swal.fire({
                    title: 'Xác nhận phê duyệt?',
                    text: 'Sau khi duyệt, cơ sở làm việc của nhân sự sẽ thay đổi ngay.',
                    icon: 'question', showCancelButton: true,
                    confirmButtonText: 'Phê duyệt', cancelButtonText: 'Hủy'
                });
                if (!r.isConfirmed) return;
                const btn = $(this).prop('disabled', true);
                postJson(urls.transfer, { nhanSuId: staffId, coSoMoiId: branchId, lyDo })
                    .done(res => {
                        if (!res.success) return Swal.fire('Lỗi', res.message, 'error');
                        transferModal.hide();
                        loadBranches(branchPage);
                        transferPage = 1;
                        loadHistory(1);
                        bootstrap.Tab.getOrCreateInstance(document.getElementById('pills-transfer-tab')).show();
                        Swal.fire('Đã phê duyệt', res.message, 'success');
                    }).fail(fail).always(() => btn.prop('disabled', false));
            });

            function loadHistory(page = 1) {
                $('#transferTableBody').html('<tr><td colspan="8" class="text-center text-muted py-4">Đang tải lịch sử...</td></tr>');
                $.getJSON(urls.history, { page, pageSize: 10 }).done(res => {
                    if (!res.success) {
                        $('#transferTableBody').html('<tr><td colspan="8" class="text-center text-danger py-4">Không tải được lịch sử.</td></tr>');
                        Swal.fire('Lỗi', res.message || 'Không thể tải lịch sử.', 'error');
                        return;
                    }
                    transferPage = res.page;
                    transferTotalPages = res.totalPages;
                    historyLoaded = true;
                    const tbody = $('#transferTableBody').empty();
                    if (!res.data.length) tbody.append('<tr><td colspan="8" class="text-center text-muted py-4">Chưa có lịch sử điều chuyển.</td></tr>');
                    res.data.forEach(x => {
                        tbody.append(`<tr>
                                <td class="ps-3"><span class="badge bg-light text-dark border">DC-${String(x.dieuChuyenId).padStart(4, '0')}</span></td>
                                <td><div class="fw-bold text-dark">${esc(x.hoTen)}</div><small class="text-muted">NS-${x.nhanSuId} • ${esc(x.loaiNhanSu)}</small></td>
                                <td>${esc(x.coSoCu)}</td><td>${esc(x.coSoMoi)}</td>
                                <td><small>${esc(x.lyDo)}</small></td><td>${esc(x.nguoiDuyet)}</td>
                                <td><small>${esc(dateText(x.ngayHieuLuc || x.ngayDeXuat))}</small></td>
                                <td><span class="badge ${x.trangThai === 'Đã phê duyệt' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-dark'} border">${esc(x.trangThai)}</span></td>
                            </tr>`);
                    });
                    $('#transferPageInfo').text(`Tổng ${res.total} bản ghi • Trang ${transferPage}/${transferTotalPages || 1}`);
                    $('#btnPrevTransfer').prop('disabled', transferPage <= 1);
                    $('#btnNextTransfer').prop('disabled', transferPage >= transferTotalPages);
                }).fail(xhr => {
                    $('#transferTableBody').html('<tr><td colspan="8" class="text-center text-danger py-4">Không tải được lịch sử từ máy chủ.</td></tr>');
                    fail(xhr);
                });
            }
            $('#pills-transfer-tab').on('shown.bs.tab', function() {
                if (!historyLoaded) loadHistory(1);
            });
            $('#btnPrevTransfer').on('click', () => { if (transferPage > 1) loadHistory(transferPage - 1); });
            $('#btnNextTransfer').on('click', () => { if (transferPage < transferTotalPages) loadHistory(transferPage + 1); });

            loadBranches();
        });
    </script>
}
