@{
    ViewData["Title"] = "Quản lý Cơ sở & Phòng học";
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<div id="coSoPage"
     data-data-url="@Url.Action("DuLieu", "CoSo")"
     data-save-branch-url="@Url.Action("LuuCoSo", "CoSo")"
     data-status-branch-url="@Url.Action("DoiTrangThaiCoSo", "CoSo")"
     data-save-room-url="@Url.Action("LuuPhongHoc", "CoSo")"
     data-delete-room-url="@Url.Action("XoaPhongHoc", "CoSo")"
     data-transfer-url="@Url.Action("DieuChuyenNhanSu", "CoSo")">
    @Html.AntiForgeryToken()
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h4 class="mb-1 text-dark fw-bold">Quản Lý Cơ Sở, Phòng Học & Điều Chuyển</h4>
            <p class="text-muted small mb-0">Quản lý mạng lưới cơ sở, phòng học và lịch sử luân chuyển nhân sự</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-primary" type="button" id="btnOpenTransferModal" data-mutation disabled>
                <i class="fa-solid fa-arrows-split-up-and-left me-1" aria-hidden="true"></i> Điều Chuyển Nhân Sự
            </button>
            <button class="btn btn-primary" type="button" id="btnOpenCreateBranch" data-mutation disabled>
                <i class="fa-solid fa-plus me-1" aria-hidden="true"></i> Thêm Cơ Sở Mới
            </button>
        </div>
    </div>

    <div id="pageMessage" class="alert d-none" role="alert" tabindex="-1"></div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <ul class="nav nav-pills gap-1" role="tablist" aria-label="Quản lý cơ sở">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold" id="pills-branch-tab" data-bs-toggle="pill" data-bs-target="#pills-branch" type="button" role="tab" aria-controls="pills-branch" aria-selected="true">
                    <i class="fa-solid fa-building me-1" aria-hidden="true"></i> Danh Sách Cơ Sở
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="pills-room-tab" data-bs-toggle="pill" data-bs-target="#pills-room" type="button" role="tab" aria-controls="pills-room" aria-selected="false">
                    <i class="fa-solid fa-door-open me-1" aria-hidden="true"></i> Phòng Học
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="pills-transfer-tab" data-bs-toggle="pill" data-bs-target="#pills-transfer" type="button" role="tab" aria-controls="pills-transfer" aria-selected="false">
                    <i class="fa-solid fa-clock-rotate-left me-1" aria-hidden="true"></i> Lịch Sử Điều Chuyển
                </button>
            </li>
        </ul>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnRefreshData">
            <i class="fa-solid fa-rotate-right me-1" aria-hidden="true"></i> Tải Lại
        </button>
    </div>
    <p class="text-muted small" id="dataStatus" role="status" aria-live="polite">Đang tải dữ liệu...</p>

    <div class="tab-content" id="branchTabContent" aria-busy="true">
        <div class="tab-pane fade show active" id="pills-branch" role="tabpanel" aria-labelledby="pills-branch-tab" tabindex="0">
            <div class="mb-3">
                <label for="branchSearch" class="visually-hidden">Tìm cơ sở</label>
                <input type="search" class="form-control" id="branchSearch" placeholder="Tìm theo mã, tên hoặc địa chỉ cơ sở..." />
            </div>
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light"><tr>
                            <th class="ps-3" scope="col">MÃ CƠ SỞ</th><th scope="col">TÊN CƠ SỞ / CHI NHÁNH</th>
                            <th scope="col">ĐỊA CHỈ TRỤ SỞ</th><th scope="col">HOTLINE LIÊN HỆ</th>
                            <th scope="col">QUY MÔ ĐÀO TẠO</th><th scope="col">TRẠNG THÁI</th>
                            <th scope="col" class="text-end pe-3">THAO TÁC</th>
                        </tr></thead>
                        <tbody id="branchTableBody"><tr><td colspan="7" class="text-center text-muted py-4">Đang tải danh sách cơ sở...</td></tr></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="pills-room" role="tabpanel" aria-labelledby="pills-room-tab" tabindex="0">
            <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-3">
                <div>
                    <label for="roomBranchFilter" class="form-label">Lọc theo cơ sở</label>
                    <select id="roomBranchFilter" class="form-select"><option value="">Tất cả cơ sở</option></select>
                </div>
                <button class="btn btn-primary" type="button" id="btnOpenCreateRoom" data-mutation disabled>
                    <i class="fa-solid fa-plus me-1" aria-hidden="true"></i> Thêm Phòng Học
                </button>
            </div>
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light"><tr>
                            <th class="ps-3" scope="col">PHÒNG HỌC</th><th scope="col">CƠ SỞ</th>
                            <th scope="col">SỨC CHỨA</th><th scope="col">TRẠNG THÁI</th><th scope="col">GHI CHÚ</th>
                            <th scope="col" class="text-end pe-3">THAO TÁC</th>
                        </tr></thead>
                        <tbody id="roomTableBody"><tr><td colspan="6" class="text-center text-muted py-4">Đang tải danh sách phòng học...</td></tr></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="pills-transfer" role="tabpanel" aria-labelledby="pills-transfer-tab" tabindex="0">
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light"><tr>
                            <th class="ps-3" scope="col">MÃ ĐIỀU CHUYỂN</th><th scope="col">NHÂN SỰ / GIÁO VIÊN</th>
                            <th scope="col">CƠ SỞ XUẤT PHÁT</th><th scope="col">CƠ SỞ ĐẾN</th>
                            <th scope="col">LÝ DO ĐIỀU ĐỘNG</th><th scope="col">NGƯỜI PHÊ DUYỆT</th>
                            <th scope="col">THỜI GIAN</th><th scope="col">TRẠNG THÁI</th>
                        </tr></thead>
                        <tbody id="transferTableBody"><tr><td colspan="8" class="text-center text-muted py-4">Đang tải lịch sử điều chuyển...</td></tr></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalBranch" tabindex="-1" aria-labelledby="modalBranchTitle" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title fw-bold" id="modalBranchTitle">Thêm Cơ Sở Đào Tạo Mới</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <div class="modal-body">
            <div id="branchError" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>
            <form id="formBranch">
                <input type="hidden" id="hiddenBranchId" value="0" />
                <div class="mb-3">
                    <label for="txtBranchCode" class="form-label fw-semibold">Mã Cơ Sở <span class="text-danger">*</span></label>
                    <input type="text" class="form-control font-monospace" id="txtBranchCode" maxlength="30" placeholder="VD: CS-HBT" required />
                </div>
                <div class="mb-3">
                    <label for="txtBranchName" class="form-label fw-semibold">Tên Cơ Sở / Chi Nhánh <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="txtBranchName" maxlength="100" placeholder="VD: Cơ sở Hai Bà Trưng" required />
                </div>
                <div class="mb-3">
                    <label for="txtBranchAddress" class="form-label fw-semibold">Địa Chỉ Chi Tiết <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="txtBranchAddress" maxlength="250" placeholder="Số nhà, đường, phường/xã, tỉnh/thành phố" required />
                </div>
                <div class="mb-3">
                    <label for="txtBranchPhone" class="form-label fw-semibold">Hotline Liên Hệ</label>
                    <input type="tel" class="form-control" id="txtBranchPhone" maxlength="20" placeholder="VD: 024 3999 8888" />
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            <button type="submit" form="formBranch" class="btn btn-primary" id="btnSaveBranch" data-mutation>
                <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i> Lưu Cơ Sở
            </button>
        </div>
    </div></div>
</div>

<div class="modal fade" id="modalRoom" tabindex="-1" aria-labelledby="modalRoomTitle" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title fw-bold" id="modalRoomTitle">Thêm Phòng Học</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <div class="modal-body">
            <div id="roomError" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>
            <form id="formRoom">
                <input type="hidden" id="hiddenRoomId" value="0" />
                <div class="mb-3">
                    <label for="selectRoomBranch" class="form-label fw-semibold">Cơ Sở <span class="text-danger">*</span></label>
                    <select id="selectRoomBranch" class="form-select" required><option value="">-- Chọn cơ sở --</option></select>
                </div>
                <div class="mb-3">
                    <label for="txtRoomName" class="form-label fw-semibold">Tên Phòng <span class="text-danger">*</span></label>
                    <input type="text" id="txtRoomName" class="form-control" maxlength="50" placeholder="VD: Phòng A101" required />
                </div>
                <div class="mb-3">
                    <label for="txtRoomCapacity" class="form-label fw-semibold">Sức Chứa (người) <span class="text-danger">*</span></label>
                    <input type="number" id="txtRoomCapacity" class="form-control" min="1" max="2147483647" step="1" required />
                </div>
                <div class="mb-3">
                    <label for="selectRoomStatus" class="form-label fw-semibold">Trạng Thái <span class="text-danger">*</span></label>
                    <select id="selectRoomStatus" class="form-select" required>
                        <option>Đang sử dụng</option><option>Bảo trì</option><option>Ngừng sử dụng</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="txtRoomNote" class="form-label fw-semibold">Ghi Chú</label>
                    <textarea id="txtRoomNote" class="form-control" rows="2" maxlength="300" placeholder="Thiết bị, đặc điểm phòng..."></textarea>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            <button type="submit" form="formRoom" class="btn btn-primary" id="btnSaveRoom" data-mutation>
                <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i> Lưu Phòng Học
            </button>
        </div>
    </div></div>
</div>

<div class="modal fade" id="modalTransfer" tabindex="-1" aria-labelledby="modalTransferTitle" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title fw-bold" id="modalTransferTitle">Phê Duyệt Điều Chuyển Nhân Sự</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <div class="modal-body">
            <div id="transferError" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>
            <form id="formTransfer">
                <div class="mb-3">
                    <label for="selectTransferStaff" class="form-label fw-semibold">Nhân Sự / Giáo Viên <span class="text-danger">*</span></label>
                    <select class="form-select" id="selectTransferStaff" required><option value="">-- Chọn nhân sự điều chuyển --</option></select>
                </div>
                <div class="mb-3">
                    <label for="txtCurrentBranch" class="form-label fw-semibold">Cơ Sở Hiện Tại</label>
                    <input type="text" class="form-control bg-light" id="txtCurrentBranch" readonly placeholder="Tự động nhận diện khi chọn nhân sự" />
                </div>
                <div class="mb-3">
                    <label for="selectNewBranch" class="form-label fw-semibold">Chuyển Sang Cơ Sở <span class="text-danger">*</span></label>
                    <select class="form-select" id="selectNewBranch" required aria-describedby="transferHelp"><option value="">-- Chọn cơ sở đến --</option></select>
                    <small class="text-muted" id="transferHelp">Chỉ chọn cơ sở đang hoạt động, khác cơ sở hiện tại.</small>
                </div>
                <div class="mb-3">
                    <label for="txtTransferReason" class="form-label fw-semibold">Lý Do Điều Động Công Tác <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="txtTransferReason" rows="3" maxlength="300" placeholder="VD: Tăng cường giáo viên cho đợt tuyển sinh mới..." required></textarea>
                </div>
                <p class="small text-muted mb-0">Phê duyệt sẽ cập nhật cơ sở công tác của nhân sự và lưu lịch sử ngay. Lớp học và phân công giảng dạy không tự chuyển theo.</p>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            <button type="submit" form="formTransfer" class="btn btn-primary" id="btnExecuteTransfer" data-mutation>
                <i class="fa-solid fa-check me-1" aria-hidden="true"></i> Phê Duyệt Điều Chuyển
            </button>
        </div>
    </div></div>
</div>

@section Scripts {
    <script src="~/js/co-so.js" asp-append-version="true" defer data-bootstrap-url="@Url.Content("~/lib/bootstrap/dist/js/bootstrap.bundle.min.js")"></script>
}
