@{
    ViewData["Title"] = "Quản lý Cơ sở & Điều chuyển";
}

@Html.AntiForgeryToken()

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="mb-1 text-dark fw-bold">Báo cáo tổng hợp</h4>
        <p class="text-muted small mb-0">Báo cáo theo bộ lọc đã áp dụng: <span id="reportPeriod">Đang tải...</span></p>
        <small class="text-muted">Cập nhật: <span id="reportUpdatedAt">—</span></small>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-success btn-sm" id="btnExportReportCsv"><i class="fa-solid fa-file-excel me-1"></i> Xuất Excel</button>
        <button type="button" class="btn btn-outline-danger btn-sm" id="btnPrintReport"><i class="fa-solid fa-file-pdf me-1"></i> Xuất PDF</button>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold" for="reportTimeType">Kiểu thời gian</label>
                <select class="form-select" id="reportTimeType">
                    <option value="month">Theo tháng</option>
                    <option value="quarter">Theo quý</option>
                    <option value="year">Theo năm</option>
                    <option value="range">Khoảng ngày</option>
                </select>
            </div>
            <div class="col-md-2 report-month-field"><label class="form-label small fw-semibold" for="reportMonth">Tháng</label><input class="form-control" id="reportMonth" type="number" min="1" max="12" /></div>
            <div class="col-md-2 report-year-field"><label class="form-label small fw-semibold" for="reportYear">Năm</label><input class="form-control" id="reportYear" type="number" min="1" max="9999" /></div>
            <div class="col-md-2 report-quarter-field d-none"><label class="form-label small fw-semibold" for="reportQuarter">Quý</label><select class="form-select" id="reportQuarter"><option value="1">Quý 1</option><option value="2">Quý 2</option><option value="3">Quý 3</option><option value="4">Quý 4</option></select></div>
            <div class="col-md-2 report-range-field d-none"><label class="form-label small fw-semibold" for="reportFrom">Từ ngày</label><input class="form-control" id="reportFrom" type="date" /></div>
            <div class="col-md-2 report-range-field d-none"><label class="form-label small fw-semibold" for="reportTo">Đến ngày</label><input class="form-control" id="reportTo" type="date" /></div>
            <div class="col-md-3"><label class="form-label small fw-semibold" for="reportBranch">Cơ sở</label><select class="form-select" id="reportBranch"><option value="">Tất cả cơ sở</option></select></div>
            <div class="col-md-3 d-flex gap-2"><button type="button" class="btn btn-primary" id="btnApplyReport"><i class="fa-solid fa-filter me-1"></i> Áp dụng</button><button type="button" class="btn btn-outline-secondary" id="btnReloadReport"><i class="fa-solid fa-rotate me-1"></i> Tải lại</button><button type="button" class="btn btn-outline-secondary" id="btnCurrentMonth">Tháng hiện tại</button></div>
        </div>
        <div class="small text-danger mt-2" id="reportFilterError"></div>
    </div>
</div>

<div class="row g-3 mb-4" id="reportKpis">
    <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm p-3"><span class="text-muted small">DOANH THU THỰC THU</span><strong class="fs-4" id="reportRevenue">—</strong></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm p-3"><span class="text-muted small">HỌC VIÊN MỚI</span><strong class="fs-4" id="reportNewStudents">—</strong></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm p-3"><span class="text-muted small">ĐANG HỌC</span><strong class="fs-4" id="reportActiveStudents">—</strong></div></div>
    <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm p-3"><span class="text-muted small">HOÀN THÀNH</span><strong class="fs-4" id="reportCompletedStudents">—</strong></div></div>
</div>

<div class="row g-4 mb-4 report-charts">
    <div class="col-lg-8"><div class="card border-0 shadow-sm h-100"><div class="card-header bg-white fw-semibold">Doanh thu học phí <small class="text-muted" id="revenueGrouping"></small></div><div class="card-body"><canvas id="reportRevenueChart"></canvas><div class="report-empty text-muted text-center d-none">Chưa có dữ liệu</div></div></div></div>
    <div class="col-lg-4"><div class="card border-0 shadow-sm h-100"><div class="card-header bg-white fw-semibold">Phân bố học viên theo khóa học</div><div class="card-body"><canvas id="reportDistributionChart"></canvas><div class="report-empty text-muted text-center d-none">Chưa có dữ liệu</div></div></div></div>
    <div class="col-lg-7"><div class="card border-0 shadow-sm h-100"><div class="card-header bg-white fw-semibold">Tăng trưởng học viên</div><div class="card-body"><canvas id="reportGrowthChart"></canvas><div class="report-empty text-muted text-center d-none">Chưa có dữ liệu</div></div></div></div>
    <div class="col-lg-5"><div class="card border-0 shadow-sm h-100"><div class="card-header bg-white fw-semibold">Quy mô hiện tại theo cơ sở</div><div class="card-body"><canvas id="reportBranchChart"></canvas><div class="report-empty text-muted text-center d-none">Chưa có dữ liệu</div></div></div></div>
    <div class="col-12"><div class="card border-0 shadow-sm"><div class="card-header bg-white fw-semibold">Chuyên cần & điểm danh <small class="text-muted">Chưa điểm danh không tính là vắng</small></div><div class="card-body"><canvas id="reportAttendanceChart"></canvas><div class="report-empty text-muted text-center d-none">Chưa có dữ liệu</div></div></div></div>
</div>

<div id="reportStatus" class="small text-muted mb-4" aria-live="polite"></div>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h4 class="mb-1 text-dark fw-bold">Quản Lý Chi Nhánh & Điều Chuyển Công Tác</h4>
        <p class="text-muted small mb-0">Hệ thống mạng lưới cơ sở trung tâm và lịch sử luân chuyển nhân sự</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary" type="button" id="btnOpenTransferModal">
            <i class="fa-solid fa-arrows-split-up-and-left me-1"></i> Điều Chuyển Nhân Sự
        </button>
        <button class="btn btn-primary" type="button" id="btnOpenCreateBranch">
            <i class="fa-solid fa-plus me-1"></i> Thêm Cơ Sở Mới
        </button>
    </div>
</div>

<ul class="nav nav-pills mb-4" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-semibold" id="pills-branch-tab" data-bs-toggle="pill"
                data-bs-target="#pills-branch" type="button" role="tab">
            <i class="fa-solid fa-building me-1"></i> Danh Sách Cơ Sở
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="pills-trash-tab" data-bs-toggle="pill"
                data-bs-target="#pills-trash" type="button" role="tab">
            <i class="fa-solid fa-trash-can me-1"></i> Thùng Rác Cơ Sở
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="pills-transfer-tab" data-bs-toggle="pill"
                data-bs-target="#pills-transfer" type="button" role="tab">
            <i class="fa-solid fa-clock-rotate-left me-1"></i> Lịch Sử Điều Chuyển Nhân Sự
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="pills-branch" role="tabpanel">
        <div class="d-flex gap-2 mb-3">
            <input type="search" class="form-control" id="searchBranch" maxlength="100"
                   placeholder="Tìm tên, mã, địa chỉ hoặc số điện thoại cơ sở..." />
            <button type="button" class="btn btn-outline-primary" id="btnSearchBranch">Tìm kiếm</button>
        </div>
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3">MÃ CƠ SỞ</th>
                                <th>TÊN CƠ SỞ / CHI NHÁNH</th>
                                <th>ĐỊA CHỈ TRỤ SỞ</th>
                                <th>HOTLINE LIÊN HỆ</th>
                                <th>QUY MÔ ĐÀO TẠO</th>
                                <th>TRẠNG THÁI</th>
                                <th class="text-end pe-3">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody id="branchTableBody">
                            <tr><td colspan="7" class="text-center text-muted py-4">Đang tải dữ liệu cơ sở...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 gap-2 flex-wrap">
            <small class="text-muted" id="branchPageInfo"></small>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPrevBranch" disabled>Trang trước</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnNextBranch" disabled>Trang sau</button>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="pills-trash" role="tabpanel">
        <p class="text-muted small mb-3">Cơ sở đã xóa mềm vẫn được lưu trong SQL Server. Chỉ có thể xóa mềm khi không còn nhân sự, phòng học hoặc lớp học chưa xóa mềm. Khôi phục xong, cơ sở ở trạng thái tạm ngưng.</p>
        <div class="d-flex gap-2 mb-3">
            <input type="search" class="form-control" id="searchTrashBranch" maxlength="100"
                   placeholder="Tìm cơ sở đã xóa theo tên, mã hoặc địa chỉ..." />
            <button type="button" class="btn btn-outline-primary" id="btnSearchTrashBranch">Tìm kiếm</button>
        </div>
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3">MÃ CƠ SỞ</th>
                                <th>TÊN CƠ SỞ</th>
                                <th>ĐỊA CHỈ</th>
                                <th>SỐ ĐIỆN THOẠI</th>
                                <th>NGÀY XÓA MỀM</th>
                                <th class="text-end pe-3">THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody id="trashBranchTableBody">
                            <tr><td colspan="6" class="text-center text-muted py-4">Chọn tab để tải thùng rác...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 gap-2 flex-wrap">
            <small class="text-muted" id="trashBranchPageInfo"></small>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPrevTrashBranch" disabled>Trang trước</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnNextTrashBranch" disabled>Trang sau</button>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="pills-transfer" role="tabpanel">
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3">MÃ ĐIỀU CHUYỂN</th>
                                <th>NHÂN SỰ / GIẢNG VIÊN</th>
                                <th>CƠ SỞ XUẤT PHÁT</th>
                                <th>CƠ SỞ ĐIỀU CHUYỂN ĐẾN</th>
                                <th>LÝ DO ĐIỀU ĐỘNG</th>
                                <th>NGƯỜI PHÊ DUYỆT</th>
                                <th>NGÀY HIỆU LỰC</th>
                                <th>TRẠNG THÁI</th>
                            </tr>
                        </thead>
                        <tbody id="transferTableBody">
                            <tr><td colspan="8" class="text-center text-muted py-4">Chọn tab để tải lịch sử...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 gap-2">
            <small class="text-muted" id="transferPageInfo"></small>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPrevTransfer" disabled>Trang trước</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnNextTransfer" disabled>Trang sau</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal thêm/sửa cơ sở: mã là giá trị HIỂN THỊ, tự sinh từ CoSoID. -->
<div class="modal fade" id="modalBranch" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalBranchTitle">Thêm Cơ Sở Đào Tạo Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <form id="formBranch">
                    <input type="hidden" id="hiddenBranchId" value="0" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="txtBranchCode">Mã Cơ Sở (tự động)</label>
                        <input type="text" class="form-control bg-light font-monospace" id="txtBranchCode" value="Tự sinh khi lưu" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="txtBranchName">Tên Cơ Sở / Chi Nhánh <span class="text-danger">*</span></label>
                        <input type="text" maxlength="100" class="form-control" id="txtBranchName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="txtBranchAddress">Địa Chỉ Chi Tiết <span class="text-danger">*</span></label>
                        <input type="text" maxlength="250" class="form-control" id="txtBranchAddress" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="txtBranchPhone">Hotline Liên Hệ</label>
                        <input type="tel" maxlength="20" class="form-control" id="txtBranchPhone" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveBranch">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Lưu Cơ Sở
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Điều chuyển phê duyệt ngay: NguoiDuyetID được xác định ở server. -->
<div class="modal fade" id="modalTransfer" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-arrows-split-up-and-left me-2 text-primary"></i>Phê Duyệt Điều Chuyển
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <form id="formTransfer">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="txtSearchTransferStaff">Tìm nhân sự / giáo viên</label>
                        <input type="text" class="form-control mb-2" id="txtSearchTransferStaff" placeholder="Nhập họ tên hoặc mã nhân sự..." />
                        <label class="form-label fw-semibold" for="selectTransferStaff">Chọn Nhân Sự / Giáo Viên <span class="text-danger">*</span></label>
                        <select class="form-select" id="selectTransferStaff" required>
                            <option value="">-- Chọn nhân sự điều chuyển --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="txtCurrentBranch">Cơ Sở Hiện Tại</label>
                        <input type="text" class="form-control bg-light" id="txtCurrentBranch" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="selectNewBranch">Điều Chuyển Sang Cơ Sở Mới <span class="text-danger">*</span></label>
                        <select class="form-select" id="selectNewBranch" required>
                            <option value="">-- Chọn cơ sở đến --</option>
                        </select>
                        <small class="text-muted">Cơ sở chuyển đến phải khác cơ sở hiện tại và đang hoạt động.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="txtTransferReason">Lý Do Điều Động Công Tác <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="txtTransferReason" rows="3" maxlength="300" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnExecuteTransfer">
                    <i class="fa-solid fa-check me-1"></i> Phê Duyệt Điều Chuyển
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(function() {
            const branchModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalBranch'));
            const transferModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalTransfer'));
            const urls = {
                branches: '@Url.Action("DanhSachCoSo", "CoSo")',
                options: '@Url.Action("DanhSachCoSoLuaChon", "CoSo")',
                save: '@Url.Action("LuuCoSo", "CoSo")',
                status: '@Url.Action("DoiTrangThaiCoSo", "CoSo")',
                trash: '@Url.Action("DanhSachCoSoDaXoa", "CoSo")',
                softDelete: '@Url.Action("XoaMemCoSo", "CoSo")',
                restore: '@Url.Action("KhoiPhucCoSo", "CoSo")',
                staff: '@Url.Action("DanhSachNhanSu", "CoSo")',
                transfer: '@Url.Action("DieuChuyenNhanSu", "CoSo")',
                history: '@Url.Action("DanhSachLichSu", "CoSo")',
                report: '@Url.Action("BaoCaoDuLieu", "CoSo")',
                reportBranches: '@Url.Action("BaoCaoCoSoLuaChon", "CoSo")'
            };
            let branches = [];
            let trashBranches = [];
            let trashPage = 1;
            let trashTotalPages = 0;
            let trashLoaded = false;
            let transferBranches = [];
            let branchPage = 1;
            let branchTotalPages = 0;
            let staff = [];
            let transferPage = 1;
            let transferTotalPages = 0;
            let historyLoaded = false;
            let reportRequestVersion = 0;
            let reportCharts = {};
            let appliedReportFilter = null;
            let latestReport = null;

            function esc(value) {
                return String(value ?? '').replace(/[&<>"']/g, ch => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
                })[ch]);
            }
            function errorMessage(xhr) {
                if (xhr.status === 401) return 'Phiên đăng nhập không hợp lệ. Hãy đăng nhập lại.';
                if (xhr.status === 403) return 'Bạn không có quyền thực hiện chức năng này.';
                if (xhr.status === 400 && !xhr.responseJSON?.message) return 'Yêu cầu bị từ chối. Hãy tải lại trang và thử lại.';
                return xhr.responseJSON?.message || 'Có lỗi xảy ra khi kết nối máy chủ.';
            }
            function fail(xhr) { Swal.fire('Không thành công', errorMessage(xhr), 'error'); }
            function postJson(url, payload) {
                return $.ajax({
                    url, type: 'POST', contentType: 'application/json',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    data: JSON.stringify(payload)
                });
            }
            function dateText(value) {
                if (!value) return '—';
                const d = new Date(value);
                return isNaN(d.getTime()) ? '—' : d.toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit', year: 'numeric' });
            }

            function currentReportFilter() {
                const type = $('#reportTimeType').val();
                const result = { kieuThoiGian: type, nam: Number($('#reportYear').val()), coSoId: $('#reportBranch').val() ? Number($('#reportBranch').val()) : null };
                if (type === 'month') result.thang = Number($('#reportMonth').val());
                if (type === 'quarter') result.quy = Number($('#reportQuarter').val());
                if (type === 'range') { result.tuNgay = $('#reportFrom').val(); result.denNgay = $('#reportTo').val(); }
                return result;
            }
            function showReportFields() {
                const type = $('#reportTimeType').val();
                $('.report-month-field, .report-quarter-field, .report-range-field').addClass('d-none');
                if (type === 'month') $('.report-month-field').removeClass('d-none');
                else if (type === 'quarter') $('.report-quarter-field').removeClass('d-none');
                else if (type === 'range') $('.report-range-field').removeClass('d-none');
                $('.report-year-field').toggleClass('d-none', type === 'range');
            }
            function destroyReportCharts() {
                Object.values(reportCharts).forEach(chart => chart?.destroy());
                reportCharts = {};
            }
            function hasValues(items) { return Array.isArray(items) && items.length > 0; }
            function makeChart(id, config, hasData) {
                const canvas = document.getElementById(id);
                if (!canvas) return;
                const empty = $(canvas).siblings('.report-empty');
                $(canvas).toggleClass('d-none', !hasData);
                empty.toggleClass('d-none', hasData);
                if (hasData && window.Chart) reportCharts[id] = new Chart(canvas, config);
            }
            function renderReport(report) {
                latestReport = report;
                destroyReportCharts();
                $('#reportPeriod').text(report.kyBaoCao.nhanKy);
                $('#reportUpdatedAt').text(dateText(report.capNhatLuc));
                $('#reportRevenue').text(Number(report.tongDoanhThu || 0).toLocaleString('vi-VN') + ' VNĐ');
