@model QuanLyTrungTamNgoaiNgu.Models.CamKet

@{
    ViewData["Title"] = "Chi Tiết Cam Kết";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-4">
    <a href="/CamKet/Index" class="btn btn-outline-secondary btn-sm">
        <i class="fa-solid fa-chevron-left me-1"></i>Quay lại
    </a>
</div>

<div class="row">
    <!-- Thông tin học viên -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fa-solid fa-user me-2"></i>Thông Tin Học Viên</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <small class="text-muted d-block">Mã Học Viên</small>
                        <span class="badge bg-light text-dark border">HV-@Model.HocVienID.ToString("D3")</span>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block">Trạng Thái</small>
                        @if (Model.TrangThai == "Chờ duyệt")
                        {
                            <span class="badge bg-warning text-dark">@Model.TrangThai</span>
                        }
                        else if (Model.TrangThai == "Đã duyệt")
                        {
                            <span class="badge bg-success text-white">@Model.TrangThai</span>
                        }
                        else if (Model.TrangThai == "Từ chối")
                        {
                            <span class="badge bg-danger text-white">@Model.TrangThai</span>
                        }
                    </div>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Họ Và Tên</small>
                    <strong>@Model.HocVien?.HoTen</strong>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Email</small>
                    <span>@Model.HocVien?.Email</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Điện Thoại</small>
                    <span>@Model.HocVien?.SoDienThoai</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Trình Độ Đầu Vào</small>
                    <span>@(Model.HocVien?.TrinhDoDauVao ?? "Chưa xác định")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Thông tin khóa học -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fa-solid fa-book me-2"></i>Thông Tin Khóa Học</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">Tên Khóa Học</small>
                    <strong>@Model.KhoaHoc?.TenKhoaHoc</strong>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Lớp Học</small>
                    <span>@Model.DangKy?.LopHoc?.TenLop</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Giáo Viên Phụ Trách</small>
                    <span>@Model.DangKy?.LopHoc?.GiaoVienPhuTrach?.HoTen</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Ngày Đăng Ký</small>
                    <span>@Model.DangKy?.NgayDangKy.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Học Phí</small>
                    <strong>@(Model.DangKy?.HocPhiApDung.ToString("N0") ?? "0") VND</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Thông tin điểm và kết quả -->
<div class="row">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fa-solid fa-chart-column me-2"></i>Điểm Số</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">Điểm Đầu Vào</small>
                    <span>@(Model.DiemDauVao?.ToString("F1") ?? "Chưa có")</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Điểm Yêu Cầu Cuối Khóa</small>
                    <span>@(Model.DiemYeuCauCuoiKhoa?.ToString("F1") ?? "Chưa xác định")</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Điểm Cuối Khóa</small>
                    <strong class="text-primary fs-5">
                        @(Model.DiemCuoiKhoa?.ToString("F1") ?? "Chưa có")
                    </strong>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Kết Quả</small>
                    @{
                        var ketQua = Model.DangKy?.KetQua;
                        if (ketQua == "Đỗ")
                        {
                            <span class="badge bg-success text-white">@ketQua</span>
                        }
                        else if (ketQua == "Rớt")
                        {
                            <span class="badge bg-danger text-white">@ketQua</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@(ketQua ?? "Chưa xác định")</span>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Thông tin duyệt -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="fa-solid fa-clipboard-check me-2"></i>Thông Tin Duyệt</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">Ngày Lập Cam Kết</small>
                    <span>@Model.NgayLap.ToString("dd/MM/yyyy HH:mm:ss")</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Giáo Viên Đề Xuất</small>
                    <span>@(Model.GiaoVienDeXuat?.HoTen ?? "Chưa có")</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Người Duyệt</small>
                    <span>@(Model.NguoiDuyet?.TenDangNhap ?? "Chưa duyệt") "Chưa duyệt")</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Ngày Duyệt</small>
                    <span>@(Model.NgayDuyet?.ToString("dd/MM/yyyy HH:mm:ss") ?? "Chưa duyệt")</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Ghi Chú</small>
                    <span>@(string.IsNullOrEmpty(Model.GhiChu) ? "Không có" : Model.GhiChu)</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Nút hành động -->
<div class="text-end mb-4">
    @{
        var userRole = Context.Session.GetString("UserRole");
        if ((userRole == "Admin" || userRole == "Quản lý") && Model.TrangThai == "Chờ duyệt")
        {
            <button class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#mdlDuyet">
                <i class="fa-solid fa-check me-1"></i>Duyệt
            </button>
            <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#mdlTuChoi">
                <i class="fa-solid fa-xmark me-1"></i>Từ chối
            </button>
        }
        if (userRole == "Giáo viên" && Model.TrangThai == "Chờ duyệt" && Model.DiemCuoiKhoa == null)
        {
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#mdlDeXuat">
                <i class="fa-solid fa-pencil me-1"></i>Đề xuất điểm
            </button>
        }
    }
</div>

<!-- Modal Duyệt -->
<div class="modal fade" id="mdlDuyet" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Duyệt Cam Kết</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/CamKet/Duyet">
                @Html.AntiForgeryToken()
                <input type="hidden" name="camKetId" value="@Model.CamKetID" />
                <input type="hidden" name="approved" value="true" />
                <div class="modal-body">
                    <p class="mb-0"><strong>Học viên:</strong> @Model.HocVien?.HoTen</p>
                    <p class="mt-2"><strong>Điểm cuối khóa:</strong> @(Model.DiemCuoiKhoa?.ToString("F1") ?? "Chưa có")</p>
                    <div class="alert alert-success mt-3">
                        <i class="fa-solid fa-check-circle me-2"></i>
                        <strong>Xác nhận duyệt:</strong> Cam kết sẽ được cập nhật trạng thái thành "Đã duyệt" và kết quả sẽ được lưu.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-check me-1"></i>Duyệt
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Từ chối -->
<div class="modal fade" id="mdlTuChoi" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Từ chối Cam Kết</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/CamKet/Duyet">
                @Html.AntiForgeryToken()
                <input type="hidden" name="camKetId" value="@Model.CamKetID" />
                <input type="hidden" name="approved" value="false" />
                <div class="modal-body">
                    <p class="mb-0"><strong>Học viên:</strong> @Model.HocVien?.HoTen</p>
                    <div class="mt-3">
                        <label class="form-label">Lý do từ chối (tùy chọn)</label>
                        <textarea class="form-control" name="ghiChuTuChoi" rows="3" placeholder="Nhập lý do..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fa-solid fa-xmark me-1"></i>Từ chối
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Đề xuất -->
<div class="modal fade" id="mdlDeXuat" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Đề xuất Điểm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/CamKet/DeXuatDiem">
                @Html.AntiForgeryToken()
                <input type="hidden" name="camKetId" value="@Model.CamKetID" />
                <div class="modal-body">
                    <p class="mb-3"><strong>Học viên:</strong> @Model.HocVien?.HoTen</p>
                    <div>
                        <label class="form-label">Điểm Cuối Khóa (0-100)</label>
                        <input type="number" class="form-control" name="diemCuoiKhoa" min="0" max="100" step="0.5" placeholder="Nhập điểm..." required />
                    </div>
                    <div class="mt-3">
                        <label class="form-label">Ghi chú (tùy chọn)</label>
                        <textarea class="form-control" name="ghiChu" rows="2" placeholder="Ghi chú..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-paper-plane me-1"></i>Đề xuất
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
