@model IEnumerable<QuanLyTrungTamNgoaiNgu.Models.ChiTietNopBai>

@{
    ViewData["Title"] = "Cổng Nộp Bài Tập";

    var hocVien = ViewBag.HocVienCurrent as QuanLyTrungTamNgoaiNgu.Models.HocVien;
    var baiTap = ViewBag.BaiTapCurrent as QuanLyTrungTamNgoaiNgu.Models.BaiTap;

    int baiTapId = baiTap?.BaiTapID ?? 1;
    int hocVienId = hocVien?.HocVienID ?? 1;

    string tenLop = baiTap?.LopHoc?.TenLop ?? "TOEIC500-K01";
    string tenHocVien = hocVien?.HoTen ?? "Lê Văn Học Viên";
    string maHocVien = "HV-00" + hocVienId;

    string hanNopStr = (baiTap != null && baiTap.HanNop.HasValue)
        ? baiTap.HanNop.Value.ToString("HH:mm - dd/MM/yyyy")
        : "23:59 - 08/10/2026";

    string ngayGiaoStr = baiTap != null
        ? baiTap.NgayGiao.ToString("dd/MM/yyyy")
        : "05/10/2026";

    string tenBaiTap = baiTap?.TieuDe ?? "Bài tập Reading Part 5 - Buổi 1";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 text-dark fw-bold">Chi Tiết & Nộp Bài Tập</h4>
        <p class="text-muted small mb-0">Lớp: <strong>@tenLop</strong> | Học viên: <strong>@tenHocVien (@maHocVien)</strong></p>
    </div>
    <span class="badge bg-warning text-dark px-3 py-2 fs-6">
        <i class="fa-regular fa-clock me-1"></i> Hạn chót: @hanNopStr
    </span>
</div>

<div class="row g-4">
    <!-- Cột trái: Đề bài và Lịch sử nộp -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold text-primary">
                    <i class="fa-solid fa-file-lines me-2"></i>Đề bài: @tenBaiTap
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-3 text-muted small">
                    <span><i class="fa-solid fa-user-tie me-1"></i> Giảng viên bộ môn</span> •
                    <span class="ms-2"><i class="fa-solid fa-calendar me-1"></i> Ngày giao: @ngayGiaoStr</span>
                </div>
                <div class="border-top pt-3">
                    <p class="fw-semibold">Yêu cầu từ giảng viên:</p>
                    <div class="p-3 bg-light rounded text-secondary mb-3">
                        <p class="mb-2">1. Hoàn thành bài tập trắc nghiệm ngữ pháp và từ vựng trong file đính kèm.</p>
                        <p class="mb-2">2. Giải thích ngắn gọn lý do chọn đáp án đối với các câu nâng cao.</p>
                        <p class="mb-0">3. Xuất file làm bài dưới định dạng <strong>.PDF</strong>, <strong>.DOCX</strong>, <strong>.ZIP</strong> hoặc <strong>.RAR</strong>.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lịch sử nộp bài -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-clock-rotate-left me-2"></i>Lịch Sử Nộp & Chấm Điểm</h6>
                <span class="badge bg-light text-dark border">Tổng số lần nộp: @(Model?.Count() ?? 0)</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3">Lần nộp</th>
                                <th>Thời gian</th>
                                <th>Tệp đã nộp</th>
                                <th>Điểm số</th>
                                <th>Nhận xét của GV</th>
                            </tr>
                        </thead>
                        <tbody id="historyBody">
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    string filename = !string.IsNullOrEmpty(item.DuongDan) ? System.IO.Path.GetFileName(item.DuongDan) : "Tệp bài làm";
                                    <tr id="row_nop_@item.ChiTietNopBaiID">
                                        <td class="ps-3 fw-bold text-primary">Lần @item.LanNop</td>
                                        <td><small class="text-muted">@item.ThoiGianNop.ToString("dd/MM/yyyy HH:mm")</small></td>
                                        <td>
                                            <a href="@item.DuongDan" target="_blank" class="text-decoration-none fw-semibold">
                                                <i class="fa-solid fa-file-pdf text-danger me-1"></i> @filename
                                            </a>
                                        </td>
                                        <td>
                                            @if (item.Diem.HasValue)
                                            {
                                                <span class="badge bg-success fs-6">@item.Diem.Value / 100</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary fs-6">Chờ chấm</span>
                                            }
                                        </td>
                                        <td><small class="text-secondary">@(string.IsNullOrEmpty(item.NhanXet) ? "Chưa có nhận xét" : item.NhanXet)</small></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr id="rowEmpty">
                                    <td colspan="5" class="text-center py-4 text-muted">Bạn chưa từng nộp bài tập này. Vui lòng chọn tệp ở khung bên phải để nộp.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Khung kéo thả Upload file -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-cloud-arrow-up me-2"></i>Nộp Bài Làm Mới</h5>
            </div>
            <div class="card-body">
                <form id="formUpload" enctype="multipart/form-data">
                    <input type="hidden" id="baiTapId" value="@baiTapId" />
                    <input type="hidden" id="hocVienId" value="@hocVienId" />

                    <!-- Khung Dropzone -->
                    <div class="border border-2 border-dashed rounded-3 p-4 text-center bg-light" id="dropArea" style="cursor: pointer;">
                        <i class="fa-solid fa-file-arrow-up fs-1 text-primary mb-3"></i>
                        <h6 class="fw-bold mb-1">Kéo và thả tệp tin vào đây</h6>
                        <p class="text-muted small mb-3">hoặc nhấp để chọn tệp từ máy tính</p>

                        <input type="file" id="inputFile" name="fileNop" class="d-none" accept=".pdf,.doc,.docx,.zip,.rar" />
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="$('#inputFile').click(); event.stopPropagation();">
                            <i class="fa-solid fa-folder-open me-1"></i> Duyệt tệp
                        </button>
                    </div>

                    <!-- Thông tin file đã chọn -->
                    <div id="fileInfoBox" class="mt-3 p-3 border rounded bg-white d-none">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center overflow-hidden">
                                <i class="fa-solid fa-file text-primary fs-3 me-3" id="fileIcon"></i>
                                <div>
                                    <div class="fw-semibold text-truncate" id="fileNameDisplay" style="max-width: 220px;">ten_file.pdf</div>
                                    <small class="text-muted" id="fileSizeDisplay">0 KB</small>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-link text-danger" id="btnRemoveFile">
                                <i class="fa-solid fa-xmark fs-5"></i>
                            </button>
                        </div>

                        <!-- Progress Bar -->
                        <div class="progress mt-2 d-none" id="uploadProgress" style="height: 6px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%"></div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <div class="small text-muted mb-2">
                            <i class="fa-solid fa-circle-info text-info me-1"></i> <strong>Quy định tệp tin:</strong>
                            <ul class="ps-3 mb-0 mt-1">
                                <li>Định dạng: <code>PDF, Word (.docx, .doc), Zip/Rar</code></li>
                                <li>Dung lượng tối đa: <strong>15 MB</strong></li>
                            </ul>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold" id="btnSubmitFile" disabled>
                            <i class="fa-solid fa-paper-plane me-1"></i> Xác Nhận Nộp Bài
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const dropArea = $('#dropArea');
            const inputFile = $('#inputFile');
            const fileInfoBox = $('#fileInfoBox');
            const fileNameDisplay = $('#fileNameDisplay');
            const fileSizeDisplay = $('#fileSizeDisplay');
            const btnSubmit = $('#btnSubmitFile');
            const btnRemove = $('#btnRemoveFile');

            // Click vào khung Dropzone để chọn file
            dropArea.on('click', function(e) {
                inputFile.trigger('click');
            });

            inputFile.on('click', function(e) {
                e.stopPropagation();
            });

            // Kéo thả file
            dropArea.on('dragover', function(e) {
                e.preventDefault();
                $(this).addClass('border-primary bg-white');
            });

            dropArea.on('dragleave', function(e) {
                e.preventDefault();
                $(this).removeClass('border-primary bg-white');
            });

            dropArea.on('drop', function(e) {
                e.preventDefault();
                $(this).removeClass('border-primary bg-white');
                const files = e.originalEvent.dataTransfer.files;
                if (files.length > 0) {
                    inputFile[0].files = files;
                    validateAndDisplayFile(files[0]);
                }
            });

            inputFile.on('change', function() {
                if (this.files.length > 0) {
                    validateAndDisplayFile(this.files[0]);
                }
            });

            function validateAndDisplayFile(file) {
                const allowedExts = ['pdf', 'doc', 'docx', 'zip', 'rar'];
                const ext = file.name.split('.').pop().toLowerCase();
                const maxSize = 15 * 1024 * 1024;

                if (!allowedExts.includes(ext)) {
                    Swal.fire('Lỗi định dạng', 'Chỉ chấp nhận tệp định dạng: PDF, Word (.docx, .doc), Zip, Rar', 'error');
                    resetFileInput();
                    return;
                }

                if (file.size > maxSize) {
                    Swal.fire('Tệp quá lớn', 'Kích thước tệp không được vượt quá 15 MB!', 'warning');
                    resetFileInput();
                    return;
                }

                fileNameDisplay.text(file.name);
                fileSizeDisplay.text((file.size / (1024 * 1024)).toFixed(2) + ' MB');
                fileInfoBox.removeClass('d-none');
                btnSubmit.prop('disabled', false);
            }

            btnRemove.click(function(e) {
                e.stopPropagation();
                resetFileInput();
            });

            function resetFileInput() {
                inputFile.val('');
                fileInfoBox.addClass('d-none');
                btnSubmit.prop('disabled', true);
                $('#uploadProgress').addClass('d-none');
                $('.progress-bar').css('width', '0%');
            }

            // Upload Ajax
            $('#formUpload').submit(function(e) {
                e.preventDefault();

                const file = inputFile[0].files[0];
                if (!file) return;

                const formData = new FormData();
                formData.append('fileNop', file);
                formData.append('baiTapId', $('#baiTapId').val());
                formData.append('hocVienId', $('#hocVienId').val());

                $('#uploadProgress').removeClass('d-none');
                btnSubmit.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang tải lên...');

                $.ajax({
                    url: '/BaiTap/UploadBaiTap',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    xhr: function() {
                        const xhr = new window.XMLHttpRequest();
                        xhr.upload.addEventListener("progress", function(evt) {
                            if (evt.lengthComputable) {
                                const percentComplete = Math.round((evt.loaded / evt.total) * 100);
                                $('.progress-bar').css('width', percentComplete + '%');
                            }
                        }, false);
                        return xhr;
                    },
                    success: function(res) {
                        btnSubmit.prop('disabled', false).html('<i class="fa-solid fa-paper-plane me-1"></i> Xác Nhận Nộp Bài');
                        if (res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công!',
                                text: res.message,
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Lỗi nộp bài', res.message, 'error');
                        }
                    },
                    error: function() {
                        btnSubmit.prop('disabled', false).html('<i class="fa-solid fa-paper-plane me-1"></i> Xác Nhận Nộp Bài');
                        Swal.fire('Lỗi kết nối', 'Không thể tải file lên server. Vui lòng kiểm tra lại!', 'error');
                    }
                });
            });
        });
    </script>
}