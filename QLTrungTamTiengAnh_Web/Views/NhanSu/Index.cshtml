@{
    ViewData["Title"] = "Quản lý Nhân sự & Giảng viên";
    var coSos = ViewBag.CoSos as IEnumerable<QLTrungTamTiengAnh_Web.Controllers.CoSoOptionDto>
        ?? Enumerable.Empty<QLTrungTamTiengAnh_Web.Controllers.CoSoOptionDto>();
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 text-dark fw-bold">Hồ Sơ Nhân Sự & Giảng Viên</h4>
        <p class="text-muted small mb-0">Quản lý đội ngũ giảng dạy, phân loại chuyên môn và quản lý hợp đồng công tác</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" id="btnOpenStaffTrash" title="Xem hồ sơ đã xóa mềm">
            <i class="fa-solid fa-trash-can me-1"></i> Thùng rác
        </button>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalStaff" onclick="openCreateStaffModal()">
            <i class="fa-solid fa-user-plus me-1"></i> Thêm Nhân Sự Mới
        </button>
    </div>
</div>

<!-- 4 Thẻ thống kê nhân sự -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-muted small fw-semibold">TỔNG NHÂN SỰ</span>
            <h4 class="fw-bold mb-0 text-dark" id="statTotalStaff">0</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-primary small fw-semibold">GIẢNG VIÊN ĐỨNG LỚP</span>
            <h4 class="fw-bold mb-0 text-primary" id="statTeachingStaff">0</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-success small fw-semibold">ĐANG CÔNG TÁC</span>
            <h4 class="fw-bold mb-0 text-success" id="statActiveStaff">0</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 bg-white shadow-sm p-3">
            <span class="text-warning small fw-semibold">TẠM NGHỈ / THỬ VIỆC</span>
            <h4 class="fw-bold mb-0 text-warning" id="statInactiveStaff">0</h4>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm nhân sự -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-5">
                <input type="text" class="form-control" id="searchStaffKw" placeholder="Tìm theo tên, email, số điện thoại..." />
            </div>
            <div class="col-md-3">
                <select class="form-select" id="filterRole">
                    <option value="">-- Tất cả vai trò --</option>
                    <option value="Giảng viên">Giảng viên</option>
                    <option value="Giáo vụ">Giáo vụ</option>
                    <option value="Tư vấn tuyển sinh">Tư vấn tuyển sinh</option>
                    <option value="Kế toán">Kế toán</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="filterStaffStatus">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Đang làm">Đang làm việc</option>
                    <option value="Tạm nghỉ">Tạm nghỉ</option>
                    <option value="Thử việc">Thử việc</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="button" class="btn btn-secondary w-100" id="btnFilterStaff">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <button type="button" class="btn btn-outline-secondary" id="btnResetStaffFilter">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bảng danh sách nhân sự -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3">MÃ NV</th>
                        <th>HỌ VÀ TÊN</th>
                        <th>VAI TRÒ / CHỨC VỤ</th>
                        <th>CHUYÊN MÔN CHÍNH</th>
                        <th>LIÊN HỆ</th>
                        <th>LƯƠNG CƠ BẢN</th>
                        <th>TRẠNG THÁI</th>
                        <th class="text-end pe-3">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody id="staffTableBody">
                    <tr><td colspan="8" class="text-center text-muted py-4">Đang tải dữ liệu...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="d-flex justify-content-between align-items-center mt-3">
    <small class="text-muted" id="staffPageInfo">Trang 1</small>
    <div class="btn-group btn-group-sm">
        <button type="button" class="btn btn-outline-secondary" id="btnPrevStaff" title="Trang trước">Trước</button>
        <button type="button" class="btn btn-outline-secondary" id="btnNextStaff" title="Trang sau">Sau</button>
    </div>
</div>

<!-- Modal: Thùng rác nhân sự -->
<div class="modal fade" id="modalStaffTrash" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Hồ sơ nhân sự đã xóa mềm</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <div class="modal-body"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Mã</th><th>Họ tên</th><th>Ngày xóa</th><th></th></tr></thead><tbody id="staffTrashBody"></tbody></table></div></div>
        </div>
    </div>
</div>

<!-- Modal: Thêm / Sửa Nhân sự -->
<div class="modal fade" id="modalStaff" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalStaffTitle">
                    <i class="fa-solid fa-user-plus me-2 text-primary"></i>Thêm Hồ Sơ Nhân Sự
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formStaff">
                    <input type="hidden" id="hiddenStaffId" value="0" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Họ và Tên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtStaffName" placeholder="VD: Hoàng Văn Minh" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Vai Trò / Vị Trí <span class="text-danger">*</span></label>
                            <select class="form-select" id="selectStaffRole">
                                <option value="Giảng viên">Giảng viên đứng lớp</option>
                                <option value="Tư vấn tuyển sinh">Tư vấn tuyển sinh</option>
                                <option value="Giáo vụ">Giáo vụ học vụ</option>
                                <option value="Kế toán">Kế toán trung tâm</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số Điện Thoại <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" id="txtStaffPhone" placeholder="VD: 0988776655" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email Liên Hệ <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="txtStaffEmail" placeholder="VD: minh@example.com" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Cơ sở làm việc <span class="text-danger">*</span></label>
                            <select class="form-select" id="selectStaffBranch" required>
                                <option value="">-- Chọn cơ sở --</option>
                                @foreach (var coSo in coSos)
                                {
                                    <option value="@coSo.Id">@coSo.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Chuyên Môn / Bằng Cấp Chính</label>
                            <input type="text" class="form-control" id="txtStaffSkill" placeholder="VD: IELTS 8.0, TESOL, Giao tiếp..." />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Lương Cơ Bản (VNĐ)</label>
                            <input type="number" class="form-control" id="txtStaffSalary" min="0" value="0" step="500000" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Trạng Thái</label>
                            <select class="form-select" id="selectStaffStatus">
                                <option value="Đang làm">Đang làm việc</option>
                                <option value="Tạm nghỉ">Tạm nghỉ</option>
                                <option value="Thử việc">Thử việc</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveStaff">
                    <i class="fa-solid fa-save me-1"></i> Lưu Hồ Sơ
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let currentEditRow = null;
            let currentPage = 1;
            let totalPages = 0;
            const urls = {
                list: '@Url.Action("DanhSach", "NhanSu")',
                save: '@Url.Action("LuuNhanSu", "NhanSu")',
                remove: '@Url.Action("XoaMem", "NhanSu")',
                trash: '@Url.Action("ThungRac", "NhanSu")',
                restore: '@Url.Action("KhoiPhuc", "NhanSu")'
            };

            function esc(value) {
                return String(value ?? '').replace(/[&<>"']/g, ch => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
                })[ch]);
            }

            function renderStaff(items) {
                const tbody = $('#staffTableBody').empty();
                if (!items.length) {
                    tbody.append('<tr><td colspan="8" class="text-center text-muted py-4">Không có hồ sơ phù hợp.</td></tr>');
                    return;
                }
                items.forEach(x => {
                    const active = x.trangThai === 'Đang làm';
                    const badge = active ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning';
                    tbody.append(`<tr data-id="${x.id}">
                        <td class="ps-3"><span class="badge bg-light text-dark border fw-bold">${esc(x.maNhanSu)}</span></td>
                        <td><div class="fw-bold text-dark">${esc(x.hoTen)}</div><small class="text-muted">${esc(x.coSo)}</small></td>
                        <td><span class="badge bg-primary-subtle text-primary border">${esc(x.vaiTro)}</span></td>
                        <td><span class="fw-semibold">${esc(x.chuyenMon || 'Chưa cập nhật')}</span><div class="small text-muted">Đang phụ trách: ${x.soLop} lớp</div></td>
                        <td>${esc(x.soDienThoai || '—')}<small class="d-block text-muted">${esc(x.email || '—')}</small></td>
                        <td class="fw-semibold">${x.luongCoBan == null ? '—' : Number(x.luongCoBan).toLocaleString('vi-VN') + ' đ'}</td>
                        <td><span class="badge ${badge} border status-badge">${esc(x.trangThai)}</span></td>
                        <td class="text-end pe-3 text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-primary btn-edit-staff" title="Sửa hồ sơ"
                                data-id="${x.id}" data-name="${esc(x.hoTen)}" data-role="${esc(x.vaiTro)}" data-skill="${esc(x.chuyenMon)}"
                                data-phone="${esc(x.soDienThoai)}" data-email="${esc(x.email)}" data-salary="${x.luongCoBan ?? 0}"
                                data-status="${esc(x.trangThai)}" data-branch-id="${x.coSoId}"><i class="fa-solid fa-user-pen"></i></button>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete-staff" title="Xóa mềm"><i class="fa-solid fa-trash"></i></button>
                        </td>
                    </tr>`);
                });
            }

            function loadStaff(page = 1) {
                currentPage = page;
                $('#staffTableBody').html('<tr><td colspan="8" class="text-center text-muted py-4">Đang tải dữ liệu...</td></tr>');
                $.getJSON(urls.list, {
                    keyword: $('#searchStaffKw').val().trim(),
                    vaiTro: $('#filterRole').val(),
                    trangThai: $('#filterStaffStatus').val(),
                    page: currentPage,
                    pageSize: 10
                }).done(res => {
                    if (!res.success) {
                        $('#staffTableBody').html('<tr><td colspan="8" class="text-center text-danger py-4">Không tải được dữ liệu.</td></tr>');
                        return Swal.fire('Lỗi', res.message || 'Không tải được danh sách nhân sự.', 'error');
                    }
                    currentPage = res.page;
                    totalPages = res.totalPages;
                    renderStaff(res.items || []);
                    $('#staffPageInfo').text(`Tổng ${res.total} hồ sơ • Trang ${currentPage}/${totalPages || 1}`);
                    $('#btnPrevStaff').prop('disabled', currentPage <= 1);
                    $('#btnNextStaff').prop('disabled', currentPage >= totalPages);
                    $('#statTotalStaff').text(res.stats.total);
                    $('#statTeachingStaff').text(res.stats.teaching);
                    $('#statActiveStaff').text(res.stats.active);
                    $('#statInactiveStaff').text(res.stats.inactive);
                }).fail(xhr => {
                    $('#staffTableBody').html('<tr><td colspan="8" class="text-center text-danger py-4">Không thể kết nối máy chủ.</td></tr>');
                    Swal.fire('Lỗi kết nối', xhr.responseJSON?.message || 'Không thể tải danh sách nhân sự.', 'error');
                });
            }

            // 1. Mở modal thêm mới
            window.openCreateStaffModal = function () {
                currentEditRow = null;
                $('#hiddenStaffId').val(0);
                $('#formStaff')[0].reset();
                $('#txtStaffSalary').val(0);
                $('#selectStaffStatus').val('Đang làm');
                $('#selectStaffBranch').val('');
                $('#modalStaffTitle').html('<i class="fa-solid fa-user-plus me-2 text-primary"></i>Thêm Hồ Sơ Nhân Sự');
            };

            // 2. Mở modal chỉnh sửa
            window.openEditStaffModal = function (id, name, role, skill, phone, email, salary, status, btnElement) {
                currentEditRow = $(btnElement).closest("tr");
                $('#hiddenStaffId').val(id);
                $('#txtStaffName').val(name);
                $('#selectStaffRole').val(role);
                $('#txtStaffSkill').val(skill);
                $('#txtStaffPhone').val(phone);
                $('#txtStaffEmail').val(email);
                $('#txtStaffSalary').val(salary);
                $('#selectStaffStatus').val(status);
                $('#selectStaffBranch').val($(btnElement).data('branch-id') || '');

                $('#modalStaffTitle').html('<i class="fa-solid fa-user-pen me-2 text-primary"></i>Chỉnh Sửa Nhân Sự: ' + name);
                $('#modalStaff').modal('show');
            };

            // 3. Xử lý Thêm mới / Cập nhật bằng AJAX
            $('#btnSaveStaff').click(function () {
                const name = $('#txtStaffName').val().trim();
                const role = $('#selectStaffRole').val();
                const skill = $('#txtStaffSkill').val().trim();
                const phone = $('#txtStaffPhone').val().trim();
                const email = $('#txtStaffEmail').val().trim();
                const salary = parseFloat($('#txtStaffSalary').val()) || 0;
                const status = $('#selectStaffStatus').val();
                const branchId = parseInt($('#selectStaffBranch').val()) || 0;
                const staffId = parseInt($('#hiddenStaffId').val()) || 0;

                if (!name) {
                    Swal.fire('Lỗi nhập liệu', 'Vui lòng nhập họ tên nhân sự!', 'warning');
                    return;
                }
                if (!phone || phone.length < 10) {
                    Swal.fire('Lỗi số điện thoại', 'Số điện thoại phải từ 10 số trở lên!', 'warning');
                    return;
                }
                if (!branchId) {
                    Swal.fire('Thiếu cơ sở', 'Vui lòng chọn cơ sở làm việc.', 'warning');
                    return;
                }
                if (salary < 0) {
                    Swal.fire('Lỗi lương', 'Lương cơ bản không được âm.', 'warning');
                    return;
                }

                const payload = {
                    nhanVienId: staffId,
                    coSoId: branchId,
                    hoTen: name,
                    vaiTro: role,
                    chuyenMon: skill,
                    soDienThoai: phone,
                    email: email,
                    luongCoBan: salary,
                    trangThai: status
                };

                $.ajax({
                    url: '/NhanSu/LuuNhanSu',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            $('#modalStaff').modal('hide');
                            Swal.fire('Thành công!', res.message, 'success');
                            loadStaff();
                            return;

                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi kết nối', 'Không thể kết nối đến máy chủ để lưu hồ sơ!', 'error');
                    }
                });
            });

            $('#btnOpenStaffTrash').click(function () {
                const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalStaffTrash'));
                $('#staffTrashBody').html('<tr><td colspan="4" class="text-center text-muted">Đang tải...</td></tr>');
                $.getJSON(urls.trash).done(res => {
                    if (!res.success) return Swal.fire('Lỗi', res.message || 'Không tải được thùng rác.', 'error');
                    const body = $('#staffTrashBody').empty();
                    if (!res.items.length) body.append('<tr><td colspan="4" class="text-center text-muted">Thùng rác trống.</td></tr>');
                    res.items.forEach(x => body.append(`<tr><td>${esc(x.maNhanSu)}</td><td>${esc(x.hoTen)}</td><td>${x.deletedAt ? new Date(x.deletedAt).toLocaleString('vi-VN') : '—'}</td><td class="text-end"><button type="button" class="btn btn-sm btn-outline-success btn-restore-staff" data-id="${x.id}">Khôi phục</button></td></tr>`));
                    modal.show();
                }).fail(() => Swal.fire('Lỗi kết nối', 'Không thể tải thùng rác nhân sự.', 'error'));
            });

            $('#staffTrashBody').on('click', '.btn-restore-staff', function () {
                const id = $(this).data('id');
                $.ajax({ url: urls.restore + '?id=' + encodeURIComponent(id), type: 'POST', headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() } })
                    .done(res => { if (!res.success) return Swal.fire('Lỗi', res.message, 'error'); $('#btnOpenStaffTrash').trigger('click'); loadStaff(1); })
                    .fail(xhr => Swal.fire('Không thành công', xhr.responseJSON?.message || 'Không thể khôi phục hồ sơ.', 'error'));
            });

            $('#staffTableBody').on('click', '.btn-edit-staff', function () {
                const button = $(this);
                openEditStaffModal(button.data('id'), button.data('name'), button.data('role'), button.data('skill'),
                    button.data('phone'), button.data('email'), button.data('salary'), button.data('status'), this);
            });

            // 4. Xóa nhân sự
            window.confirmDeleteStaff = function (btnElement, staffId) {
                Swal.fire({
                    title: 'Xóa mềm hồ sơ nhân sự?',
                    text: 'Hệ thống sẽ kiểm tra các phân công và lớp học tương lai trước khi xóa.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy'
                }).then((r) => {
                    if (!r.isConfirmed) return;
                    $.ajax({
                        url: urls.remove + '?id=' + encodeURIComponent(staffId),
                        type: 'POST',
                        headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() }
                    }).done(res => {
                        if (!res.success) return Swal.fire('Lỗi', res.message, 'error');
                        loadStaff();
                        Swal.fire('Đã xóa mềm', res.message, 'success');
                    }).fail(xhr => Swal.fire('Không thành công', xhr.responseJSON?.message || 'Không thể xóa hồ sơ.', 'error'));
                });
            };

            $('#staffTableBody').on('click', '.btn-delete-staff', function () {
                confirmDeleteStaff(this, Number($(this).closest('tr').data('id')));
            });

            // 5. Lọc server-side, luôn quay về trang đầu sau khi đổi bộ lọc
            $('#btnFilterStaff').click(() => loadStaff(1));
            $('#btnPrevStaff').click(() => { if (currentPage > 1) loadStaff(currentPage - 1); });
            $('#btnNextStaff').click(() => { if (currentPage < totalPages) loadStaff(currentPage + 1); });
            $('#searchStaffKw').on('keydown', function (event) {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    loadStaff(1);
                }
            });
            $('#btnResetStaffFilter').click(function () {
                $('#searchStaffKw').val('');
                $('#filterRole').val('');
                $('#filterStaffStatus').val('');
                loadStaff(1);
            });
            loadStaff(1);
        });
    </script>
}